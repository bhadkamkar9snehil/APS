<section class="mt-4 rounded-control border border-border bg-surface-raised p-3">
    <h2 class="text-xs font-semibold">Planning controls</h2>
    <div class="mt-3 grid grid-cols-2 gap-2">
        <label class="text-[10px] text-muted">Heat size MT<input type="number" step="1" value="@NominalHeatMt" @onchange="HeatChanged" class="mt-1 w-full rounded-control border border-border px-2 py-1.5 text-xs" /></label>
        <label class="text-[10px] text-muted">Campaign max MT<input type="number" step="10" value="@MaximumCampaignMt" @onchange="CampaignChanged" class="mt-1 w-full rounded-control border border-border px-2 py-1.5 text-xs" /></label>
        <label class="text-[10px] text-muted">Frozen minutes<input type="number" step="15" value="@FrozenMinutes" @onchange="FrozenChanged" class="mt-1 w-full rounded-control border border-border px-2 py-1.5 text-xs" /></label>
        <label class="text-[10px] text-muted">Solver seconds<input type="number" step="5" value="@SolverSeconds" @onchange="SolverChanged" class="mt-1 w-full rounded-control border border-border px-2 py-1.5 text-xs" /></label>
    </div>
    <button type="button" class="mt-3 w-full rounded-control border border-border-strong px-3 py-2 text-xs font-medium hover:bg-surface-hover" @onclick="OnRecalculate" disabled="@Disabled">Recalculate with controls</button>
</section>

@code {
    [Parameter] public decimal NominalHeatMt { get; set; }
    [Parameter] public EventCallback<decimal> NominalHeatMtChanged { get; set; }
    [Parameter] public decimal MaximumCampaignMt { get; set; }
    [Parameter] public EventCallback<decimal> MaximumCampaignMtChanged { get; set; }
    [Parameter] public int FrozenMinutes { get; set; }
    [Parameter] public EventCallback<int> FrozenMinutesChanged { get; set; }
    [Parameter] public int SolverSeconds { get; set; }
    [Parameter] public EventCallback<int> SolverSecondsChanged { get; set; }
    [Parameter] public EventCallback OnRecalculate { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private Task HeatChanged(ChangeEventArgs e) => decimal.TryParse(e.Value?.ToString(), out var v) ? NominalHeatMtChanged.InvokeAsync(v) : Task.CompletedTask;
    private Task CampaignChanged(ChangeEventArgs e) => decimal.TryParse(e.Value?.ToString(), out var v) ? MaximumCampaignMtChanged.InvokeAsync(v) : Task.CompletedTask;
    private Task FrozenChanged(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? FrozenMinutesChanged.InvokeAsync(v) : Task.CompletedTask;
    private Task SolverChanged(ChangeEventArgs e) => int.TryParse(e.Value?.ToString(), out var v) ? SolverSecondsChanged.InvokeAsync(v) : Task.CompletedTask;
}
