<div class="rounded border border-border bg-surface-inset p-3">
    <div class="text-xs text-muted">@Label</div>
    <div class="mt-1 grid grid-cols-[1fr_auto_1fr] items-center gap-2 text-xs">
        <span class="truncate text-secondary">@Baseline</span>
        <span class="text-muted" aria-hidden="true">→</span>
        <strong class="truncate text-right">@NewValue</strong>
    </div>
    <div class="mt-1 text-right text-xs font-semibold text-secondary">Δ @Delta</div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Baseline { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string NewValue { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Delta { get; set; } = string.Empty;
}
