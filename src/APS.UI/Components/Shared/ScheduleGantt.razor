@using APS.Application

<div class="grid grid-cols-[160px_1fr] border-b border-border pb-1 text-xs text-muted">
    <div></div>
    <div class="relative h-4">
        @foreach (var tick in AxisTicks())
        {
            <span class="absolute -translate-x-1/2">@tick.ToString("ddd HH:mm")</span>
        }
    </div>
</div>
<div class="divide-y divide-border">
    @foreach (var row in Rows)
    {
        <div class="grid grid-cols-[160px_1fr] items-center py-1.5">
            <div class="truncate pr-2 text-xs font-medium" title="@row.ResourceName">@row.ResourceName</div>
            <div class="relative h-6 rounded bg-surface">
                @foreach (var block in row.Downtime)
                {
                    <div class="absolute top-0.5 h-5 rounded bg-border-strong" style="@BlockStyle(block.Start, block.End)" title="Downtime @block.Reason"></div>
                }
                @foreach (var block in row.Blocks)
                {
                    <div class="absolute top-0.5 h-5 overflow-hidden rounded px-1 text-[10px] leading-5 @CssClass(block.TaskType)" style="@BlockStyle(block.StartUtc, block.EndUtc)" title="@block.Title">
                        @block.Title
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DateTime HorizonStartUtc { get; set; }
    [Parameter, EditorRequired] public DateTime HorizonEndUtc { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<GanttRow> Rows { get; set; } = Array.Empty<GanttRow>();

    public sealed record GanttRow(string ResourceName, IReadOnlyList<GanttBlock> Blocks, IReadOnlyList<GanttDowntime> Downtime);
    public sealed record GanttBlock(string Title, FiniteScheduleTaskType TaskType, DateTime StartUtc, DateTime EndUtc);
    public sealed record GanttDowntime(string Reason, DateTime Start, DateTime End);

    private IEnumerable<DateTime> AxisTicks()
    {
        var span = HorizonEndUtc - HorizonStartUtc;
        var stepCount = 6;
        var step = span / stepCount;
        for (var i = 0; i <= stepCount; i++)
        {
            yield return HorizonStartUtc + step * i;
        }
    }

    private string BlockStyle(DateTime start, DateTime end)
    {
        var horizonMinutes = Math.Max(1, (HorizonEndUtc - HorizonStartUtc).TotalMinutes);
        var clampedStart = Clamp(start);
        var clampedEnd = Clamp(end);
        var leftPct = (clampedStart - HorizonStartUtc).TotalMinutes / horizonMinutes * 100;
        var widthPct = Math.Max(0.3, (clampedEnd - clampedStart).TotalMinutes / horizonMinutes * 100);
        return $"left:{leftPct.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;width:{widthPct.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

    private DateTime Clamp(DateTime value) =>
        value < HorizonStartUtc ? HorizonStartUtc : value > HorizonEndUtc ? HorizonEndUtc : value;

    private static string CssClass(FiniteScheduleTaskType type) => type switch
    {
        FiniteScheduleTaskType.Casting => "bg-process-casting text-white",
        FiniteScheduleTaskType.HotRolling => "bg-process-hot-roll text-white",
        FiniteScheduleTaskType.ColdRolling => "bg-process-cold-roll text-white",
        FiniteScheduleTaskType.Finishing => "bg-process-finishing text-white",
        _ => "bg-border-strong text-primary"
    };
}
