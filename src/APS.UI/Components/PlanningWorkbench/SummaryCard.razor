<article class="rounded-surface border border-border bg-surface p-3 shadow-soft">
    <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">@Label</span>
    <strong class="mt-1 block text-base">@Value</strong>
    <p class="mt-1 text-xs text-secondary">@Detail</p>
</article>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Detail { get; set; } = string.Empty;
}
