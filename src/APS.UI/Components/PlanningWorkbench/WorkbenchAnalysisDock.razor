<section class="shrink-0 border-t border-border bg-surface" aria-label="Planner analysis">
    <div class="flex h-8 items-center gap-1 overflow-x-auto px-2">
        @foreach (var item in Views)
        {
            <button type="button"
                    class="h-full shrink-0 border-b-2 px-2 text-[11px] @(Expanded && View == item.View ? "border-accent text-accent" : "border-transparent text-secondary hover:text-primary")"
                    @onclick="() => SelectAsync(item.View)">@item.Label</button>
        }
        <button type="button" class="ml-auto shrink-0 px-2 text-[11px] text-muted" @onclick="() => Toggle.InvokeAsync()">@(Expanded ? "Collapse" : "Open")</button>
    </div>

    @if (Expanded)
    {
        <div class="h-[30vh] min-h-40 overflow-auto border-t border-border bg-surface-raised p-3">
            @if (View == PlannerAnalysisView.ControlOverview)
            {
                <div class="grid gap-3 lg:grid-cols-4">
                    @foreach (var card in OverviewCards)
                    {
                        <article class="rounded-surface border border-border bg-surface p-3 shadow-soft">
                            <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">@card.Label</span>
                            <strong class="mt-1 block text-base">@card.Value</strong>
                            <p class="mt-1 text-xs text-secondary">@card.Detail</p>
                        </article>
                    }
                </div>
            }
            else
            {
                var panel = CurrentPanel;
                <div class="flex min-h-32 items-start justify-between gap-6 rounded-surface border border-border bg-surface p-4 shadow-soft">
                    <div>
                        <h3 class="text-sm font-semibold">@panel.Title</h3>
                        <p class="mt-1 max-w-2xl text-xs text-secondary">@panel.Detail</p>
                        <div class="mt-4 flex gap-6 text-xs"><strong>@panel.Primary</strong><span class="text-muted">@panel.Secondary</span></div>
                    </div>
                    @if (panel.Href is not null)
                    {
                        <NavLink href="@panel.Href" class="shrink-0 rounded-control border border-border-strong px-3 py-2 text-xs hover:bg-surface-hover">@panel.LinkLabel</NavLink>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public PlannerAnalysisView View { get; set; }
    [Parameter] public int CriticalCount { get; set; }
    [Parameter] public int WarningCount { get; set; }
    [Parameter] public int LateDemand { get; set; }
    [Parameter] public EventCallback<PlannerAnalysisView> ViewChanged { get; set; }
    [Parameter] public EventCallback Toggle { get; set; }

    private static readonly (PlannerAnalysisView View, string Label)[] Views =
    [
        (PlannerAnalysisView.ControlOverview, "Overview"),
        (PlannerAnalysisView.Exceptions, "Exceptions"),
        (PlannerAnalysisView.Capacity, "Capacity"),
        (PlannerAnalysisView.Delivery, "Delivery"),
        (PlannerAnalysisView.Material, "Material"),
        (PlannerAnalysisView.ScenarioComparison, "Compare"),
        (PlannerAnalysisView.Execution, "Execution"),
        (PlannerAnalysisView.Traceability, "Traceability")
    ];

    private (string Label, string Value, string Detail)[] OverviewCards =>
    [
        ("Plan health", CriticalCount == 0 ? "Ready" : $"{CriticalCount} critical", $"{WarningCount} warnings across the active scenario"),
        ("Delivery exposure", $"{LateDemand} late", "Orders projected beyond their required date"),
        ("Planning focus", "Review exceptions", "Open the queue or select an operation to investigate"),
        ("Next decision", "Validate or iterate", "Compare consequences before releasing the scenario")
    ];

    private AnalysisPanel CurrentPanel => View switch
    {
        PlannerAnalysisView.Exceptions => new("Exceptions", "Constraint failures and warnings for the visible scenario.", $"{CriticalCount} critical", $"{WarningCount} warnings"),
        PlannerAnalysisView.Capacity => new("Capacity", "Resource load, idle windows, and bottleneck exposure stay aligned with the visible Gantt window.", "Inspect loaded lanes", "Use the resource rows above"),
        PlannerAnalysisView.Delivery => new("Delivery", "Demand-at-risk and due-date consequences of the current sequence.", $"{LateDemand} late orders", "Open Demand queue to focus an order"),
        PlannerAnalysisView.Material => new("Material", "Supply, reservations, and time-phased material balance for the selected chain.", "Material consequences", "Open detailed material flow only when needed", "/plan/material-flow", "Open material details"),
        PlannerAnalysisView.ScenarioComparison => new("Scenario comparison", "Compare the working scenario against its released baseline before committing it.", "Baseline versus working plan", "Schedule, delivery, and capacity deltas", "/decide/compare", "Open full comparison"),
        PlannerAnalysisView.Execution => new("Execution monitor", "Planned versus actual timing, held work, and recovery triggers.", "Execution status", "Select an operation above for actual timestamps", "/operate/work-orders", "Open work orders"),
        PlannerAnalysisView.Traceability => new("Traceability", "Commercial demand, campaign, heat, material, and work-order lineage for the selected item.", "Selected-object genealogy", "Select an operation or demand item first", "/operate/traceability", "Open traceability details"),
        _ => throw new InvalidOperationException($"{View} does not use an analysis message panel.")
    };

    private async Task SelectAsync(PlannerAnalysisView view)
    {
        if (!Expanded && view == View)
            await Toggle.InvokeAsync();
        await ViewChanged.InvokeAsync(view);
    }

    private sealed record AnalysisPanel(
        string Title,
        string Detail,
        string Primary,
        string Secondary,
        string? Href = null,
        string LinkLabel = "Open details");
}
