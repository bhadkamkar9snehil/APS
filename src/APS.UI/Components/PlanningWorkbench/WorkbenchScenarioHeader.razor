@using APS.Domain

<header class="border-b border-border bg-surface px-3 py-1.5">
    <div class="flex min-h-9 flex-wrap items-center gap-2">
        <div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
                <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-muted">Scenario</span>
                <h1 class="max-w-72 truncate text-sm font-semibold">@ScenarioName</h1>
                <span class="rounded px-2 py-0.5 text-xs font-semibold @StateClass">@StateLabel</span>
                @if (IsReleased) { <span class="rounded border border-border-strong px-2 py-0.5 text-xs text-secondary">Execution baseline</span> }
            <div class="ml-2 hidden gap-x-3 text-[10px] text-muted lg:flex">
                <span>@OperationCount operations</span>
                <span>@ResourceCount resources</span>
                <span>@ScheduleStartUtc.ToString("dd MMM HH:mm") → @ScheduleEndUtc.ToString("dd MMM HH:mm")</span>
                <span>Actuals @ActualsTimeUtc.ToString("dd MMM HH:mm") UTC</span>
            </div>
        </div>

        <div class="flex items-center gap-1.5" aria-label="Scenario actions">
            <button class="rounded-control border border-border-strong px-2.5 py-1 text-xs disabled:opacity-40" disabled="@(!CanUndo)" @onclick="Undo">Undo</button>
            <button class="rounded-control border border-border-strong px-2.5 py-1 text-xs disabled:opacity-40" disabled="@(!CanRedo)" @onclick="Redo">Redo</button>
            <button class="rounded-control border border-accent-border bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent disabled:opacity-40" disabled="@(!CanEdit)" @onclick="Optimize">Optimize</button>
            <button class="rounded-control border border-border-strong px-2.5 py-1 text-xs disabled:opacity-40" disabled="@(!CanEdit)" @onclick="Validate">Validate</button>
            <button class="rounded-control bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground disabled:opacity-40" disabled="@(!CanRelease)" @onclick="Release">Release</button>
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string ScenarioName { get; set; } = "Scenario";
    [Parameter, EditorRequired] public string StateLabel { get; set; } = "Draft";
    [Parameter] public string StateClass { get; set; } = "bg-surface-inset text-secondary";
    [Parameter] public bool IsReleased { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanUndo { get; set; }
    [Parameter] public bool CanRedo { get; set; }
    [Parameter] public bool CanRelease { get; set; }
    [Parameter] public int OperationCount { get; set; }
    [Parameter] public int ResourceCount { get; set; }
    [Parameter] public DateTime ScheduleStartUtc { get; set; }
    [Parameter] public DateTime ScheduleEndUtc { get; set; }
    [Parameter] public DateTime ActualsTimeUtc { get; set; }
    [Parameter] public EventCallback Undo { get; set; }
    [Parameter] public EventCallback Redo { get; set; }
    [Parameter] public EventCallback Optimize { get; set; }
    [Parameter] public EventCallback Validate { get; set; }
    [Parameter] public EventCallback Release { get; set; }
}
