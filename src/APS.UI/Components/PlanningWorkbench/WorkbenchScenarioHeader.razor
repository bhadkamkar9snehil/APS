@using APS.Domain
@using APS.UI.State

<header class="border-b border-border bg-surface px-3 py-1.5">
    <div class="flex min-h-9 min-w-0 items-center gap-3">
        <div class="flex shrink-0 items-center gap-2">
            <span class="shrink-0 aps-text-label">Scenario</span>
            <h1 class="w-56 max-w-[28vw] truncate text-sm font-bold tracking-tight">@ScenarioName</h1>
            <span class="shrink-0 rounded-sm px-2 py-0.5 text-xs font-semibold @StateClass">@StateLabel</span>
            @if (IsReleased) { <span class="shrink-0 rounded-sm border border-border-strong px-2 py-0.5 text-xs text-secondary">Execution baseline</span> }
        </div>

        <div class="hidden min-w-0 items-center gap-2 border-l border-border pl-3 min-[1440px]:flex">
            <span class="whitespace-nowrap text-xs text-secondary"><strong class="aps-text-figure">@OperationCount</strong> operations · <strong class="aps-text-figure">@ResourceCount</strong> resources</span>
            <span class="hidden whitespace-nowrap text-xs text-secondary min-[1700px]:inline"><strong class="aps-text-figure">@ScheduleStartUtc.ToString("dd MMM HH:mm") → @ScheduleEndUtc.ToString("dd MMM HH:mm")</strong></span>
            <span class="hidden whitespace-nowrap text-xs text-secondary min-[1900px]:inline">Plan reference <strong class="aps-text-figure">@PlanReferenceUtc.ToString("dd MMM HH:mm'Z'")</strong></span>
        </div>

        <div class="ml-auto flex shrink-0 items-center gap-1.5" aria-label="Scenario actions">
            @if (IsReleased && CanStartRecovery && Mode is PlanningWorkbenchMode.Execution or PlanningWorkbenchMode.Recovery)
            {
                <span class="mx-1 h-5 w-px bg-border"></span>
                <button class="rounded-sm border border-accent-border bg-surface-raised px-2.5 py-1 text-xs font-semibold text-accent shadow-soft hover:bg-surface-hover" @onclick="() => StartRecovery.InvokeAsync()">Create recovery scenario</button>
            }
            else if (IsReleased && Mode is PlanningWorkbenchMode.Plan or PlanningWorkbenchMode.Campaigns)
            {
                <span class="mx-1 h-5 w-px bg-border"></span>
                <button class="rounded-sm border border-accent-border bg-surface-raised px-2.5 py-1 text-xs font-semibold text-accent shadow-soft hover:bg-surface-hover" @onclick="() => StartPlanning.InvokeAsync()">Create planning scenario</button>
            }
            <NavLink href="/plan/constraints" class="hidden rounded-control border border-border-strong px-2.5 py-1 text-xs font-medium hover:bg-surface-hover min-[1280px]:inline-flex" title="Planning controls used by Calculate and Replan">Controls</NavLink>
            <button class="hidden rounded-control border border-border-strong px-2.5 py-1 text-xs disabled:opacity-40 min-[1440px]:inline-flex" disabled="@(!CanUndo)" @onclick="Undo">Undo</button>
            <button class="hidden rounded-control border border-border-strong px-2.5 py-1 text-xs disabled:opacity-40 min-[1440px]:inline-flex" disabled="@(!CanRedo)" @onclick="Redo">Redo</button>
            <button class="rounded-control border border-accent-border bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent disabled:opacity-40" disabled="@(!CanEdit || IsBusy)" @onclick="Optimize">
                @if (IsBusy) { <span class="aps-pulse-dot mr-1 inline-block h-1.5 w-1.5 rounded-full bg-accent"></span> }
                Optimize
            </button>
            <button class="rounded-control border border-border-strong px-2.5 py-1 text-xs disabled:opacity-40" disabled="@(!CanEdit || IsBusy)" @onclick="Validate">Validate</button>

            @* ReleaseService intentionally requires an active Approved Plan Version. The workbench used
               to enable Release for Feasible plans, guaranteeing a backend rejection. Keep approval as an
               explicit planner decision and route feasible plans to the lifecycle review instead. *@
            @if (!IsReleased && IsApproved)
            {
                <button class="rounded-control bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground disabled:opacity-40" disabled="@IsBusy" @onclick="Release">Release</button>
            }
            else if (!IsReleased && IsFeasible)
            {
                <NavLink href="/plan/versions" class="rounded-control bg-accent px-2.5 py-1 text-xs font-semibold text-accent-foreground">Review &amp; approve</NavLink>
            }
            else if (IsReleased)
            {
                <NavLink href="/operate/work-orders" class="rounded-control border border-border-strong px-2.5 py-1 text-xs font-semibold hover:bg-surface-hover">Work orders</NavLink>
            }
        </div>
    </div>
    @* A CP-SAT solver runs behind Optimize/Validate/Release and can take real time - disabling the
       buttons is not itself feedback that something is happening (#UI-depth). This rail is the one
       place in the workbench that always says "the engine is working" regardless of which action
       triggered it. *@
    @if (IsBusy)
    {
        <div class="aps-activity-rail"></div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string ScenarioName { get; set; } = "Scenario";
    [Parameter, EditorRequired] public string StateLabel { get; set; } = "Draft";
    [Parameter] public string StateClass { get; set; } = "bg-surface-inset text-secondary";
    [Parameter] public PlanningWorkbenchMode Mode { get; set; }
    [Parameter] public bool IsReleased { get; set; }
    [Parameter] public bool CanStartRecovery { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanUndo { get; set; }
    [Parameter] public bool CanRedo { get; set; }
    [Parameter] public bool CanRelease { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public int OperationCount { get; set; }
    [Parameter] public int ResourceCount { get; set; }
    [Parameter] public DateTime ScheduleStartUtc { get; set; }
    [Parameter] public DateTime ScheduleEndUtc { get; set; }
    [Parameter] public DateTime PlanReferenceUtc { get; set; }
    [Parameter] public EventCallback Undo { get; set; }
    [Parameter] public EventCallback Redo { get; set; }
    [Parameter] public EventCallback Optimize { get; set; }
    [Parameter] public EventCallback Validate { get; set; }
    [Parameter] public EventCallback Release { get; set; }
    [Parameter] public EventCallback StartPlanning { get; set; }
    [Parameter] public EventCallback StartRecovery { get; set; }

    private bool IsApproved => string.Equals(StateLabel, PlanVersionStatus.Approved.ToString(), StringComparison.OrdinalIgnoreCase);
    private bool IsFeasible => string.Equals(StateLabel, PlanVersionStatus.Feasible.ToString(), StringComparison.OrdinalIgnoreCase);
}
