<div class="flex min-h-32 items-start justify-between gap-6 rounded-surface border border-border bg-surface p-4 shadow-soft">
    <div>
        <h3 class="text-sm font-semibold">@Title</h3>
        <p class="mt-1 max-w-2xl text-xs text-secondary">@Detail</p>
        <div class="mt-4 flex gap-6 text-xs"><strong>@Primary</strong><span class="text-muted">@Secondary</span></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Href))
    {
        <NavLink href="@Href" class="shrink-0 rounded-control border border-border-strong px-3 py-2 text-xs hover:bg-surface-hover">@LinkLabel</NavLink>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Detail { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Primary { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Secondary { get; set; } = string.Empty;
    [Parameter] public string? Href { get; set; }
    [Parameter] public string LinkLabel { get; set; } = "Open details";
}
