@using APS.UI.State

<fieldset class="flex min-w-0 items-center gap-5 py-1">
    <legend class="sr-only">Planning lifecycle</legend>
    @foreach (var item in items)
    {
        var selected = Mode == item.Mode;
        <span class="relative">
            <input id="@($"planning-workbench-mode-{item.Mode}")"
                   class="peer sr-only"
                   type="radio"
                   name="planning-workbench-mode"
                   value="@item.Mode"
                   checked="@selected"
                   @onchange="() => SelectAsync(item.Mode)" />
            <label for="@($"planning-workbench-mode-{item.Mode}")"
                   class="relative px-0 py-2 text-[13px] font-semibold leading-5 text-secondary transition-colors hover:text-primary peer-checked:text-primary peer-checked:after:absolute peer-checked:after:inset-x-0 peer-checked:after:bottom-0 peer-checked:after:h-0.5 peer-checked:after:bg-accent peer-focus-visible:outline-none peer-focus-visible:ring-2 peer-focus-visible:ring-accent peer-focus-visible:ring-offset-2"
                   title="@item.Description">
                <span>@item.Label</span>
            </label>
        </span>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public PlanningWorkbenchMode Mode { get; set; }
    [Parameter] public EventCallback<PlanningWorkbenchMode> ModeChanged { get; set; }

    private readonly LifecycleItem[] items =
    [
        new(PlanningWorkbenchMode.Plan, "Plan", "Optimize and adjust"),
        new(PlanningWorkbenchMode.Campaigns, "Campaigns", "Compose heats and casts"),
        new(PlanningWorkbenchMode.Execution, "Execution", "Compare plan with actuals"),
        new(PlanningWorkbenchMode.Recovery, "Recovery", "Repair future work")
    ];

    private Task SelectAsync(PlanningWorkbenchMode mode) => ModeChanged.InvokeAsync(mode);
    private sealed record LifecycleItem(PlanningWorkbenchMode Mode, string Label, string Description);
}
