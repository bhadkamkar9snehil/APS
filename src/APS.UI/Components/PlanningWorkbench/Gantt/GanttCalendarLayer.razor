@foreach (var interval in Row.CalendarIntervals.Where(x => !x.IsAvailable))
{
    <div class="aps-calendar-unavailable pointer-events-none absolute inset-y-0 z-[2]"
         style="left:@GanttModels.Percent(State, interval.StartUtc)%;width:@GanttModels.WidthPercent(State, interval.StartUtc, interval.EndUtc)%"
         title="@(interval.ReasonCode ?? "Resource unavailable") · @interval.StartUtc.ToString("dd MMM HH:mm")–@interval.EndUtc.ToString("HH:mm") · @interval.Source"></div>
}

@code {
    [Parameter, EditorRequired] public GanttRowModel Row { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
}
