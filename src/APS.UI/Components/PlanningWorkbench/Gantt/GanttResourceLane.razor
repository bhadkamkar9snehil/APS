<div class="aps-gantt-lane aps-time-grid relative overflow-hidden border-b border-border @(State.SelectedResourceIds.Contains(Row.Lane.ResourceId) ? "bg-accent-soft shadow-soft" : "even:bg-surface-raised")"
     data-resource-id="@Row.Lane.ResourceId"
     data-window-start="@State.VisibleStartUtc.ToString("O")"
     data-window-end="@State.VisibleEndUtc.ToString("O")"
     data-shift-boundaries="@ShiftBoundaries">
    <GanttMarkerLayer Scene="Scene" State="State" ReferenceTimeUtc="Workbench.Plan.ReferenceTimeUtc" FrozenFenceEndUtc="FrozenFenceEndUtc" />
    <GanttCalendarLayer Row="Row" State="State" />
    <GanttBaselineLayer Row="Row" State="State" />
    <GanttCampaignLayer Row="Row" State="State" SelectedCampaign="SelectedCampaign" />
    <GanttExecutionLayer Row="Row" State="State" ReferenceTimeUtc="Workbench.Plan.ReferenceTimeUtc" />
    @foreach (var operation in Row.Operations)
    {
        <GanttOperationBlock Model="operation"
                             State="State"
                             Selected="@(State.SelectedPlanningKeys.Contains(operation.Operation.PlanningKey))"
                             CanEdit="State.CanEditSchedule"
                             IsFrozen="@(operation.Operation.StartUtc <= FrozenFenceEndUtc)"
                             CapacityFocused="@IsCapacityFocused(operation.Operation)"
                             TabIndex="@(operation.Operation.PlanningKey.Equals(KeyboardAnchorPlanningKey, StringComparison.OrdinalIgnoreCase) ? 0 : -1)"
                             OperationSelected="OperationSelected"
                             KeyboardNavigate="KeyboardNavigate"
                             ContextRequested="ContextRequested" />
    }
    <GanttProposalLayer Row="Row" Scene="Scene" State="State" />
</div>

@code {
    [Parameter, EditorRequired] public GanttRowModel Row { get; set; } = default!;
    [Parameter, EditorRequired] public GanttScene Scene { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchView Workbench { get; set; } = default!;
    [Parameter] public DateTime FrozenFenceEndUtc { get; set; }
    [Parameter] public string KeyboardAnchorPlanningKey { get; set; } = string.Empty;
    [Parameter] public EventCallback<GanttOperationSelectionRequest> OperationSelected { get; set; }
    [Parameter] public EventCallback<GanttKeyboardNavigationRequest> KeyboardNavigate { get; set; }
    [Parameter] public EventCallback<GanttContextMenuRequest> ContextRequested { get; set; }

    private string? SelectedCampaign => State.SelectedPlanningKey is not null && Scene.DetailsByKey.TryGetValue(State.SelectedPlanningKey, out var detail)
        ? detail.CampaignNumber
        : null;
    private string ShiftBoundaries => string.Join(",", Row.CalendarIntervals
        .SelectMany(x => new[] { x.StartUtc, x.EndUtc })
        .Where(x => x >= State.VisibleStartUtc && x <= State.VisibleEndUtc)
        .Distinct()
        .OrderBy(x => x)
        .Select(x => x.ToString("O")));
    private bool IsCapacityFocused(ScheduledProcessOperationView operation) => State.CapacityFocus is { } focus &&
        operation.ResourceId == focus.ResourceId &&
        operation.EndUtc > focus.StartUtc && operation.StartUtc < focus.EndUtc;
}
