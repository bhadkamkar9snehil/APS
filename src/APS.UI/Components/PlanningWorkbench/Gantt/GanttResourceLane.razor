<div class="aps-gantt-lane aps-time-grid relative overflow-hidden border-b border-border even:bg-surface-raised"
     data-resource-id="@Row.Lane.ResourceId"
     data-window-start="@State.VisibleStartUtc.ToString("O")"
     data-window-end="@State.VisibleEndUtc.ToString("O")">
    <GanttMarkerLayer Scene="Scene" State="State" ReferenceTimeUtc="Workbench.Plan.ReferenceTimeUtc" FrozenFenceEndUtc="FrozenFenceEndUtc" />
    <GanttCalendarLayer Row="Row" State="State" />
    <GanttBaselineLayer Row="Row" State="State" />
    <GanttCampaignLayer Row="Row" State="State" SelectedCampaign="SelectedCampaign" />
    @foreach (var operation in Row.Operations)
    {
        <GanttOperationBlock Model="operation"
                             State="State"
                             Selected="@(State.SelectedPlanningKey == operation.Operation.PlanningKey)"
                             CanEdit="State.CanEditSchedule"
                             IsFrozen="@(operation.Operation.StartUtc <= FrozenFenceEndUtc)"
                             OperationSelected="OperationSelected" />
    }
    <GanttProposalLayer Row="Row" Scene="Scene" State="State" />
</div>

@code {
    [Parameter, EditorRequired] public GanttRowModel Row { get; set; } = default!;
    [Parameter, EditorRequired] public GanttScene Scene { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchView Workbench { get; set; } = default!;
    [Parameter] public DateTime FrozenFenceEndUtc { get; set; }
    [Parameter] public EventCallback<ScheduledProcessOperationView> OperationSelected { get; set; }

    private string? SelectedCampaign => State.SelectedPlanningKey is not null && Scene.DetailsByKey.TryGetValue(State.SelectedPlanningKey, out var detail)
        ? detail.CampaignNumber
        : null;
}
