@if (State.ShowDependencies && State.SelectedPlanningKey is not null)
{
    <svg class="pointer-events-none absolute inset-0 z-20 h-full w-full overflow-visible"
         viewBox="@($"0 0 100 {Math.Max(1, Scene.TotalRowCount * State.GanttRowHeightPx)}")"
         preserveAspectRatio="none"
         aria-hidden="true">
        @foreach (var edge in Scene.DependencyLines)
        {
            var elbow = Math.Max(edge.StartXPercent + .4d, (edge.StartXPercent + edge.EndXPercent) / 2d);
            <path d="M @(edge.StartXPercent) @(edge.StartYpx) H @elbow V @(edge.EndYpx) H @(edge.EndXPercent)"
                  fill="none" stroke="var(--aps-border-strong)" stroke-width="1.25" stroke-dasharray="3 3" vector-effect="non-scaling-stroke">
                <title>@edge.Type · @edge.Category · current lag @edge.CurrentLagMinutes min · minimum @(edge.MinimumLagMinutes?.ToString() ?? "not returned") min · headroom @(edge.HeadroomMinutes?.ToString() ?? "not returned") min</title>
            </path>
        }
    </svg>
    <span class="sr-only">@string.Join("; ", Scene.DependencyLines.Select(edge => $"{edge.PredecessorPlanningKey} to {edge.SuccessorPlanningKey}, {edge.Type}, {edge.Category}, current lag {edge.CurrentLagMinutes} minutes, headroom {(edge.HeadroomMinutes?.ToString() ?? "not returned")} minutes"))</span>
}

@code {
    [Parameter, EditorRequired] public GanttScene Scene { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
}
