<div class="relative" style="height:@($"{Scene.TotalRowCount * State.GanttRowHeightPx}px")">
    @if (State.ShowDependencies && State.SelectedPlanningKey is not null)
    {
        <svg class="pointer-events-none absolute inset-0 z-20 h-full w-full overflow-visible"
             viewBox="@($"0 0 100 {Math.Max(1, Scene.TotalRowCount * State.GanttRowHeightPx)}")"
             preserveAspectRatio="none"
             aria-hidden="true">
            @foreach (var edge in Scene.DependencyLines)
            {
                var elbow = Math.Max(edge.StartXPercent + .4d, (edge.StartXPercent + edge.EndXPercent) / 2d);
                <path d="M @(edge.StartXPercent) @(edge.StartYpx) H @elbow V @(edge.EndYpx) H @(edge.EndXPercent)"
                      fill="none" stroke="var(--aps-border-strong)" stroke-width="1.25" stroke-dasharray="3 3" vector-effect="non-scaling-stroke">
                    <title>@edge.Type · @edge.Category · current lag @edge.CurrentLagMinutes min · minimum @(edge.MinimumLagMinutes?.ToString() ?? "not returned") min · headroom @(edge.HeadroomMinutes?.ToString() ?? "not returned") min</title>
                </path>
            }
        </svg>
        <span class="sr-only">@string.Join("; ", Scene.DependencyLines.Select(edge => $"{edge.PredecessorPlanningKey} to {edge.SuccessorPlanningKey}, {edge.Type}, {edge.Category}, current lag {edge.CurrentLagMinutes} minutes, headroom {(edge.HeadroomMinutes?.ToString() ?? "not returned")} minutes"))</span>
    }
    <div>
        @if (FirstMountedSceneIndex > 0)
        {
            <div aria-hidden="true" style="height:@($"{FirstMountedSceneIndex * State.GanttRowHeightPx}px")"></div>
        }
        @foreach (var sceneIndex in MountedSceneIndices)
        {
            @if (GroupsByIndex.TryGetValue(sceneIndex, out var group))
            {
                <div class="relative flex items-center border-b border-border bg-surface-inset px-2" style="height:var(--aps-gantt-row-height)" aria-hidden="true">
                    <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">@group.Code · @group.ResourceCount resource(s)</span>
                </div>
            }
            else if (RowsByIndex.TryGetValue(sceneIndex, out var row))
            {
                <div style="height:var(--aps-gantt-row-height)"><GanttResourceLane Row="row" Scene="Scene" State="State" Workbench="Workbench" FrozenFenceEndUtc="FrozenFenceEndUtc" KeyboardAnchorPlanningKey="@KeyboardAnchorPlanningKey" OperationSelected="OperationSelected" KeyboardNavigate="KeyboardNavigate" ContextRequested="ContextRequested" /></div>
            }
        }
        @if (LastMountedSceneIndex >= 0 && LastMountedSceneIndex < Scene.TotalRowCount - 1)
        {
            <div aria-hidden="true" style="height:@($"{(Scene.TotalRowCount - LastMountedSceneIndex - 1) * State.GanttRowHeightPx}px")"></div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GanttScene Scene { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchView Workbench { get; set; } = default!;
    [Parameter] public DateTime FrozenFenceEndUtc { get; set; }
    [Parameter] public string KeyboardAnchorPlanningKey { get; set; } = string.Empty;
    [Parameter] public EventCallback<GanttOperationSelectionRequest> OperationSelected { get; set; }
    [Parameter] public EventCallback<GanttKeyboardNavigationRequest> KeyboardNavigate { get; set; }
    [Parameter] public EventCallback<GanttContextMenuRequest> ContextRequested { get; set; }

    private IReadOnlyDictionary<int, GanttResourceGroupModel> GroupsByIndex { get; set; } = new Dictionary<int, GanttResourceGroupModel>();
    private IReadOnlyDictionary<int, GanttRowModel> RowsByIndex { get; set; } = new Dictionary<int, GanttRowModel>();
    private int[] MountedSceneIndices { get; set; } = [];
    private int FirstMountedSceneIndex => MountedSceneIndices.FirstOrDefault();
    private int LastMountedSceneIndex => MountedSceneIndices.LastOrDefault(-1);

    protected override void OnParametersSet()
    {
        GroupsByIndex = Scene.ResourceGroups.ToDictionary(x => x.SceneIndex);
        RowsByIndex = Scene.Rows.ToDictionary(x => x.SceneIndex);
        MountedSceneIndices = Scene.ResourceGroups.Select(x => x.SceneIndex)
            .Concat(Scene.Rows.Select(x => x.SceneIndex))
            .OrderBy(x => x)
            .ToArray();
    }
}
