<div class="relative" style="height:@($"{Scene.Rows.Count * State.Viewport.RowHeightPx}px")">
    @if (State.ShowDependencies && State.SelectedPlanningKey is not null)
    {
        <svg class="pointer-events-none absolute inset-0 z-20 h-full w-full overflow-visible"
             viewBox="@($"0 0 100 {Math.Max(1, Scene.Rows.Count * State.Viewport.RowHeightPx)}")"
             preserveAspectRatio="none"
             aria-hidden="true">
            @foreach (var edge in FocusedDependencyLines())
            {
                <path d="M @(edge.StartXPercent) @(edge.StartYpx) H @((edge.StartXPercent + edge.EndXPercent) / 2d) V @(edge.EndYpx) H @(edge.EndXPercent)"
                      fill="none" stroke="var(--aps-border-strong)" stroke-width="1.25" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" />
            }
        </svg>
    }
    <div class="grid" style="grid-auto-rows:var(--aps-gantt-row-height)">
        @foreach (var row in Scene.Rows)
        {
            <GanttResourceLane Row="row" Scene="Scene" State="State" Workbench="Workbench" FrozenFenceEndUtc="FrozenFenceEndUtc" OperationSelected="OperationSelected" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public GanttScene Scene { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchView Workbench { get; set; } = default!;
    [Parameter] public DateTime FrozenFenceEndUtc { get; set; }
    [Parameter] public EventCallback<ScheduledProcessOperationView> OperationSelected { get; set; }

    private IReadOnlyList<GanttDependencyLineModel> FocusedDependencyLines() => Scene.DependencyLines;
}
