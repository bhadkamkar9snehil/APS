@if (State.Mode == PlanningWorkbenchMode.Campaigns || SelectedCampaign is not null)
{
    @foreach (var campaign in Row.CampaignSpans.Where(x => SelectedCampaign is null || x.CampaignNumber.Equals(SelectedCampaign, StringComparison.OrdinalIgnoreCase)))
    {
        <div class="aps-campaign-span pointer-events-none absolute top-0.5 z-[5] h-1 rounded-full"
             style="left:@campaign.LeftPercent%;width:@campaign.WidthPercent%"
             title="Campaign @campaign.CampaignNumber · @campaign.OperationCount operation(s)"></div>
    }
}

@code {
    [Parameter, EditorRequired] public GanttRowModel Row { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
    [Parameter] public string? SelectedCampaign { get; set; }
}
