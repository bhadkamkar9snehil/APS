@if (State.Mode is PlanningWorkbenchMode.Execution or PlanningWorkbenchMode.Recovery)
{
    @foreach (var model in Row.Operations.Where(x => x.ActualStartUtc is not null))
    {
        var actualStart = model.ActualStartUtc!.Value;
        var actualEnd = model.ActualEndUtc ?? ReferenceTimeUtc;
        if (actualEnd > actualStart && actualEnd > State.VisibleStartUtc && actualStart < State.VisibleEndUtc)
        {
            var clippedStart = actualStart < State.VisibleStartUtc ? State.VisibleStartUtc : actualStart;
            var clippedEnd = actualEnd > State.VisibleEndUtc ? State.VisibleEndUtc : actualEnd;
            <div class="pointer-events-none absolute bottom-1 z-[16] h-2 min-w-1 overflow-hidden rounded-sm border border-primary @(model.ExecutionStatus == OperationExecutionStatus.Completed ? "bg-success" : "bg-warning")"
                 style="left:@GanttModels.Percent(State, clippedStart)%;width:@GanttModels.WidthPercent(State, clippedStart, clippedEnd)%"
                 title="Actual · @model.Operation.PlanningKey · @actualStart.ToString("dd MMM HH:mm")–@(model.ActualEndUtc?.ToString("dd MMM HH:mm") ?? $"{ReferenceTimeUtc:dd MMM HH:mm} running")">
                <span class="block px-0.5 text-[7px] font-bold leading-[6px] text-inverted">A</span>
            </div>
            <span class="sr-only">Actual execution for @model.Operation.PlanningKey from @actualStart.ToString("dd MMM HH:mm") to @(model.ActualEndUtc?.ToString("dd MMM HH:mm") ?? $"planning reference {ReferenceTimeUtc:dd MMM HH:mm}")</span>
        }
    }
}

@code {
    [Parameter, EditorRequired] public GanttRowModel Row { get; set; } = default!;
    [Parameter, EditorRequired] public PlanningWorkbenchState State { get; set; } = default!;
    [Parameter] public DateTime ReferenceTimeUtc { get; set; }
}
