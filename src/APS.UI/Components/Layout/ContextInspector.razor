@implements IDisposable
@inject PlannerWorkspaceState WorkspaceState

<aside class="@(WorkspaceState.SelectedEntity is null ? "w-0 overflow-hidden" : "w-72 shrink-0") border-l border-border bg-surface-raised transition-all" aria-label="Selected entity details">
    @if (WorkspaceState.SelectedEntity is { } selected)
    {
        <div class="flex items-center justify-between border-b border-border px-4 py-2.5">
            <div>
                <div class="text-xs font-semibold uppercase tracking-wide text-muted">@selected.EntityType</div>
                <strong>@selected.DisplayCode</strong>
            </div>
            <button type="button" class="rounded px-2 py-1 text-muted hover:bg-surface-hover hover:text-primary" title="Close" @onclick="WorkspaceState.ClearSelection">&times;</button>
        </div>
        <div class="space-y-4 px-4 py-3">
            <section>
                <div class="mb-1 text-xs font-semibold uppercase tracking-wide text-muted">Identity</div>
                <dl class="space-y-1 text-xs">
                    <div class="flex justify-between gap-2"><dt class="text-secondary">Type</dt><dd>@selected.EntityType</dd></div>
                    <div class="flex justify-between gap-2"><dt class="text-secondary">ID</dt><dd class="truncate font-mono">@selected.EntityId</dd></div>
                </dl>
            </section>
            <p class="text-xs text-muted">
                Type-specific lineage, requirements, diagnostics and safe actions are populated by the workspace read models as each production surface is implemented.
            </p>
        </div>
    }
</aside>

@code {
    protected override void OnInitialized() => WorkspaceState.Changed += OnWorkspaceChanged;

    private void OnWorkspaceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}
