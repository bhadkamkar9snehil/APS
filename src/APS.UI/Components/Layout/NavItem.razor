<NavLink href="@Href" Match="Match" class="block rounded-control px-2.5 py-1.5 text-secondary transition-colors hover:bg-surface-hover hover:text-primary" ActiveClass="bg-accent-soft text-accent font-semibold outline outline-1 outline-accent-border">
    @Label
</NavLink>

@code {
    [Parameter] public string Href { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;
}
