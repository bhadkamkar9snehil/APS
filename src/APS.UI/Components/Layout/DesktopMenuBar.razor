@implements IDisposable
@inject NavigationManager Navigation
@inject PlannerCockpitState Cockpit
@inject ThemeService Theme
@inject IUpdateService Updates

<header class="relative z-50 flex h-8 shrink-0 items-center border-b border-border bg-surface px-2 shadow-soft" aria-label="Application menu">
    <button type="button" class="mr-2 grid h-7 w-7 place-items-center rounded-control hover:bg-surface-hover" aria-label="Open Planning Workbench" @onclick="OpenWorkbench">
        <img src="_content/APS.UI/app-icon.png" alt="" class="h-6 w-6 object-contain" />
    </button>
    <DesktopMenu Label="File">
        <MenuLink Href="/" Label="Planning Workbench" />
        <MenuLink Href="/plan/versions" Label="Plans and scenarios" />
        <MenuButton Label="New planning scenario" OnClick="() => Cockpit.RequestCommand(PlannerCockpitCommand.CreateScenario)" />
    </DesktopMenu>
    <DesktopMenu Label="Plan">
        <MenuButton Label="Optimize schedule" Shortcut="Ctrl+O" OnClick="() => Cockpit.RequestCommand(PlannerCockpitCommand.Optimize)" />
        <MenuButton Label="Validate plan" OnClick="() => Cockpit.RequestCommand(PlannerCockpitCommand.Validate)" />
        <MenuButton Label="Release plan" OnClick="() => Cockpit.RequestCommand(PlannerCockpitCommand.Release)" />
        <MenuLink Href="/plan/campaigns" Label="Campaign register" />
    </DesktopMenu>
    <DesktopMenu Label="View">
        <MenuButton Label="Demand queue" OnClick="Cockpit.ToggleQueue" />
        <MenuButton Label="Planner inspector" OnClick="Cockpit.ToggleInspector" />
        <MenuButton Label="Analysis dock" OnClick="Cockpit.ToggleAnalysis" />
        <div class="my-1 border-t border-border"></div>
        <MenuButton Label="System appearance" OnClick="() => Theme.SetModeAsync(ThemeMode.System)" />
        <MenuButton Label="Light appearance" OnClick="() => Theme.SetModeAsync(ThemeMode.Light)" />
        <MenuButton Label="Dark appearance" OnClick="() => Theme.SetModeAsync(ThemeMode.Dark)" />
    </DesktopMenu>
    <DesktopMenu Label="Analyze">
        <MenuButton Label="Control overview" OnClick="() => Cockpit.OpenAnalysis(PlannerAnalysisView.ControlOverview)" />
        <MenuButton Label="Exceptions and capacity" OnClick="() => Cockpit.OpenAnalysis(PlannerAnalysisView.Exceptions)" />
        <MenuButton Label="Scenario comparison" OnClick="() => Cockpit.OpenAnalysis(PlannerAnalysisView.ScenarioComparison)" />
        <MenuButton Label="Traceability" OnClick="() => Cockpit.OpenAnalysis(PlannerAnalysisView.Traceability)" />
    </DesktopMenu>
    <DesktopMenu Label="Execute">
        <MenuButton Label="Execution monitor" OnClick="() => Cockpit.OpenAnalysis(PlannerAnalysisView.Execution)" />
        <MenuButton Label="Create recovery scenario" OnClick="() => Cockpit.RequestCommand(PlannerCockpitCommand.CreateRecoveryScenario)" />
        <MenuLink Href="/operate/work-orders" Label="Work order register" />
    </DesktopMenu>
    <DesktopMenu Label="Configure">
        <MenuLink Href="/plan/demand" Label="Demand and supply" />
        <MenuLink Href="/plan/inventory" Label="Inventory" />
        <MenuLink Href="/plan/master-data" Label="Master data" />
        <MenuLink Href="/plan/steelmaking" Label="Steelmaking and casting" />
        <MenuLink Href="/plan/rolling" Label="Rolling and finishing" />
        <MenuLink Href="/plan/material-flow" Label="Material flow" />
    </DesktopMenu>
    <DesktopMenu Label="Help">
        <div class="px-3 py-2 text-xs text-secondary">APS Planner v@(AppVersion)</div>
        @if (Updates.Status.Phase == UpdatePhase.Available)
        {
            <MenuButton Label="@($"Download update v{Updates.Status.AvailableVersion}")" OnClick="() => Updates.DownloadAsync()" />
        }
        else if (Updates.Status.Phase == UpdatePhase.Downloading)
        {
            <div class="px-3 py-2 text-xs text-secondary">Downloading update · @(Updates.Status.DownloadProgress ?? 0)%</div>
        }
        else if (Updates.Status.Phase == UpdatePhase.ReadyToRestart)
        {
            <MenuButton Label="@($"Restart to apply v{Updates.Status.AvailableVersion}")" OnClick="Updates.RestartAndApply" />
        }
        else if (Updates.Status.Phase == UpdatePhase.Failed)
        {
            <div class="px-3 py-2 text-xs text-danger">Update check failed@(Updates.Status.FailureCode is null ? "" : $" ({Updates.Status.FailureCode})")</div>
        }
    </DesktopMenu>
    <div class="ml-auto px-2 text-[11px] font-semibold tracking-wide text-muted">APS</div>
</header>

@code {
    private static readonly string AppVersion = System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "0.1.0";

    protected override void OnInitialized() => Updates.Changed += OnUpdatesChanged;

    private void OnUpdatesChanged() => _ = InvokeAsync(StateHasChanged);
    private void OpenWorkbench() => Navigation.NavigateTo("/");

    public void Dispose() => Updates.Changed -= OnUpdatesChanged;
}
