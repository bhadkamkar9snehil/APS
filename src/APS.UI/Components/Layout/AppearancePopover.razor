@implements IDisposable
@inject ThemeService Theme

<div class="relative border-t border-border p-2" @onkeydown="HandleKeyDown">
    @if (open)
    {
        <button type="button" class="fixed inset-0 z-30 cursor-default" aria-label="Close appearance settings" @onclick="Close"></button>
        <section class="absolute bottom-2 left-full z-40 ml-2 w-72 rounded-surface border border-border bg-surface-raised p-4 text-primary shadow-raised"
                 role="dialog" aria-label="Appearance settings">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <div class="text-xs font-semibold uppercase tracking-wide text-muted">Appearance</div>
                    <strong class="text-sm">Theme and accent</strong>
                </div>
                <button type="button" class="rounded-control p-1.5 text-muted hover:bg-surface-hover hover:text-primary" aria-label="Close appearance settings" @onclick="Close">&times;</button>
            </div>

            <div class="grid grid-cols-3 gap-1 rounded-control bg-surface-inset p-1" aria-label="Theme mode">
                @foreach (var option in ModeOptions)
                {
                    <button type="button"
                            class="rounded-control px-2 py-1.5 text-xs font-medium @(Theme.Preference.Mode == option.Mode ? "bg-surface-raised text-primary outline outline-1 outline-border-strong shadow-soft" : "text-secondary hover:bg-surface-hover")"
                            aria-pressed="@(Theme.Preference.Mode == option.Mode)"
                            @onclick="() => SelectModeAsync(option.Mode)">@option.Label</button>
                }
            </div>

            <div class="mt-4">
                <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">Accent</div>
                <div class="grid grid-cols-6 gap-2">
                    @foreach (var preset in Presets)
                    {
                        <button type="button"
                                class="grid h-8 w-8 place-items-center rounded-full @(Theme.Preference.Accent.Kind == preset.Kind ? "outline outline-2 outline-focus outline-offset-2" : "hover:outline hover:outline-1 hover:outline-border-strong")"
                                aria-label="@preset.Label accent" title="@preset.Label" aria-pressed="@(Theme.Preference.Accent.Kind == preset.Kind)"
                                @onclick="() => SelectPresetAsync(preset.Kind)">
                            <span class="h-6 w-6 rounded-full @preset.SwatchClass"></span>
                        </button>
                    }
                </div>
            </div>

            <div class="mt-4 rounded-control border border-border bg-surface p-3">
                <label class="text-xs font-semibold text-secondary" for="aps-custom-accent">Custom accent</label>
                <div class="mt-2 flex items-center gap-2">
                    <input id="aps-custom-accent" type="color" class="h-8 w-10 cursor-pointer rounded-control border border-border bg-surface p-0.5" @bind="customHex" />
                    <code class="flex-1 text-xs text-secondary">@customHex.ToUpperInvariant()</code>
                    <button type="button" class="rounded-control bg-accent px-2.5 py-1.5 text-xs font-semibold text-accent-foreground hover:bg-accent-hover" @onclick="ApplyCustomAsync">Apply</button>
                </div>
                @if (customError is not null)
                {
                    <p class="mt-2 text-xs text-danger" role="alert">@customError</p>
                }
                else
                {
                    <p class="mt-2 text-xs text-muted">APS derives hover, selection, foreground and focus states automatically.</p>
                }
            </div>

            <button type="button" class="mt-3 w-full rounded-control border border-border px-3 py-1.5 text-xs font-medium text-secondary hover:bg-surface-hover hover:text-primary" @onclick="ResetAsync">Reset to System + Amber</button>
        </section>
    }

    <button type="button"
            class="flex w-full items-center gap-2 rounded-control px-2.5 py-2 text-xs font-medium text-secondary hover:bg-surface-hover hover:text-primary"
            aria-label="Appearance" aria-expanded="@open" @onclick="Toggle">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-accent-soft text-accent" aria-hidden="true">◐</span>
        <span>Appearance</span>
        <span class="ml-auto text-muted">@Theme.Preference.Mode</span>
    </button>
</div>

@code {
    private bool open;
    private string customHex = "#7C3AED";
    private string? customError;

    private static readonly (ThemeAccentKind Kind, string Label, string SwatchClass)[] Presets =
    [
        (ThemeAccentKind.Amber, "Amber", "bg-[#a74708]"),
        (ThemeAccentKind.Violet, "Violet", "bg-[#6d35b5]"),
        (ThemeAccentKind.Forest, "Forest", "bg-[#1c7251]"),
        (ThemeAccentKind.Brick, "Brick", "bg-[#ad3f36]"),
        (ThemeAccentKind.Plum, "Plum", "bg-[#963664]"),
        (ThemeAccentKind.Olive, "Olive", "bg-[#60702f]")
    ];

    private static readonly (ThemeMode Mode, string Label)[] ModeOptions =
    [
        (ThemeMode.System, "System"),
        (ThemeMode.Light, "Light"),
        (ThemeMode.Dark, "Dark")
    ];

    protected override void OnInitialized()
    {
        Theme.Changed += OnThemeChanged;
        if (Theme.Preference.Accent.CustomHex is { } saved)
            customHex = saved;
    }

    private void Toggle() => open = !open;
    private void Close() => open = false;

    private async Task SelectModeAsync(ThemeMode mode) => await Theme.SetModeAsync(mode);

    private async Task SelectPresetAsync(ThemeAccentKind kind)
    {
        customError = null;
        await Theme.SetPresetAsync(kind);
    }

    private async Task ApplyCustomAsync()
    {
        customError = await Theme.SetCustomAccentAsync(customHex)
            ? null
            : "Choose a six-digit color value.";
    }

    private async Task ResetAsync()
    {
        customError = null;
        await Theme.ResetAsync();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            Close();
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
