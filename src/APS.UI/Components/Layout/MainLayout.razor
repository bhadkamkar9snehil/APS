@inherits LayoutComponentBase
@implements IDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject PlannerWorkspaceState WorkspaceState
@inject IConfiguration Configuration

<div class="flex h-screen w-screen overflow-hidden bg-slate-50 text-sm text-slate-900">
    <aside class="flex w-56 shrink-0 flex-col border-r border-slate-200 bg-white">
        <div class="flex items-center gap-2 border-b border-slate-200 px-4 py-3">
            <div class="flex h-7 w-7 items-center justify-center rounded bg-accent text-sm font-bold text-white">A</div>
            <div class="leading-tight">
                <div class="font-semibold">APS Planner</div>
                <div class="text-xs text-slate-500">Steel planning system</div>
            </div>
        </div>

        <nav class="flex-1 overflow-y-auto px-2 py-3">
            <NavItem Href="/" Match="NavLinkMatch.All" Label="Control Tower" />

            <NavGroup Title="PLAN">
                <NavItem Href="/plan/versions" Label="Plan Versions" />
                <NavItem Href="/plan/demand" Label="Demand & Supply" />
                <NavItem Href="/plan/campaigns" Label="Campaign Studio" />
                <NavItem Href="/plan/steelmaking" Label="Steelmaking & Casting" />
                <NavItem Href="/plan/rolling" Label="Rolling & Finishing" />
                <NavItem Href="/plan/schedule" Label="Finite Schedule" />
                <NavItem Href="/plan/inventory" Label="Inventory" />
                <NavItem Href="/plan/master-data" Label="Master Data" />
            </NavGroup>

            <NavGroup Title="OPERATE">
                <NavItem Href="/operate/work-orders" Label="Work Orders" />
                <NavItem Href="/operate/traceability" Label="Traceability" />
            </NavGroup>

            <NavGroup Title="COMPARE">
                <NavItem Href="/decide/compare" Label="Plan Compare" />
            </NavGroup>
        </nav>

        @if (demoModeEnabled)
        {
            <div class="border-t border-slate-200 px-4 py-3 text-xs">
                <div class="mb-1 font-semibold uppercase tracking-wide text-slate-400">Demo / reference</div>
                <NavLink href="/demo/planning" class="text-accent hover:underline">Planning Sandbox</NavLink>
            </div>
        }
    </aside>

    <section class="flex min-w-0 flex-1 flex-col">
        <PlanContextBar Plan="currentPlan" />
        <main class="flex-1 overflow-y-auto p-6">
            @if (backendUnavailable)
            {
                <div class="rounded border border-dashed border-slate-300 bg-white p-8 text-center">
                    <strong class="text-slate-700">Production planner workspace is unavailable</strong>
                    <p class="mt-1 text-sm text-slate-500">@backendUnavailableMessage</p>
                </div>
            }
            else
            {
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="rounded border border-dashed border-rose-300 bg-rose-50 p-8 text-center">
                            <strong class="text-rose-700">This page couldn't load</strong>
                            <p class="mt-1 text-sm text-rose-600">@ex.Message</p>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </main>
    </section>

    <ContextInspector />
</div>

@code {
    private PlanContextView? currentPlan;
    private bool demoModeEnabled;
    private bool backendUnavailable;
    private string? backendUnavailableMessage;

    protected override async Task OnInitializedAsync()
    {
        demoModeEnabled = Configuration.GetValue<bool>("APS:DemoModeEnabled");
        WorkspaceState.Changed += OnWorkspaceChanged;
        try
        {
            currentPlan = await PlannerQuery.GetCurrentPlanAsync();
            if (currentPlan is not null)
            {
                WorkspaceState.SetPlan(currentPlan.PlanVersionId, currentPlan.ParentPlanVersionId);
                WorkspaceState.SetWindow(currentPlan.HorizonStartUtc, currentPlan.HorizonEndUtc);
            }
        }
        catch (InvalidOperationException ex)
        {
            backendUnavailable = true;
            backendUnavailableMessage = ex.Message;
        }
    }

    private void OnWorkspaceChanged()
    {
        if (WorkspaceState.CurrentPlanVersionId.HasValue &&
            WorkspaceState.CurrentPlanVersionId != currentPlan?.PlanVersionId)
        {
            _ = InvokeAsync(LoadSelectedPlanAsync);
            return;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task LoadSelectedPlanAsync()
    {
        try
        {
            var planVersionId = WorkspaceState.CurrentPlanVersionId;
            currentPlan = planVersionId.HasValue
                ? await PlannerQuery.GetPlanContextAsync(planVersionId.Value)
                : await PlannerQuery.GetCurrentPlanAsync();

            if (currentPlan is not null)
            {
                WorkspaceState.SetWindow(currentPlan.HorizonStartUtc, currentPlan.HorizonEndUtc);
            }
        }
        catch (InvalidOperationException ex)
        {
            backendUnavailable = true;
            backendUnavailableMessage = ex.Message;
        }
        StateHasChanged();
    }

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}
