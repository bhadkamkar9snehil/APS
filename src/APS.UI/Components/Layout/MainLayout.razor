@inherits LayoutComponentBase
@implements IDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject PlannerWorkspaceState WorkspaceState
@inject NavigationManager Navigation
@inject ThemeService Theme

<div class="flex h-screen w-screen flex-col overflow-hidden bg-canvas text-sm text-primary">
    <DesktopMenuBar />
    <main class="min-h-0 flex-1 bg-canvas @(IsWorkbench ? "overflow-hidden" : "overflow-y-auto p-6")">
        <ErrorBoundary>
            <ChildContent>@Body</ChildContent>
            <ErrorContent Context="ex">
                <div class="rounded-surface border border-danger bg-danger-soft p-8 text-center">
                    <strong class="text-danger">This page couldn't load</strong>
                    <p class="mt-1 text-sm text-danger">@ex.Message</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private bool IsWorkbench
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
            return string.IsNullOrEmpty(path) || path.Equals("plan/schedule", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        var currentPlan = await PlannerQuery.GetCurrentPlanAsync();
        if (currentPlan is not null)
            WorkspaceState.SetPlan(currentPlan.PlanVersionId, currentPlan.ParentPlanVersionId);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Theme.InitializeAsync();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
