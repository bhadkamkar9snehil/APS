<header class="flex items-center justify-between gap-6 border-b border-border bg-surface-raised px-6 py-2.5">
    @if (Plan is null)
    {
        <div class="flex items-baseline gap-2">
            <span class="text-xs font-semibold uppercase tracking-wide text-muted">Plan context</span>
            <strong class="text-primary">No persisted plan</strong>
            <span class="text-xs text-muted">Reference sandbox remains available</span>
        </div>
    }
    else
    {
        <div class="flex items-center gap-3">
            <span class="text-xs font-semibold uppercase tracking-wide text-muted">Plan context</span>
            <strong>@Plan.VersionNumber</strong>
            <span class="rounded px-1.5 py-0.5 text-xs font-medium @StatusClass(Plan.Status)">@Plan.Status</span>
            @if (Plan.IsActive)
            {
                <span class="rounded bg-surface-inset px-1.5 py-0.5 text-xs font-medium text-secondary">ACTIVE</span>
            }
            @if (Plan.IsReleased)
            {
                <span class="rounded bg-surface-inset px-1.5 py-0.5 text-xs font-medium text-secondary">RELEASED</span>
            }
        </div>

        <div class="flex items-center gap-6 text-xs text-secondary">
            <div>
                <span class="text-muted">Horizon </span>
                <strong class="text-primary">@Plan.HorizonStartUtc.ToString("dd MMM HH:mm") &rarr; @Plan.HorizonEndUtc.ToString("dd MMM HH:mm")</strong>
            </div>
            <div>
                <span class="text-muted">Reference </span>
                <strong class="text-primary">@Plan.ReferenceTimeUtc.ToString("dd MMM HH:mm") UTC</strong>
            </div>
            <div>
                <span class="text-muted">Solver </span>
                <strong class="text-primary">@(Plan.SolverStatus ?? "—")</strong>
            </div>
            <div>
                <span class="text-muted">Trigger </span>
                <strong class="text-primary">@Plan.Trigger</strong>
            </div>
        </div>
    }
</header>

@code {
    [Parameter] public PlanContextView? Plan { get; set; }

    private static string StatusClass(APS.Domain.PlanVersionStatus status) => status switch
    {
        APS.Domain.PlanVersionStatus.Feasible => "bg-success-soft text-success",
        APS.Domain.PlanVersionStatus.Released => "bg-success-soft text-success",
        APS.Domain.PlanVersionStatus.Failed => "bg-danger-soft text-danger",
        APS.Domain.PlanVersionStatus.Superseded => "bg-surface-inset text-secondary",
        _ => "bg-surface-inset text-secondary"
    };
}
