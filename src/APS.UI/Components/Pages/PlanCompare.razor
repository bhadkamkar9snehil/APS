@page "/decide/compare"
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>What-if Analysis - APS</PageTitle>

<div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="mb-1 text-lg font-semibold">What-if Analysis</h1>
        <p class="text-sm text-secondary">Compare two immutable Plan Versions side by side: customer commitments, demand and sourcing, production structure, planning assumptions, schedule footprint, resource loading and every operation-level consequence.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <NavLink href="/plan/what-if" class="rounded border border-accent-border bg-accent-soft px-3 py-1.5 text-xs font-semibold text-accent">Create what-if</NavLink>
        <NavLink href="/plan/order-service" class="rounded border border-border-strong px-3 py-1.5 text-xs font-semibold hover:bg-surface-hover">Order service</NavLink>
        <NavLink href="/plan/constraints" class="rounded border border-border-strong px-3 py-1.5 text-xs font-semibold hover:bg-surface-hover">Planning controls</NavLink>
        <NavLink href="/plan/versions" class="rounded border border-border-strong px-3 py-1.5 text-xs font-semibold hover:bg-surface-hover">Plan Versions</NavLink>
    </div>
</div>

@if (loading)
{
    <p class="text-sm text-muted">Loading Plan Version history…</p>
}
else if (plans.Count < 2)
{
    <div class="rounded border border-dashed border-border-strong bg-surface-raised p-8 text-center">
        <strong class="text-primary">At least two Plan Versions are required</strong>
        <p class="mt-1 text-sm text-secondary">Create a what-if or replan to produce a child Plan Version that can be compared with its baseline.</p>
        <NavLink href="/plan/what-if" class="mt-3 inline-block text-sm font-semibold text-accent hover:underline">Create what-if scenario</NavLink>
    </div>
}
else
{
    <section class="mb-6 rounded border border-border bg-surface-raised p-4">
        <div class="flex flex-wrap items-end gap-3">
            <label class="flex min-w-60 flex-1 flex-col gap-1 text-sm">
                <span class="text-xs text-secondary">Baseline</span>
                <select class="rounded border border-border-strong px-2 py-1" @bind="baselineSelection">
                    @foreach (var plan in plans)
                    {
                        <option value="@plan.PlanVersionId">@plan.VersionNumber &middot; @plan.CreatedOnUtc.ToString("dd MMM HH:mm") &middot; @plan.Status</option>
                    }
                </select>
            </label>
            <span class="pb-1.5 text-muted" aria-hidden="true">&rarr;</span>
            <label class="flex min-w-60 flex-1 flex-col gap-1 text-sm">
                <span class="text-xs text-secondary">What-if / comparison plan</span>
                <select class="rounded border border-border-strong px-2 py-1" @bind="newSelection">
                    @foreach (var plan in plans)
                    {
                        <option value="@plan.PlanVersionId">@plan.VersionNumber &middot; @plan.CreatedOnUtc.ToString("dd MMM HH:mm") &middot; @plan.Status</option>
                    }
                </select>
            </label>
            <button type="button" class="rounded bg-accent px-3 py-1.5 text-sm font-medium text-accent-foreground disabled:cursor-not-allowed disabled:opacity-50" disabled="@(comparing || !CanCompare)" @onclick="CompareAsync">
                @(comparing ? "Comparing…" : "Compare")
            </button>
        </div>

        @if (!CanCompare)
        {
            <p class="mt-2 text-xs text-warning">Choose two different Plan Versions to compare.</p>
        }
        @if (!string.IsNullOrWhiteSpace(compareError))
        {
            <div role="alert" class="mt-3 rounded border border-border bg-danger-soft px-3 py-2 text-xs text-danger">@compareError</div>
        }
    </section>

    @if (comparing)
    {
        <p class="text-sm text-muted">Comparing persisted commitments, assumptions, demand, structure and operations…</p>
    }
    else if (comparison is not null)
    {
        <section class="mb-6 rounded-surface border border-border bg-surface-raised shadow-soft">
            <div class="border-b border-border px-4 py-3">
                <h2 class="text-sm font-semibold">Decision summary</h2>
                <p class="mt-0.5 text-xs text-secondary">A compact statement of how far the what-if moved away from its baseline before you inspect the detailed evidence below.</p>
            </div>
            <div class="grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-6">
                <StatTile Label="Changed operations" Value="@ChangedOperationCount.ToString()" />
                <StatTile Label="Added / removed" Value="@($"{comparison.AddedOperations} / {comparison.RemovedOperations}")" />
                <StatTile Label="Moved" Value="@comparison.MovedOperations.ToString()" />
                <StatTile Label="Resource changes" Value="@comparison.ResourceChangedOperations.ToString()" />
                <StatTile Label="Max start movement" Value="@($"{comparison.MaximumStartMovementMinutes} min")" />
                <StatTile Label="Captured control changes" Value="@AssumptionChanges.Count.ToString()" />
            </div>
            @if (comparison.BaselineSummary is not null && comparison.NewPlanSummary is not null)
            {
                <div class="grid gap-3 border-t border-border p-4 sm:grid-cols-2 lg:grid-cols-4">
                    <DeltaTile Label="Plan span" Baseline="@($"{comparison.BaselineSummary.SpanHours:0.0} h")" NewValue="@($"{comparison.NewPlanSummary.SpanHours:0.0} h")" Delta="@Signed(comparison.NewPlanSummary.SpanHours - comparison.BaselineSummary.SpanHours, "h")" />
                    <DeltaTile Label="Scheduled work content" Baseline="@($"{comparison.BaselineSummary.ScheduledHours:0.0} h")" NewValue="@($"{comparison.NewPlanSummary.ScheduledHours:0.0} h")" Delta="@Signed(comparison.NewPlanSummary.ScheduledHours - comparison.BaselineSummary.ScheduledHours, "h")" />
                    <DeltaTile Label="Resources used" Baseline="@comparison.BaselineSummary.ResourceCount.ToString()" NewValue="@comparison.NewPlanSummary.ResourceCount.ToString()" Delta="@Signed((long)comparison.NewPlanSummary.ResourceCount - comparison.BaselineSummary.ResourceCount, string.Empty)" />
                    <DeltaTile Label="Solver objective" Baseline="@(comparison.BaselineSummary.ObjectiveValue?.ToString("N0") ?? "—")" NewValue="@(comparison.NewPlanSummary.ObjectiveValue?.ToString("N0") ?? "—")" Delta="@ObjectiveDelta" />
                </div>
            }
        </section>

        @if (comparison.BaselineDemand is not null && comparison.NewPlanDemand is not null)
        {
            <div class="mb-6">
                <ScenarioDemandComparison Baseline="@comparison.BaselineDemand" NewPlan="@comparison.NewPlanDemand" />
            </div>
        }

        <div class="mb-6">
            <ScenarioOrderServiceComparison Items="@(comparison.OrderService ?? Array.Empty<PlanOrderServiceComparisonView>())" />
        </div>

        @if (comparison.BaselineSummary is not null && comparison.NewPlanSummary is not null)
        {
            <section class="mb-6">
                <div class="mb-2">
                    <h2 class="text-sm font-semibold">Schedule side by side</h2>
                    <p class="mt-0.5 text-xs text-secondary">Both timelines use the same time axis. This makes compression, expansion, resource reassignment and sequencing changes visually comparable instead of presenting two independently scaled charts.</p>
                </div>
                <ScenarioScheduleComparison BaselinePlan="@comparison.Baseline"
                                            NewPlan="@comparison.NewPlan"
                                            BaselineSummary="@comparison.BaselineSummary"
                                            NewPlanSummary="@comparison.NewPlanSummary"
                                            BaselineOperations="@(comparison.BaselineOperations ?? Array.Empty<PlanScenarioOperationView>())"
                                            NewPlanOperations="@(comparison.NewPlanOperations ?? Array.Empty<PlanScenarioOperationView>())" />
            </section>
        }

        var resourceLoads = comparison.ResourceLoads ?? Array.Empty<PlanResourceLoadComparisonView>();
        <section class="mb-6 rounded border border-border bg-surface-raised">
            <div class="flex flex-wrap items-start justify-between gap-3 border-b border-border px-4 py-3">
                <div>
                    <h2 class="text-sm font-semibold">Resource loading impact</h2>
                    <p class="mt-0.5 text-xs text-secondary">Scheduled work content by resource. This is operation-duration work content, not inferred utilization or capacity occupancy.</p>
                </div>
                <span class="rounded bg-surface-inset px-2 py-1 text-xs font-semibold">@resourceLoads.Count resource(s)</span>
            </div>
            @if (resourceLoads.Count == 0)
            {
                <div class="p-4 text-sm text-secondary">No persisted resource loading is available for these versions.</div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[760px] text-sm">
                        <thead><tr class="border-b border-border text-left text-xs text-muted"><th class="px-3 py-2 font-medium">Resource</th><th class="px-3 py-2 font-medium">Baseline</th><th class="px-3 py-2 font-medium">What-if</th><th class="px-3 py-2 font-medium text-right">Delta</th></tr></thead>
                        <tbody>
                            @foreach (var load in resourceLoads)
                            {
                                <tr class="border-b border-border last:border-0">
                                    <td class="px-3 py-2 font-semibold">@load.ResourceCode</td>
                                    <td class="px-3 py-2"><strong>@load.BaselineScheduledHours.ToString("0.0") h</strong><span class="ml-2 text-xs text-muted">@load.BaselineOperations ops</span></td>
                                    <td class="px-3 py-2"><strong>@load.NewScheduledHours.ToString("0.0") h</strong><span class="ml-2 text-xs text-muted">@load.NewOperations ops</span></td>
                                    <td class="px-3 py-2 text-right font-semibold @DeltaClass(load.ScheduledHoursDelta)">@Signed(load.ScheduledHoursDelta, "h")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="mb-6 rounded border border-border bg-surface-raised">
            <div class="flex flex-wrap items-start justify-between gap-3 border-b border-border px-4 py-3">
                <div>
                    <h2 class="text-sm font-semibold">Planning assumption changes</h2>
                    <p class="mt-0.5 text-xs text-secondary">Explains whether the schedule moved because planner policy changed, an operating scenario changed the effective plant, or both.</p>
                </div>
                <span class="rounded bg-surface-inset px-2 py-1 text-xs font-semibold @(AssumptionChanges.Count == 0 ? "text-success" : "text-warning")">@(AssumptionChanges.Count == 0 ? "No captured changes" : $"{AssumptionChanges.Count} change(s)")</span>
            </div>
            @if (AssumptionChanges.Count == 0)
            {
                <div class="p-4 text-sm text-secondary">The captured planning controls are the same between these versions, or both versions predate the relevant assumption snapshot.</div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[720px] text-sm">
                        <thead><tr class="border-b border-border text-left text-xs text-muted"><th class="px-3 py-2 font-medium">Area</th><th class="px-3 py-2 font-medium">Setting</th><th class="px-3 py-2 font-medium">Baseline</th><th class="px-3 py-2 font-medium">What-if</th></tr></thead>
                        <tbody>
                            @foreach (var change in AssumptionChanges)
                            {
                                <tr class="border-b border-border last:border-0"><td class="px-3 py-2"><span class="rounded bg-surface-inset px-1.5 py-0.5 text-xs">@change.Area</span></td><td class="px-3 py-2 font-medium">@change.Setting</td><td class="px-3 py-2 text-secondary">@change.BaselineValue</td><td class="px-3 py-2"><strong>@change.NewValue</strong></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="rounded border border-border bg-surface-raised">
            <div class="border-b border-border px-4 py-3">
                <h2 class="text-sm font-semibold">Operation-level consequences</h2>
                <p class="mt-0.5 text-xs text-secondary">Exact persisted changes after demand, constraints, execution state and planner controls were resolved.</p>
            </div>
            @if (comparison.Changes.Count == 0)
            {
                <div class="p-6 text-center text-sm text-muted">No persisted operation differences were found between these versions.</div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full min-w-[860px] text-sm">
                        <thead>
                            <tr class="border-b border-border text-left text-xs text-muted">
                                <th class="px-3 py-2 font-medium">Operation</th>
                                <th class="px-3 py-2 font-medium">Change</th>
                                <th class="px-3 py-2 font-medium">Resource</th>
                                <th class="px-3 py-2 font-medium">Start</th>
                                <th class="px-3 py-2 font-medium text-right">Movement</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var change in comparison.Changes)
                            {
                                <tr class="border-b border-border last:border-0 @(change.ChangeType == PlanOperationChangeType.Unchanged ? "text-muted" : "")">
                                    <td class="px-3 py-1.5"><strong>@change.PlanningKey</strong><div class="text-xs text-muted">@change.TaskType</div></td>
                                    <td class="px-3 py-1.5"><span class="rounded px-1.5 py-0.5 text-xs @ChangeClass(change.ChangeType)">@change.ChangeType</span></td>
                                    <td class="px-3 py-1.5 text-xs">@Display(change.BaselineResourceCode) &rarr; <strong>@Display(change.NewResourceCode)</strong></td>
                                    <td class="px-3 py-1.5 text-xs">@Time(change.BaselineStartUtc) &rarr; <strong>@Time(change.NewStartUtc)</strong></td>
                                    <td class="px-3 py-1.5 text-right font-medium @MovementClass(change.StartMovementMinutes)">@Movement(change.StartMovementMinutes)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
}

@code {
    private IReadOnlyCollection<PlanVersionListItemView> plans = Array.Empty<PlanVersionListItemView>();
    private PlanComparisonWorkspaceView? comparison;
    private string baselineSelection = string.Empty;
    private string newSelection = string.Empty;
    private bool loading = true;
    private bool comparing;
    private string? compareError;

    private bool CanCompare =>
        Guid.TryParse(baselineSelection, out var baselineId)
        && Guid.TryParse(newSelection, out var newId)
        && baselineId != newId;

    private IReadOnlyCollection<PlanAssumptionChangeView> AssumptionChanges =>
        comparison?.AssumptionChanges ?? Array.Empty<PlanAssumptionChangeView>();

    private int ChangedOperationCount =>
        comparison?.Changes.Count(x => x.ChangeType != PlanOperationChangeType.Unchanged) ?? 0;

    private string ObjectiveDelta
    {
        get
        {
            var baseline = comparison?.BaselineSummary?.ObjectiveValue;
            var next = comparison?.NewPlanSummary?.ObjectiveValue;
            return baseline.HasValue && next.HasValue ? Signed(next.Value - baseline.Value, string.Empty) : "—";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            plans = await PlannerQuery.GetRecentPlanVersionsAsync(40);
            var current = plans.FirstOrDefault(x => x.PlanVersionId == WorkspaceState.CurrentPlanVersionId)
                          ?? plans.FirstOrDefault(x => x.IsActive)
                          ?? plans.FirstOrDefault();
            var baseline = current?.ParentPlanVersionId.HasValue == true
                ? plans.FirstOrDefault(x => x.PlanVersionId == current.ParentPlanVersionId.Value)
                : plans.Skip(1).FirstOrDefault();
            if (current is not null) newSelection = current.PlanVersionId.ToString();
            if (baseline is not null) baselineSelection = baseline.PlanVersionId.ToString();
        }
        catch (Exception ex)
        {
            compareError = ex.Message;
        }
        finally
        {
            loading = false;
        }

        if (CanCompare)
            await CompareAsync();
    }

    private async Task CompareAsync()
    {
        if (!CanCompare)
        {
            comparison = null;
            return;
        }

        var baselineId = Guid.Parse(baselineSelection);
        var newId = Guid.Parse(newSelection);
        comparing = true;
        compareError = null;
        StateHasChanged();
        try
        {
            comparison = await PlannerQuery.GetPlanComparisonAsync(baselineId, newId);
            if (comparison is null)
                compareError = "Comparison data is not available for the selected Plan Versions.";
        }
        catch (Exception ex)
        {
            comparison = null;
            compareError = ex.Message;
        }
        finally
        {
            comparing = false;
            StateHasChanged();
        }
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string Time(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM HH:mm") : "—";
    private static string Movement(int minutes) => minutes == 0 ? "—" : minutes > 0 ? $"+{minutes}m" : $"{minutes}m";
    private static string MovementClass(int minutes) => minutes > 0 ? "text-warning" : minutes < 0 ? "text-info" : "text-muted";
    private static string DeltaClass(double value) => value > 0.001 ? "text-warning" : value < -0.001 ? "text-info" : "text-muted";
    private static string Signed(double value, string unit) => $"{(value > 0 ? "+" : string.Empty)}{value:0.0}{unit}";
    private static string Signed(long value, string unit) => $"{(value > 0 ? "+" : string.Empty)}{value:N0}{unit}";
    private static string ChangeClass(PlanOperationChangeType change) => change switch
    {
        PlanOperationChangeType.Added => "bg-success-soft text-success",
        PlanOperationChangeType.Removed => "bg-danger-soft text-danger",
        PlanOperationChangeType.Moved => "bg-warning-soft text-warning",
        PlanOperationChangeType.ResourceChanged or PlanOperationChangeType.MovedAndResourceChanged => "bg-accent-soft text-accent",
        _ => "bg-surface-inset text-secondary"
    };
}
