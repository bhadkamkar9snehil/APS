@page "/decide/compare"
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>Plan Compare - APS</PageTitle>

<h1 class="mb-1 text-lg font-semibold">Plan Compare</h1>
<p class="mb-6 text-sm text-slate-500">See exactly what moved, changed resource, appeared or disappeared between two persisted schedules.</p>

@if (loading)
{
    <p class="text-sm text-slate-400">Loading Plan Version history…</p>
}
else if (plans.Count < 2)
{
    <div class="rounded border border-dashed border-slate-300 bg-white p-8 text-center">
        <strong class="text-slate-700">At least two Plan Versions are required</strong>
        <p class="mt-1 text-sm text-slate-500">Replanning or scenario runs create the history needed for comparison.</p>
    </div>
}
else
{
    <div class="mb-6 flex items-end gap-3 rounded border border-slate-200 bg-white p-4">
        <label class="flex flex-col gap-1 text-sm">
            <span class="text-xs text-slate-500">Baseline</span>
            <select class="rounded border border-slate-300 px-2 py-1" @bind="baselineSelection">
                @foreach (var plan in plans)
                {
                    <option value="@plan.PlanVersionId">@plan.VersionNumber &middot; @plan.CreatedOnUtc.ToString("dd MMM HH:mm")</option>
                }
            </select>
        </label>
        <span class="pb-1.5 text-slate-300">&rarr;</span>
        <label class="flex flex-col gap-1 text-sm">
            <span class="text-xs text-slate-500">New plan</span>
            <select class="rounded border border-slate-300 px-2 py-1" @bind="newSelection">
                @foreach (var plan in plans)
                {
                    <option value="@plan.PlanVersionId">@plan.VersionNumber &middot; @plan.CreatedOnUtc.ToString("dd MMM HH:mm")</option>
                }
            </select>
        </label>
        <button type="button" class="rounded bg-accent px-3 py-1.5 text-sm font-medium text-white" @onclick="CompareAsync">Compare</button>
    </div>

    @if (comparing)
    {
        <p class="text-sm text-slate-400">Comparing persisted operations…</p>
    }
    else if (comparison is not null)
    {
        <div class="mb-6 grid grid-cols-7 gap-3">
            <div class="rounded border border-slate-200 bg-white p-3">
                <div class="text-xs text-slate-400">BASELINE</div>
                <strong>@comparison.Baseline.VersionNumber</strong>
                <div class="text-xs text-slate-400">@comparison.Baseline.CreatedOnUtc.ToString("dd MMM HH:mm") &middot; @comparison.Baseline.Status</div>
            </div>
            <StatTile Label="Added" Value="@comparison.AddedOperations.ToString()" />
            <StatTile Label="Removed" Value="@comparison.RemovedOperations.ToString()" />
            <StatTile Label="Moved" Value="@comparison.MovedOperations.ToString()" />
            <StatTile Label="Resource changes" Value="@comparison.ResourceChangedOperations.ToString()" />
            <StatTile Label="Max movement" Value="@($"{comparison.MaximumStartMovementMinutes} min")" />
            <div class="rounded border border-slate-200 bg-white p-3">
                <div class="text-xs text-slate-400">NEW</div>
                <strong>@comparison.NewPlan.VersionNumber</strong>
                <div class="text-xs text-slate-400">@comparison.NewPlan.CreatedOnUtc.ToString("dd MMM HH:mm") &middot; @comparison.NewPlan.Status</div>
            </div>
        </div>

        <section class="rounded border border-slate-200 bg-white">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-slate-200 text-left text-xs text-slate-400">
                        <th class="px-3 py-2 font-medium">Operation</th>
                        <th class="px-3 py-2 font-medium">Change</th>
                        <th class="px-3 py-2 font-medium">Resource</th>
                        <th class="px-3 py-2 font-medium">Start</th>
                        <th class="px-3 py-2 font-medium text-right">Movement</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var change in comparison.Changes)
                    {
                        <tr class="border-b border-slate-100 last:border-0 @(change.ChangeType == PlanOperationChangeType.Unchanged ? "text-slate-400" : "")">
                            <td class="px-3 py-1.5"><strong>@change.PlanningKey</strong><div class="text-xs text-slate-400">@change.TaskType</div></td>
                            <td class="px-3 py-1.5"><span class="rounded px-1.5 py-0.5 text-xs @ChangeClass(change.ChangeType)">@change.ChangeType</span></td>
                            <td class="px-3 py-1.5 text-xs">@Display(change.BaselineResourceCode) &rarr; <strong>@Display(change.NewResourceCode)</strong></td>
                            <td class="px-3 py-1.5 text-xs">@Time(change.BaselineStartUtc) &rarr; <strong>@Time(change.NewStartUtc)</strong></td>
                            <td class="px-3 py-1.5 text-right font-medium @MovementClass(change.StartMovementMinutes)">@Movement(change.StartMovementMinutes)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private IReadOnlyCollection<PlanVersionListItemView> plans = Array.Empty<PlanVersionListItemView>();
    private PlanComparisonWorkspaceView? comparison;
    private string baselineSelection = string.Empty;
    private string newSelection = string.Empty;
    private bool loading = true;
    private bool comparing;

    protected override async Task OnInitializedAsync()
    {
        plans = await PlannerQuery.GetRecentPlanVersionsAsync(40);
        var current = plans.FirstOrDefault(x => x.PlanVersionId == WorkspaceState.CurrentPlanVersionId)
                      ?? plans.FirstOrDefault(x => x.IsActive)
                      ?? plans.FirstOrDefault();
        var baseline = current?.ParentPlanVersionId.HasValue == true
            ? plans.FirstOrDefault(x => x.PlanVersionId == current.ParentPlanVersionId.Value)
            : plans.Skip(1).FirstOrDefault();
        if (current is not null) newSelection = current.PlanVersionId.ToString();
        if (baseline is not null) baselineSelection = baseline.PlanVersionId.ToString();
        loading = false;
        if (!string.IsNullOrWhiteSpace(baselineSelection) && !string.IsNullOrWhiteSpace(newSelection))
            await CompareAsync();
    }

    private async Task CompareAsync()
    {
        if (!Guid.TryParse(baselineSelection, out var baselineId) ||
            !Guid.TryParse(newSelection, out var newId) ||
            baselineId == newId)
        {
            comparison = null;
            return;
        }

        comparing = true;
        comparison = await PlannerQuery.GetPlanComparisonAsync(baselineId, newId);
        comparing = false;
    }

    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string Time(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM HH:mm") : "—";
    private static string Movement(int minutes) => minutes == 0 ? "—" : minutes > 0 ? $"+{minutes}m" : $"{minutes}m";
    private static string MovementClass(int minutes) => minutes > 0 ? "text-amber-600" : minutes < 0 ? "text-sky-600" : "text-slate-400";
    private static string ChangeClass(PlanOperationChangeType change) => change switch
    {
        PlanOperationChangeType.Added => "bg-emerald-100 text-emerald-700",
        PlanOperationChangeType.Removed => "bg-rose-100 text-rose-700",
        PlanOperationChangeType.Moved => "bg-amber-100 text-amber-700",
        PlanOperationChangeType.ResourceChanged => "bg-violet-100 text-violet-700",
        PlanOperationChangeType.MovedAndResourceChanged => "bg-violet-100 text-violet-700",
        _ => "bg-slate-100 text-slate-500"
    };
}
