    private string TransitionOwner(TransitionRule x) => x.ResourceId.HasValue ? ResourceCode(x.ResourceId.Value) : x.ProcessUnitType?.ToString() ?? x.ResourceType?.ToString() ?? "Plant default";
    private string ResourceCode(Guid id) => masters?.Resources.FirstOrDefault(x => x.Id == id)?.Code ?? id.ToString("N")[..8];
    private string GradeCode(Guid id) => masters?.EffectiveSteelGrades.FirstOrDefault(x => x.Id == id)?.GradeCode ?? id.ToString("N")[..8];
    private static string Envelope(decimal? minimum, decimal? target, decimal? maximum) => minimum.HasValue || target.HasValue || maximum.HasValue ? $"{minimum?.ToString("0.#") ?? "—"} / {target?.ToString("0.#") ?? "—"} / {maximum?.ToString("0.#") ?? "—"}" : "—";

    private static string? ValidateEnvelope(bool ownerSelected, ProcessOperationType operation, decimal? entryMin, decimal? entryTarget, decimal? entryMax, decimal? exitMin, decimal? exitTarget, decimal? exitMax, int? maxHold)
    {
        if (!ownerSelected) return "Select a steel grade.";
        if (operation == ProcessOperationType.Unknown) return "Select a real process operation.";
        var entryError = ValidateOrdered("entry", entryMin, entryTarget, entryMax); if (entryError is not null) return entryError;
        var exitError = ValidateOrdered("exit", exitMin, exitTarget, exitMax); if (exitError is not null) return exitError;
        if (maxHold is < 0) return "Maximum holding time cannot be negative.";
        return null;
    }

    private static string? ValidateResourceThermal(ResourceTemperatureCapability x)
    {
        if (x.ResourceId == Guid.Empty) return "Select a physical resource.";
        if (x.ProcessOperationType == ProcessOperationType.Unknown) return "Select a real process operation.";
        var rangeError = ValidateOrdered("resource exit", x.MinimumAchievableExitTemperatureC, x.NominalExitTemperatureC, x.MaximumAchievableExitTemperatureC); if (rangeError is not null) return rangeError;
        if (x.MaximumHeatingRateCPerMinute is < 0m) return "Heating rate cannot be negative.";
        if (x.NominalTemperatureLossCPerMinuteWhileHolding is < 0m) return "Holding temperature loss cannot be negative.";
        return null;
    }

    private static string? ValidateOrdered(string label, decimal? minimum, decimal? target, decimal? maximum)
    {
        if (minimum.HasValue && target.HasValue && target < minimum) return $"{label} target must be at least the minimum.";
        if (target.HasValue && maximum.HasValue && maximum < target) return $"{label} maximum must be at least the target.";
        if (minimum.HasValue && maximum.HasValue && maximum < minimum) return $"{label} maximum must be at least the minimum.";
        return null;
    }

    private static TransitionRule CloneTransition(TransitionRule x) => new()
    {
        Id = x.Id,
        ResourceId = x.ResourceId,
        ResourceType = x.ResourceType,
        ProcessUnitType = x.ProcessUnitType,
        ProcessOperationType = x.ProcessOperationType,
        Scope = x.Scope,
        Dimension = x.Dimension,
        FromCode = x.FromCode,
        ToCode = x.ToCode,
        IsAllowed = x.IsAllowed,
        RequiresSequenceBreak = x.RequiresSequenceBreak,
        Penalty = x.Penalty,
        TransitionTime = x.TransitionTime,
        ReasonCode = x.ReasonCode
    };

    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private void SetMessage(string value, bool error) { message = value; messageIsError = error; }
