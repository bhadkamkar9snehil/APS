@page "/plan/steelmaking"
@implements IDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject IHeatExecutionService HeatExecution
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>Steelmaking & Casting - APS</PageTitle>

<h1 class="mb-1 text-lg font-semibold">Steelmaking &amp; Casting</h1>
<p class="mb-6 text-sm text-secondary">Heat-by-heat route through physical steelmaking units, CCM sequence and strand output.</p>

@if (loading)
{
    <p class="text-sm text-muted">Loading heat route…</p>
}
else if (view is null)
{
    <div class="rounded border border-dashed border-border-strong bg-surface-raised p-8 text-center text-primary">No persisted physical plan.</div>
}
else
{
    <div class="mb-6 grid grid-cols-4 gap-3">
        <StatTile Label="Heats" Value="@view.HeatCount.ToString()" />
        <StatTile Label="Cast sequences" Value="@view.CastSequenceCount.ToString()" />
        <StatTile Label="Planned heat input" Value="@($"{view.PlannedHeatInputMt:0.##} MT")" />
        <StatTile Label="Planned cast output" Value="@($"{view.PlannedCastOutputMt:0.##} MT")" />
    </div>

    <div class="grid grid-cols-[280px_1fr] gap-4">
        <aside class="rounded border border-border bg-surface-raised">
            <div class="border-b border-border px-3 py-2 text-xs font-semibold uppercase tracking-wide text-muted">Heat register</div>
            <div class="max-h-[70vh] overflow-y-auto">
                @foreach (var heat in view.Heats)
                {
                    <button type="button" class="block w-full border-b border-border px-3 py-2 text-left last:border-0 hover:bg-surface-hover @(selectedHeat?.CampaignHeatId == heat.CampaignHeatId ? "bg-accent-soft" : "")" @onclick="() => SelectHeat(heat)">
                        <strong>@heat.CampaignNumber / H@(heat.HeatSequenceNumber.ToString("00"))</strong>
                        <div class="text-xs text-muted">@heat.GradeCode &middot; @heat.PlannedQuantityMt.ToString("0.#") MT</div>
                        <div class="text-xs text-muted">@(heat.CasterResourceCode ?? "CCM unresolved") &middot; seq @(heat.CastSequenceNumber?.ToString() ?? "—")</div>
                    </button>
                }
            </div>
        </aside>

        <section>
            @if (selectedHeat is null)
            {
                <div class="rounded border border-dashed border-border-strong bg-surface-raised p-8 text-center text-muted">Select a heat</div>
            }
            else
            {
                <div class="mb-4 rounded border border-border bg-surface-raised p-4">
                    <div class="flex items-start justify-between">
                        <div>
                            <h2 class="text-base font-semibold">@selectedHeat.CampaignNumber / H@(selectedHeat.HeatSequenceNumber.ToString("00"))</h2>
                            <p class="text-sm text-secondary">@selectedHeat.GradeCode &middot; @selectedHeat.PlannedQuantityMt.ToString("0.##") MT</p>
                        </div>
                        <div class="flex gap-4 text-right text-sm">
                            <div><div class="text-xs text-muted">Cast sequence</div><strong>@(selectedHeat.CastSequenceNumber?.ToString() ?? "—")</strong></div>
                            <div><div class="text-xs text-muted">CCM</div><strong>@(selectedHeat.CasterResourceCode ?? "—")</strong></div>
                            <div><div class="text-xs text-muted">Tundish</div><strong>@(selectedHeat.TundishNumber?.ToString() ?? "—")</strong></div>
                        </div>
                    </div>
                </div>

                @if (CastOperation(selectedHeat) is { } castOperation)
                {
                    <section class="mb-4 rounded border border-border bg-surface-raised p-4">
                        <div class="mb-3 flex items-center justify-between">
                            <h3 class="text-sm font-semibold">Record heat actual</h3>
                            @if (!string.IsNullOrWhiteSpace(heatActualError))
                            {
                                <span class="text-xs text-danger">@heatActualError</span>
                            }
                        </div>
                        <div class="grid grid-cols-5 gap-3 text-sm">
                            <label class="flex flex-col gap-1">
                                <span class="text-xs text-secondary">Status</span>
                                <select class="rounded border border-border-strong px-2 py-1" @bind="heatActualStatus">
                                    @foreach (var status in Enum.GetValues<HeatExecutionStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </select>
                            </label>
                            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Actual start</span><input type="datetime-local" class="rounded border border-border-strong px-2 py-1" @bind="heatActualStart" /></label>
                            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Actual end</span><input type="datetime-local" class="rounded border border-border-strong px-2 py-1" @bind="heatActualEnd" /></label>
                            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Actual qty (MT)</span><input type="number" class="rounded border border-border-strong px-2 py-1" @bind="heatActualQuantity" /></label>
                            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Comment</span><input class="rounded border border-border-strong px-2 py-1" @bind="heatActualComment" /></label>
                        </div>
                        <button type="button" class="mt-3 rounded bg-accent px-3 py-1.5 text-sm font-medium text-accent-foreground disabled:opacity-50" disabled="@savingHeatActual" @onclick="() => SaveHeatActualAsync(castOperation.PlanningKey)">
                            @(savingHeatActual ? "Saving…" : "Save heat actual")
                        </button>
                    </section>
                }

                <section class="mb-4 rounded border border-border bg-surface-raised p-4">
                    <h3 class="mb-3 text-sm font-semibold">Heat train &mdash; scheduled physical operations</h3>
                    @if (selectedHeat.Operations.Count == 0)
                    {
                        <p class="text-sm text-muted">No persisted operation snapshots for this heat.</p>
                    }
                    else
                    {
                        var orderedOps = selectedHeat.Operations.OrderBy(x => x.StartUtc).ToArray();
                        <div class="flex flex-wrap items-center gap-2">
                            @for (var i = 0; i < orderedOps.Length; i++)
                            {
                                var operation = orderedOps[i];
                                <button type="button" class="rounded border border-border px-3 py-2 text-left text-xs hover:bg-surface-hover" @onclick="() => SelectOperation(operation)">
                                    <div class="text-muted">@operation.ProcessOperationType</div>
                                    <strong>@operation.ResourceCode</strong>
                                    <div class="text-muted">@operation.StartUtc.ToString("dd MMM HH:mm") &rarr; @operation.EndUtc.ToString("HH:mm")</div>
                                    <div class="text-muted">@Duration(operation)</div>
                                </button>
                                @if (i < orderedOps.Length - 1)
                                {
                                    <div class="flex flex-col items-center text-xs text-muted">
                                        <span>@QueueGap(orderedOps[i], orderedOps[i + 1])</span>
                                        <span>&rarr;</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                </section>

                <section class="rounded border border-border bg-surface-raised p-4">
                    <h3 class="mb-3 text-sm font-semibold">CCM output &mdash; planned strand material (@selectedHeat.StrandOutputs.Select(x => x.StrandNumber).Distinct().Count() strands)</h3>
                    @if (selectedHeat.StrandOutputs.Count == 0)
                    {
                        <p class="text-sm text-muted">No strand-output snapshot for this heat.</p>
                    }
                    else
                    {
                        <div class="grid grid-cols-4 gap-2">
                            @foreach (var strandGroup in selectedHeat.StrandOutputs.GroupBy(x => x.StrandNumber).OrderBy(x => x.Key))
                            {
                                <button type="button" class="rounded border border-border p-2 text-left text-xs hover:bg-surface-hover" @onclick="() => SelectStrand(strandGroup.First())">
                                    <div class="text-muted">STRAND <strong class="text-primary">@strandGroup.Key</strong></div>
                                    <div class="mt-1 text-sm font-semibold">@strandGroup.Sum(x => x.QuantityMt).ToString("0.##") MT</div>
                                    <div class="text-muted">@strandGroup.First().CrossSectionCode</div>
                                    <div class="text-muted">available @Available(strandGroup.Max(x => x.AvailableOnUtc))</div>
                                </button>
                            }
                        </div>
                    }
                </section>
            }
        </section>
    </div>
}

@code {
    private SteelmakingCastingWorkspaceView? view;
    private HeatProcessView? selectedHeat;
    private bool loading = true;

    private HeatExecutionStatus heatActualStatus = HeatExecutionStatus.Running;
    private DateTime? heatActualStart;
    private DateTime? heatActualEnd;
    private decimal? heatActualQuantity;
    private string? heatActualComment;
    private bool savingHeatActual;
    private string? heatActualError;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.Changed += OnWorkspaceChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        view = await PlannerQuery.GetSteelmakingCastingAsync(WorkspaceState.CurrentPlanVersionId);
        selectedHeat = view?.Heats.FirstOrDefault();
        loading = false;
        StateHasChanged();
    }

    private void OnWorkspaceChanged()
    {
        if (view is not null && WorkspaceState.CurrentPlanVersionId != view.Plan.PlanVersionId)
            _ = InvokeAsync(LoadAsync);
    }

    private void SelectHeat(HeatProcessView heat)
    {
        selectedHeat = heat;
        heatActualStatus = HeatExecutionStatus.Running;
        heatActualStart = null;
        heatActualEnd = null;
        heatActualQuantity = null;
        heatActualComment = null;
        heatActualError = null;
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Heat, heat.CampaignHeatId, $"{heat.CampaignNumber}/H{heat.HeatSequenceNumber:00}"));
    }

    private async Task SaveHeatActualAsync(string planningKey)
    {
        if (view is null) return;
        savingHeatActual = true;
        heatActualError = null;
        StateHasChanged();
        try
        {
            await HeatExecution.ApplyAsync(new HeatExecutionUpdate(
                view.Plan.PlanVersionId, planningKey, heatActualStatus, DateTime.UtcNow, ExecutionUpdateSource.Manual,
                ActualStartUtc: heatActualStart, ActualEndUtc: heatActualEnd, ActualQuantityMt: heatActualQuantity,
                Comment: heatActualComment));
            await LoadAsync();
            selectedHeat = view?.Heats.FirstOrDefault(x => x.CampaignHeatId == selectedHeat!.CampaignHeatId);
        }
        catch (Exception ex)
        {
            heatActualError = ex.Message;
        }
        finally
        {
            savingHeatActual = false;
            StateHasChanged();
        }
    }

    private void SelectOperation(ScheduledProcessOperationView operation) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Operation, operation.OperationSnapshotId, operation.PlanningKey));

    private void SelectStrand(StrandOutputView strand) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.MaterialSupply, strand.MaterialUnitSnapshotId, strand.PlanningKey));

    private static ScheduledProcessOperationView? CastOperation(HeatProcessView heat) =>
        heat.Operations.FirstOrDefault(x => x.ProcessOperationType == ProcessOperationType.Ccm);

    private static string Duration(ScheduledProcessOperationView op) => $"{Math.Max(0, (op.EndUtc - op.StartUtc).TotalMinutes):0} min";
    private static string QueueGap(ScheduledProcessOperationView left, ScheduledProcessOperationView right) => $"{Math.Max(0, (right.StartUtc - left.EndUtc).TotalMinutes):0}m";
    private static string Available(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM HH:mm") : "—";

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}
