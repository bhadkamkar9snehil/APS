@page "/plan/steelmaking"
@implements IDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>Steelmaking & Casting - APS</PageTitle>

<div class="planner-page physical-workspace">
    <header class="workspace-titlebar">
        <div>
            <span class="workspace-eyebrow">PLAN / STEELMAKING</span>
            <h1>Steelmaking & Casting</h1>
            <p>Heat-by-heat route through physical steelmaking units, CCM sequence and strand output.</p>
        </div>
        @if (view is not null)
        {
            <div class="workspace-basis"><span>Basis</span><strong>@view.Plan.VersionNumber snapshot</strong></div>
        }
    </header>

    @if (loading)
    {
        <div class="planner-empty-state"><strong>Loading heat route…</strong></div>
    }
    else if (view is null)
    {
        <div class="planner-empty-state planner-empty-state-major"><strong>No persisted physical plan</strong></div>
    }
    else
    {
        <section class="campaign-summary-strip physical-summary-strip">
            <div><span>Heats</span><strong>@view.HeatCount</strong></div>
            <div><span>Cast sequences</span><strong>@view.CastSequenceCount</strong></div>
            <div><span>Planned heat input</span><strong>@view.PlannedHeatInputMt.ToString("0.##") MT</strong></div>
            <div><span>Planned cast output</span><strong>@view.PlannedCastOutputMt.ToString("0.##") MT</strong></div>
            <div><span>Yield view</span><strong>Plan snapshot</strong></div>
        </section>

        <div class="physical-layout">
            <aside class="heat-register">
                <div class="campaign-register-head">
                    <span class="planner-section-label">HEAT REGISTER</span>
                    <strong>@view.HeatCount planned heats</strong>
                </div>
                <div class="heat-register-list">
                    @foreach (var heat in view.Heats)
                    {
                        <button type="button" class="heat-register-row @(selectedHeat?.CampaignHeatId == heat.CampaignHeatId ? "is-selected" : null)" @onclick="() => SelectHeat(heat)">
                            <div><strong>@heat.CampaignNumber / H@heat.HeatSequenceNumber.ToString("00")</strong><span>@heat.GradeCode</span></div>
                            <div><strong>@heat.PlannedQuantityMt.ToString("0.#")</strong><span>MT</span></div>
                            <small>@(heat.CasterResourceCode ?? "CCM unresolved") · seq @(heat.CastSequenceNumber?.ToString() ?? "—")</small>
                        </button>
                    }
                </div>
            </aside>

            <section class="physical-canvas">
                @if (selectedHeat is null)
                {
                    <div class="planner-empty-state"><strong>Select a heat</strong></div>
                }
                else
                {
                    <div class="physical-heat-head">
                        <div>
                            <span class="planner-section-label">SELECTED HEAT</span>
                            <h2>@selectedHeat.CampaignNumber / H@selectedHeat.HeatSequenceNumber.ToString("00")</h2>
                            <p>@selectedHeat.GradeCode · @selectedHeat.PlannedQuantityMt.ToString("0.##") MT</p>
                        </div>
                        <div class="physical-heat-meta">
                            <div><span>Cast sequence</span><strong>@(selectedHeat.CastSequenceNumber?.ToString() ?? "—")</strong></div>
                            <div><span>CCM</span><strong>@(selectedHeat.CasterResourceCode ?? "—")</strong></div>
                            <div><span>Tundish</span><strong>@(selectedHeat.TundishNumber?.ToString() ?? "—")</strong></div>
                        </div>
                    </div>

                    <section class="campaign-section process-train-section">
                        <div class="campaign-section-head">
                            <div><span class="planner-section-label">HEAT TRAIN</span><h3>Scheduled physical operations</h3></div>
                        </div>
                        @if (selectedHeat.Operations.Count == 0)
                        {
                            <p class="aps-empty">No persisted operation snapshots for this heat.</p>
                        }
                        else
                        {
                            var orderedOps = selectedHeat.Operations.OrderBy(x => x.StartUtc).ToArray();
                            <div class="process-train">
                                @for (var i = 0; i < orderedOps.Length; i++)
                                {
                                    var operation = orderedOps[i];
                                    <button type="button" class="process-train-node process-@ProcessClass(operation.ProcessOperationType)" @onclick="() => SelectOperation(operation)">
                                        <span>@operation.ProcessOperationType</span>
                                        <strong>@operation.ResourceCode</strong>
                                        <small>@operation.StartUtc.ToString("dd MMM HH:mm") → @operation.EndUtc.ToString("HH:mm")</small>
                                        <em>@Duration(operation)</em>
                                    </button>
                                    @if (i < orderedOps.Length - 1)
                                    {
                                        <div class="process-train-link">
                                            <span>@QueueGap(orderedOps[i], orderedOps[i + 1])</span>
                                            <i>→</i>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </section>

                    <section class="campaign-section strand-section">
                        <div class="campaign-section-head">
                            <div><span class="planner-section-label">CCM OUTPUT</span><h3>Planned strand material</h3></div>
                            <span class="planner-basis-badge">@(selectedHeat.StrandOutputs.Select(x => x.StrandNumber).Distinct().Count()) STRANDS</span>
                        </div>
                        @if (selectedHeat.StrandOutputs.Count == 0)
                        {
                            <p class="aps-empty">No strand-output snapshot for this heat.</p>
                        }
                        else
                        {
                            <div class="strand-bank">
                                @foreach (var strandGroup in selectedHeat.StrandOutputs.GroupBy(x => x.StrandNumber).OrderBy(x => x.Key))
                                {
                                    <button type="button" class="strand-channel" @onclick="() => SelectStrand(strandGroup.First())">
                                        <div class="strand-channel-head"><span>STRAND</span><strong>@strandGroup.Key</strong></div>
                                        <div class="strand-flow-line"></div>
                                        <div class="strand-channel-qty">@strandGroup.Sum(x => x.QuantityMt).ToString("0.##") MT</div>
                                        <small>@strandGroup.First().CrossSectionCode</small>
                                        <small>available @Available(strandGroup.Max(x => x.AvailableOnUtc))</small>
                                    </button>
                                }
                            </div>
                        }
                    </section>
                }
            </section>
        </div>
    }
</div>

@code {
    private SteelmakingCastingWorkspaceView? view;
    private HeatProcessView? selectedHeat;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.Changed += OnWorkspaceChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        view = await PlannerQuery.GetSteelmakingCastingAsync(WorkspaceState.CurrentPlanVersionId);
        selectedHeat = view?.Heats.FirstOrDefault();
        loading = false;
        StateHasChanged();
    }

    private void OnWorkspaceChanged()
    {
        if (view is not null && WorkspaceState.CurrentPlanVersionId != view.Plan.PlanVersionId)
            _ = InvokeAsync(LoadAsync);
    }

    private void SelectHeat(HeatProcessView heat)
    {
        selectedHeat = heat;
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Heat, heat.CampaignHeatId, $"{heat.CampaignNumber}/H{heat.HeatSequenceNumber:00}"));
    }

    private void SelectOperation(ScheduledProcessOperationView operation) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Operation, operation.OperationSnapshotId, operation.PlanningKey));

    private void SelectStrand(StrandOutputView strand) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.MaterialSupply, strand.MaterialUnitSnapshotId, strand.PlanningKey));

    private static string ProcessClass(ProcessOperationType type) => type.ToString().ToLowerInvariant();
    private static string Duration(ScheduledProcessOperationView op) => $"{Math.Max(0, (op.EndUtc - op.StartUtc).TotalMinutes):0} min";
    private static string QueueGap(ScheduledProcessOperationView left, ScheduledProcessOperationView right) => $"{Math.Max(0, (right.StartUtc - left.EndUtc).TotalMinutes):0}m";
    private static string Available(DateTime? value) => value.HasValue ? value.Value.ToString("dd MMM HH:mm") : "—";

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}
