@page "/demo/planning"
@using APS.UI.Sample
@using APS.UI.Components.Shared
@inject IPlanningEngine PlanningEngine
@inject IPlanReleaseBuilder ReleaseBuilder
@inject IConfiguration Configuration

<PageTitle>Planning Sandbox - APS Demo</PageTitle>

<div class="rounded border border-border bg-surface-raised p-4">
    <h2 class="text-base font-semibold">Planning Sandbox</h2>
    <p class="mt-1 text-sm text-secondary">
        Explicit demo/reference surface. Runs the real campaign &rarr; structure &rarr; CP-SAT calculation kernel
        (<code>IPlanningEngine</code>) against a built-in long-products sample scenario.
        It does not create authoritative production Plan Versions or Work Orders.
    </p>

    @if (!demoModeEnabled)
    {
        <div class="mt-3 rounded bg-danger-soft px-3 py-2 text-sm text-danger">
            Demo mode is disabled. Set <code>APS:DemoModeEnabled=true</code> explicitly to use this sandbox.
        </div>
    }

    <div class="mt-4 flex flex-wrap items-end gap-4 text-sm">
        <label class="flex flex-col gap-1">
            <span class="text-xs text-secondary">Horizon (days)</span>
            <input type="number" min="1" max="21" class="w-24 rounded border border-border-strong px-2 py-1" @bind="horizonDays" disabled="@(!demoModeEnabled)" />
        </label>
        <label class="flex flex-col gap-1">
            <span class="text-xs text-secondary">Max solver seconds</span>
            <input type="number" min="1" max="60" class="w-28 rounded border border-border-strong px-2 py-1" @bind="maxSolverSeconds" disabled="@(!demoModeEnabled)" />
        </label>
        <label class="flex items-center gap-2">
            <input type="checkbox" @bind="includeInfeasibleOrder" disabled="@(!demoModeEnabled)" />
            <span>Include an order with no eligible resource</span>
        </label>
        <button type="button" class="rounded bg-accent px-3 py-1.5 font-medium text-accent-foreground disabled:opacity-50" @onclick="RunPlanningAsync" disabled="@(!demoModeEnabled || isRunning)">
            @(isRunning ? "Running…" : "Run Demo Planning")
        </button>
        @if (result is not null)
        {
            <button type="button" class="rounded border border-border-strong px-3 py-1.5 font-medium disabled:opacity-50" @onclick="BuildReleaseAsync" disabled="@(!demoModeEnabled || isRunning || !result.IsFeasible)">
                Build Demo Release
            </button>
        }
    </div>

    @if (isRunning)
    {
        <p class="mt-3 text-sm text-muted">Solving with CP-SAT&hellip;</p>
    }
    @if (errorMessage is not null)
    {
        <div class="mt-3 rounded bg-danger-soft px-3 py-2 text-sm text-danger">@errorMessage</div>
    }
</div>

@if (result is not null)
{
    <div class="mt-4 rounded border border-border bg-surface-raised p-4">
        <h2 class="flex items-center gap-2 text-base font-semibold">
            Demo plan result
            <span class="rounded px-1.5 py-0.5 text-xs @(result.IsFeasible ? "bg-success-soft text-success" : "bg-danger-soft text-danger")">
                @(result.IsFeasible ? "Feasible" : "Infeasible")
            </span>
        </h2>
        <p class="mt-1 text-xs text-muted">
            Solver status @result.Schedule.SolverStatus &middot; objective @result.Schedule.ObjectiveValue
            &middot; generated @result.CreatedOnUtc.ToString("u")
        </p>

        @{
            var allIssues = result.ProductionStructure.Issues.Concat(result.Schedule.Issues).ToArray();
        }
        @if (allIssues.Length > 0)
        {
            <h3 class="mt-3 mb-1 text-sm font-semibold">Issues</h3>
            <ul class="space-y-1 text-sm">
                @foreach (var issue in allIssues)
                {
                    <li class="rounded px-2 py-1 @(issue.Severity == PlanningIssueSeverity.Error ? "bg-danger-soft text-danger" : "bg-warning-soft text-warning")">
                        <strong>@issue.Code</strong> &mdash; @issue.Message
                    </li>
                }
            </ul>
        }
    </div>

    <div class="mt-4 rounded border border-border bg-surface-raised p-4">
        <h3 class="mb-2 text-sm font-semibold">Campaigns</h3>
        @if (result.CampaignPlan.Campaigns.Count == 0)
        {
            <p class="text-sm text-muted">No campaigns were formed.</p>
        }
        else
        {
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b border-border text-left text-xs text-muted">
                        <th class="py-1 font-medium">Campaign</th><th class="py-1 font-medium">Seq. class</th><th class="py-1 font-medium">Caster section</th>
                        <th class="py-1 font-medium text-right">Planned MT</th><th class="py-1 font-medium text-right">Fresh MT</th><th class="py-1 font-medium text-right">From inventory MT</th>
                        <th class="py-1 font-medium text-right">Heats</th><th class="py-1 font-medium">Required by</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var campaign in result.CampaignPlan.Campaigns.OrderBy(c => c.CampaignNumber))
                    {
                        <tr class="border-b border-border last:border-0">
                            <td class="py-1">@campaign.CampaignNumber</td>
                            <td class="py-1">@campaign.GradeSequenceClassCode</td>
                            <td class="py-1">@campaign.CasterSectionCode</td>
                            <td class="py-1 text-right">@campaign.PlannedQuantityMt.ToString("0.#")</td>
                            <td class="py-1 text-right">@campaign.FreshSteelRequirementMt.ToString("0.#")</td>
                            <td class="py-1 text-right">@campaign.ExistingIntermediateInventoryMt.ToString("0.#")</td>
                            <td class="py-1 text-right">@campaign.Heats.Count</td>
                            <td class="py-1">@campaign.RequiredDate.ToString("MMM dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        @if (result.CampaignPlan.FullyCoveredByFinishedGoods.Count > 0)
        {
            <p class="mt-2 text-xs text-muted">
                Fully covered from finished-goods inventory (no new campaign needed):
                @string.Join(", ", result.CampaignPlan.FullyCoveredByFinishedGoods.Select(p => p.ProductionOrderNumber))
            </p>
        }
    </div>

    <div class="mt-4 rounded border border-border bg-surface-raised p-4">
        <h3 class="mb-2 text-sm font-semibold">Cast sequences</h3>
        @if (result.ProductionStructure.CastSequences.Count == 0)
        {
            <p class="text-sm text-muted">No cast sequences were built.</p>
        }
        else
        {
            <table class="w-full text-sm">
                <thead><tr class="border-b border-border text-left text-xs text-muted"><th class="py-1 font-medium">Caster</th><th class="py-1 font-medium">Seq #</th><th class="py-1 font-medium">Heats</th><th class="py-1 font-medium">Grades</th><th class="py-1 font-medium text-right">Total MT</th></tr></thead>
                <tbody>
                    @foreach (var sequence in result.ProductionStructure.CastSequences.OrderBy(s => ResourceName(s.CasterResourceId)).ThenBy(s => s.SequenceNumber))
                    {
                        <tr class="border-b border-border last:border-0">
                            <td class="py-1">@ResourceName(sequence.CasterResourceId)</td>
                            <td class="py-1">@sequence.SequenceNumber</td>
                            <td class="py-1">@sequence.Heats.Count</td>
                            <td class="py-1">@string.Join(", ", sequence.Heats.Select(h => h.CampaignHeat.GradeCode).Distinct())</td>
                            <td class="py-1 text-right">@sequence.Heats.Sum(h => h.CampaignHeat.PlannedQuantityMt).ToString("0.#")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="mt-4 rounded border border-border bg-surface-raised p-4">
        <h3 class="mb-2 text-sm font-semibold">Rolling plans</h3>
        @if (result.ProductionStructure.RollingPlans.Count == 0)
        {
            <p class="text-sm text-muted">No rolling plans were built.</p>
        }
        else
        {
            <table class="w-full text-sm">
                <thead><tr class="border-b border-border text-left text-xs text-muted"><th class="py-1 font-medium">Mill</th><th class="py-1 font-medium">Grade</th><th class="py-1 font-medium">Input &rarr; Output</th><th class="py-1 font-medium text-right">Planned MT</th><th class="py-1 font-medium text-right">Fresh MT</th><th class="py-1 font-medium text-right">Inventory MT</th></tr></thead>
                <tbody>
                    @foreach (var plan in result.ProductionStructure.RollingPlans.OrderBy(p => ResourceName(p.RollingMillResourceId)).ThenBy(p => p.SequenceNumber))
                    {
                        <tr class="border-b border-border last:border-0">
                            <td class="py-1">@ResourceName(plan.RollingMillResourceId)</td>
                            <td class="py-1">@plan.GradeCode</td>
                            <td class="py-1">@plan.InputCrossSectionCode &rarr; @plan.OutputCrossSectionCode</td>
                            <td class="py-1 text-right">@plan.PlannedQuantityMt.ToString("0.#")</td>
                            <td class="py-1 text-right">@plan.FreshSteelQuantityMt.ToString("0.#")</td>
                            <td class="py-1 text-right">@plan.ExistingIntermediateInventoryMt.ToString("0.#")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <div class="mt-4 rounded border border-border bg-surface-raised p-4">
        <h3 class="mb-2 text-sm font-semibold">Finite schedule</h3>
        @if (!result.IsFeasible || result.Schedule.Assignments.Count == 0)
        {
            <p class="text-sm text-muted">No feasible schedule to display.</p>
        }
        else
        {
            <ScheduleGantt HorizonStartUtc="horizonStartUtc" HorizonEndUtc="horizonStartUtc.AddDays(horizonDays)" Rows="ganttRows" />
        }
    </div>
}

@if (release is not null)
{
    <div class="mt-4 rounded border border-border bg-surface-raised p-4">
        <h3 class="mb-2 text-sm font-semibold">Demo work orders</h3>
        <table class="w-full text-sm">
            <thead><tr class="border-b border-border text-left text-xs text-muted"><th class="py-1 font-medium">WO number</th><th class="py-1 font-medium">Type</th><th class="py-1 font-medium">Resource</th><th class="py-1 font-medium">Grade</th><th class="py-1 font-medium">Section</th><th class="py-1 font-medium text-right">Planned MT</th><th class="py-1 font-medium">Start</th><th class="py-1 font-medium">End</th><th class="py-1 font-medium">Sources</th></tr></thead>
            <tbody>
                @foreach (var wo in release.WorkOrders.OrderBy(w => w.PlannedStart))
                {
                    <tr class="border-b border-border last:border-0">
                        <td class="py-1">@wo.WorkOrderNumber</td>
                        <td class="py-1">@wo.WorkOrderType</td>
                        <td class="py-1">@(wo.ResourceId is Guid rid ? ResourceName(rid) : "multiple")</td>
                        <td class="py-1">@wo.GradeCode</td>
                        <td class="py-1">@wo.CrossSectionCode</td>
                        <td class="py-1 text-right">@wo.PlannedQuantityMt.ToString("0.#")</td>
                        <td class="py-1">@(wo.PlannedStart?.ToString("MMM dd HH:mm") ?? "-")</td>
                        <td class="py-1">@(wo.PlannedEnd?.ToString("MMM dd HH:mm") ?? "-")</td>
                        <td class="py-1">@string.Join(", ", wo.Allocations.Select(a => a.ProductionOrder?.ProductionOrderNumber).Where(n => n is not null))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private int horizonDays = 7;
    private int maxSolverSeconds = 10;
    private bool includeInfeasibleOrder;
    private bool isRunning;
    private string? errorMessage;

    private DateTime horizonStartUtc = DateTime.UtcNow.Date.AddHours(6);
    private APS.Application.PlanningRunRequest? lastRequest;
    private APS.Application.PlanningRunResult? result;
    private APS.Application.PlanRelease? release;
    private Dictionary<Guid, Resource> resourcesById = new();
    private IReadOnlyList<ScheduleGantt.GanttRow> ganttRows = Array.Empty<ScheduleGantt.GanttRow>();

    private bool demoModeEnabled => Configuration.GetValue<bool>("APS:DemoModeEnabled");

    private string ResourceName(Guid? resourceId) =>
        resourceId is Guid id && resourcesById.TryGetValue(id, out var resource) ? resource.Name : "-";

    private async Task RunPlanningAsync()
    {
        if (!demoModeEnabled)
        {
            errorMessage = "Demo planning is disabled by configuration.";
            return;
        }

        isRunning = true;
        errorMessage = null;
        result = null;
        release = null;
        StateHasChanged();

        try
        {
            horizonStartUtc = DateTime.UtcNow.Date.AddHours(6);
            var request = SteelPlantSampleScenario.BuildRequest(horizonStartUtc, horizonDays, maxSolverSeconds, includeInfeasibleOrder);
            lastRequest = request with { ExecutionMode = PlanningExecutionMode.Compatibility };
            resourcesById = lastRequest.Resources.ToDictionary(r => r.Id);

            result = await Task.Run(() => PlanningEngine.Run(lastRequest));
            ganttRows = BuildGanttRows(result, lastRequest);
        }
        catch (Exception ex)
        {
            errorMessage = $"Demo planning run failed: {ex.Message}";
        }
        finally
        {
            isRunning = false;
        }
    }

    private async Task BuildReleaseAsync()
    {
        if (!demoModeEnabled)
        {
            errorMessage = "Demo release is disabled by configuration.";
            return;
        }
        if (result is null || lastRequest is null) return;

        isRunning = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var releaseRequest = new APS.Application.PlanReleaseBuildRequest(
                result.PlanVersionId,
                result.CampaignPlan.Campaigns,
                result.ProductionStructure,
                result.Schedule);
            release = await Task.Run(() => ReleaseBuilder.Build(releaseRequest));
        }
        catch (Exception ex)
        {
            errorMessage = $"Demo release build failed: {ex.Message}";
        }
        finally
        {
            isRunning = false;
        }
    }

    private IReadOnlyList<ScheduleGantt.GanttRow> BuildGanttRows(APS.Application.PlanningRunResult planResult, APS.Application.PlanningRunRequest request)
    {
        if (!planResult.IsFeasible) return Array.Empty<ScheduleGantt.GanttRow>();

        var taskById = planResult.ProductionStructure.SchedulingTasks.ToDictionary(t => t.TaskId);
        var assignmentsByResource = planResult.Schedule.Assignments
            .Where(a => taskById.ContainsKey(a.TaskId))
            .GroupBy(a => a.ResourceId);
        var downtimeByResource = request.ResourceCalendars
            .Where(c => !c.IsAvailable)
            .GroupBy(c => c.ResourceId);

        var rows = new List<ScheduleGantt.GanttRow>();
        foreach (var resource in request.Resources.Where(r => r.ResourceType is ResourceType.Caster or ResourceType.RollingMill).OrderBy(r => r.ResourceType).ThenBy(r => r.Code))
        {
            var blocks = assignmentsByResource.FirstOrDefault(g => g.Key == resource.Id)?
                .OrderBy(a => a.StartUtc)
                .Select(a =>
                {
                    var task = taskById[a.TaskId];
                    return new ScheduleGantt.GanttBlock($"{task.Name} ({task.QuantityMt:0.#}mt)", task.TaskType, a.StartUtc, a.EndUtc);
                })
                .ToArray() ?? Array.Empty<ScheduleGantt.GanttBlock>();

            var downtime = downtimeByResource.FirstOrDefault(g => g.Key == resource.Id)?
                .Select(c => new ScheduleGantt.GanttDowntime(c.ReasonCode ?? "unavailable", c.Start, c.End))
                .ToArray() ?? Array.Empty<ScheduleGantt.GanttDowntime>();

            rows.Add(new ScheduleGantt.GanttRow(resource.Name, blocks, downtime));
        }

        return rows;
    }
}
