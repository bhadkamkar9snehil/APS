@page "/plan/versions"
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject IPlanningLifecycleService Lifecycle
@inject IPersistedPlanReleaseService ReleaseService
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>Plan Versions - APS</PageTitle>

<div class="mb-5 flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="mb-1 text-lg font-semibold">Plan Versions</h1>
        <p class="text-sm text-secondary">Create a scenario, inspect the schedule and consequences, approve it, then release work orders.</p>
    </div>
    <div class="flex flex-wrap items-center gap-1 text-xs text-muted" aria-label="Plan lifecycle">
        <span class="rounded bg-surface-inset px-2 py-1">1. Controls</span><span aria-hidden="true">→</span>
        <span class="rounded bg-surface-inset px-2 py-1">2. Calculate</span><span aria-hidden="true">→</span>
        <span class="rounded bg-surface-inset px-2 py-1">3. Review</span><span aria-hidden="true">→</span>
        <span class="rounded bg-surface-inset px-2 py-1">4. Approve</span><span aria-hidden="true">→</span>
        <span class="rounded bg-surface-inset px-2 py-1">5. Release</span>
    </div>
</div>

<div class="grid grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_380px]">
    <section class="min-w-0 rounded border border-border bg-surface-raised">
        <div class="border-b border-border px-3 py-2 text-xs font-semibold uppercase tracking-wide text-muted">Plan Version register</div>
        @if (loading)
        {
            <p class="p-4 text-sm text-muted">Loading…</p>
        }
        else if (plans.Count == 0)
        {
            <div class="p-6 text-center">
                <strong class="text-sm text-primary">No Plan Versions yet</strong>
                <p class="mt-1 text-sm text-secondary">Set the planning controls and horizon, then Calculate the first scenario.</p>
                <NavLink href="/plan/constraints" class="mt-3 inline-block text-xs font-semibold text-accent hover:underline">Review planning controls</NavLink>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <Table Headers="@(new[] {"Version", "Status", "Trigger", "Created", "Horizon", ""})">
                    @foreach (var plan in plans)
                    {
                        <tr class="cursor-pointer border-b border-border last:border-0 hover:bg-surface-hover @(selectedPlanId == plan.PlanVersionId ? "bg-accent-soft" : "")" @onclick="() => SelectPlanAsync(plan.PlanVersionId)">
                            <td class="px-3 py-1.5"><strong>@plan.VersionNumber</strong></td>
                            <td class="px-3 py-1.5"><span class="rounded px-1.5 py-0.5 text-xs @StatusClass(plan.Status)">@plan.Status</span></td>
                            <td class="px-3 py-1.5">@plan.Trigger</td>
                            <td class="whitespace-nowrap px-3 py-1.5 text-xs text-secondary">@plan.CreatedOnUtc.ToString("dd MMM HH:mm")</td>
                            <td class="whitespace-nowrap px-3 py-1.5 text-xs text-secondary">@plan.HorizonStartUtc.ToString("dd MMM") &rarr; @plan.HorizonEndUtc.ToString("dd MMM")</td>
                            <td class="whitespace-nowrap px-3 py-1.5">
                                @if (plan.IsActive) { <span class="rounded bg-surface-inset px-1.5 py-0.5 text-xs">ACTIVE</span> }
                                @if (plan.IsReleased) { <span class="ml-1 rounded bg-success-soft px-1.5 py-0.5 text-xs text-success">RELEASED</span> }
                            </td>
                        </tr>
                    }
                </Table>
            </div>
        }
    </section>

    <aside class="space-y-4">
        <section class="rounded border border-border bg-surface-raised p-4">
            <div class="mb-3 flex items-start justify-between gap-3">
                <div>
                    <h2 class="text-sm font-semibold">Planning controls</h2>
                    <p class="mt-0.5 text-xs text-secondary">Session profile used by the next Calculate/Replan.</p>
                </div>
                <NavLink href="/plan/constraints" class="shrink-0 text-xs font-semibold text-accent hover:underline">Edit controls</NavLink>
            </div>
            <div class="grid grid-cols-2 gap-x-3 gap-y-2 text-xs">
                <div><div class="text-muted">Plant scenario</div><strong>@ConstraintScenarioLabel</strong></div>
                <div><div class="text-muted">Heat envelope</div><strong>@Constraints.MinimumHeatSizeMt.ToString("0.##")–@Constraints.MaximumHeatSizeMt.ToString("0.##") MT</strong></div>
                <div><div class="text-muted">Campaign cap</div><strong>@Constraints.MaximumCampaignQuantityMt.ToString("0.##") MT</strong></div>
                <div><div class="text-muted">Time fence</div><strong>@Constraints.FrozenMinutes m + @Constraints.SlushyMinutes m</strong></div>
                <div><div class="text-muted">Solver effort</div><strong>@Constraints.MaxSolverSeconds s</strong></div>
                <div><div class="text-muted">Commitment policy</div><strong>@(Constraints.UseAssignmentCommitmentPolicy ? "Enabled" : "Default flexible")</strong></div>
            </div>
        </section>

        <section class="rounded border border-border bg-surface-raised p-4">
            <h2 class="mb-1 text-sm font-semibold">Calculate new scenario</h2>
            <p class="mb-3 text-xs text-secondary">Uses current demand, authoritative master data and the planning controls above. Nothing is released automatically.</p>
            <div class="space-y-2 text-sm">
                <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Horizon start</span><input type="date" class="rounded border border-border-strong px-2 py-1" @bind="horizonStart" /></label>
                <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Horizon end</span><input type="date" class="rounded border border-border-strong px-2 py-1" @bind="horizonEnd" /></label>
            </div>

            @if (!string.IsNullOrWhiteSpace(CalculationInputError))
            {
                <div role="alert" class="mt-3 rounded border border-border bg-surface-inset px-3 py-2 text-xs text-danger">@CalculationInputError</div>
            }

            @if (!string.IsNullOrWhiteSpace(calculateError))
            {
                <div role="alert" class="mt-3 rounded border border-border bg-danger-soft px-3 py-2 text-xs text-danger">
                    <strong class="block">Plan could not be calculated</strong>
                    <span class="mt-1 block break-words">@calculateError</span>
                    <div class="mt-2 flex flex-wrap gap-3">
                        @if (CalculateErrorLooksLikeMasterData)
                        {
                            <NavLink href="/plan/master-data" class="font-semibold underline">Review technical master data</NavLink>
                        }
                        <NavLink href="/plan/constraints" class="font-semibold underline">Review planning controls</NavLink>
                    </div>
                </div>
            }

            <button type="button"
                    class="mt-3 w-full rounded bg-accent px-3 py-1.5 text-sm font-medium text-accent-foreground disabled:cursor-not-allowed disabled:opacity-50"
                    disabled="@(calculating || !string.IsNullOrWhiteSpace(CalculationInputError))"
                    @onclick="CalculateAsync">
                @(calculating ? "Calculating…" : "Calculate scenario")
            </button>
        </section>

        @if (selectedPlanId is { } selected)
        {
            <section class="rounded border border-border bg-surface-raised p-4">
                <h2 class="mb-1 text-sm font-semibold">Review selected plan</h2>
                <p class="mb-3 text-xs text-secondary">Review schedule, demand consequences and assumptions before approval. Actions apply only to the selected immutable Plan Version.</p>

                <div class="mb-3 grid grid-cols-2 gap-2 text-xs">
                    <NavLink href="/" class="rounded-control border border-border px-2 py-2 text-center font-semibold hover:bg-surface-hover">Planning Workbench</NavLink>
                    <NavLink href="/plan/demand" class="rounded-control border border-border px-2 py-2 text-center font-semibold hover:bg-surface-hover">Demand &amp; delivery</NavLink>
                    <NavLink href="/control-tower" class="rounded-control border border-border px-2 py-2 text-center font-semibold hover:bg-surface-hover">Capacity / Control Tower</NavLink>
                    <NavLink href="/decide/compare" class="rounded-control border border-border px-2 py-2 text-center font-semibold hover:bg-surface-hover">Compare versions</NavLink>
                </div>

                @if (!string.IsNullOrWhiteSpace(actionError))
                {
                    <div role="alert" class="mb-3 rounded border border-border bg-danger-soft px-3 py-2 text-xs text-danger">@actionError</div>
                }
                @if (!string.IsNullOrWhiteSpace(actionSuccess))
                {
                    <div role="status" class="mb-3 rounded border border-border bg-success-soft px-3 py-2 text-xs text-success">@actionSuccess</div>
                }

                @if (readiness is not null)
                {
                    <div class="mb-3 rounded border border-border bg-surface-inset p-2 text-xs">
                        <div class="flex items-center justify-between gap-2">
                            <span class="font-semibold">Release readiness</span>
                            <span class="font-semibold @(readiness.IsReleaseReady ? "text-success" : "text-danger")">@(readiness.IsReleaseReady ? "READY" : "BLOCKED")</span>
                        </div>
                        @if (readiness.Findings.Count > 0)
                        {
                            <div class="mt-2 space-y-1 text-secondary">
                                @foreach (var finding in readiness.Findings.Take(6))
                                {
                                    <p><strong>@finding.Code:</strong> @finding.Message</p>
                                }
                                @if (readiness.Findings.Count > 6) { <p>+ @(readiness.Findings.Count - 6) more blocking finding(s)</p> }
                            </div>
                        }
                    </div>
                }

                <div class="flex flex-col gap-2">
                    <button type="button" class="rounded border border-border-strong px-3 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" disabled="@(acting || !string.IsNullOrWhiteSpace(CalculationInputError))" @onclick="() => ReplanAsync(selected)">
                        Replan with current controls
                    </button>
                    <button type="button" class="rounded border border-border-strong px-3 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" disabled="@(acting || readiness is null || readiness.Status != PlanVersionStatus.Feasible || !readiness.IsReleaseReady)" @onclick="() => ApproveAsync(selected)">
                        Approve selected plan
                    </button>
                    <button type="button" class="rounded bg-accent px-3 py-1.5 text-sm font-medium text-accent-foreground disabled:cursor-not-allowed disabled:opacity-50" disabled="@(acting || readiness?.Status != PlanVersionStatus.Approved)" @onclick="() => ReleaseAsync(selected)">
                        Release work orders
                    </button>
                </div>

                @if (readiness?.Status == PlanVersionStatus.Released)
                {
                    <NavLink href="/operate/work-orders" class="mt-3 block text-center text-xs font-semibold text-accent hover:underline">Open released work orders →</NavLink>
                }
            </section>
        }
    </aside>
</div>

@code {
    private PlannerConstraintState Constraints => WorkspaceState.Constraints;
    private IReadOnlyCollection<PlanVersionListItemView> plans = Array.Empty<PlanVersionListItemView>();
    private bool loading = true;
    private Guid? selectedPlanId;
    private PlanReleaseReadiness? readiness;

    private DateTime horizonStart = DateTime.UtcNow.Date;
    private DateTime horizonEnd = DateTime.UtcNow.Date.AddDays(7);
    private bool calculating;
    private string? calculateError;

    private bool acting;
    private string? actionError;
    private string? actionSuccess;

    private string ConstraintScenarioLabel => string.IsNullOrWhiteSpace(Constraints.ScenarioCode) ? "Configured baseline" : Constraints.ScenarioCode!;

    private string? CalculationInputError
    {
        get
        {
            var errors = Constraints.Validate(horizonStart, horizonEnd);
            return errors.Count == 0 ? null : string.Join(" ", errors);
        }
    }

    private bool CalculateErrorLooksLikeMasterData =>
        calculateError?.Contains("route", StringComparison.OrdinalIgnoreCase) == true
        || calculateError?.Contains("master", StringComparison.OrdinalIgnoreCase) == true
        || calculateError?.Contains("configuration", StringComparison.OrdinalIgnoreCase) == true
        || calculateError?.Contains("cross-section", StringComparison.OrdinalIgnoreCase) == true
        || calculateError?.Contains("cross section", StringComparison.OrdinalIgnoreCase) == true
        || calculateError?.Contains("resource", StringComparison.OrdinalIgnoreCase) == true
        || calculateError?.Contains("capability", StringComparison.OrdinalIgnoreCase) == true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        plans = await PlannerQuery.GetRecentPlanVersionsAsync(40);
        loading = false;
        StateHasChanged();
    }

    private async Task SelectPlanAsync(Guid planVersionId)
    {
        selectedPlanId = planVersionId;
        actionError = null;
        actionSuccess = null;
        WorkspaceState.SetPlan(planVersionId);
        try
        {
            readiness = await ReleaseService.GetReadinessAsync(planVersionId);
        }
        catch (Exception ex)
        {
            readiness = null;
            actionError = ex.Message;
        }
        StateHasChanged();
    }

    private async Task CalculateAsync()
    {
        if (!string.IsNullOrWhiteSpace(CalculationInputError)) return;

        calculating = true;
        calculateError = null;
        StateHasChanged();
        try
        {
            var outcome = await Lifecycle.CalculateAsync(Constraints.BuildCalculationRequest(horizonStart, horizonEnd));
            await LoadAsync();
            await SelectPlanAsync(outcome.Version.PlanVersionId);
            actionSuccess = outcome.Plan.IsFeasible
                ? $"Scenario {outcome.Version.VersionNumber} created. Review it before approval."
                : $"Scenario {outcome.Version.VersionNumber} was persisted as infeasible for diagnosis.";
        }
        catch (Exception ex)
        {
            calculateError = ex.Message;
        }
        finally
        {
            calculating = false;
            StateHasChanged();
        }
    }

    private async Task ReplanAsync(Guid baselinePlanVersionId)
    {
        if (!string.IsNullOrWhiteSpace(CalculationInputError)) return;

        acting = true;
        actionError = null;
        actionSuccess = null;
        StateHasChanged();
        try
        {
            var request = Constraints.BuildCalculationRequest(horizonStart, horizonEnd);
            var outcome = await Lifecycle.ReplanAsync(
                baselinePlanVersionId,
                new PlanningRecalculationRequest(
                    request,
                    Constraints.BuildTimeFencePolicy(),
                    Trigger: PlanTriggerType.Manual,
                    Reason: "Planner replan using current planning controls"));
            await LoadAsync();
            await SelectPlanAsync(outcome.Version.PlanVersionId);
            actionSuccess = $"Replanned as {outcome.Version.VersionNumber}. Review the child plan against its baseline before approval.";
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            acting = false;
            StateHasChanged();
        }
    }

    private async Task ApproveAsync(Guid planVersionId)
    {
        acting = true;
        actionError = null;
        actionSuccess = null;
        StateHasChanged();
        try
        {
            readiness = await ReleaseService.ApproveAsync(planVersionId);
            await LoadAsync();
            actionSuccess = "Plan approved for release.";
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
            readiness = await TryGetReadinessAsync(planVersionId);
        }
        finally
        {
            acting = false;
            StateHasChanged();
        }
    }

    private async Task ReleaseAsync(Guid planVersionId)
    {
        acting = true;
        actionError = null;
        actionSuccess = null;
        StateHasChanged();
        try
        {
            var release = await ReleaseService.ReleaseAsync(planVersionId);
            await LoadAsync();
            readiness = await TryGetReadinessAsync(planVersionId);
            actionSuccess = $"Released {release.WorkOrders.Count} Work Order(s). Continue in the execution workspace.";
        }
        catch (Exception ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            acting = false;
            StateHasChanged();
        }
    }

    private async Task<PlanReleaseReadiness?> TryGetReadinessAsync(Guid planVersionId)
    {
        try { return await ReleaseService.GetReadinessAsync(planVersionId); }
        catch { return null; }
    }

    private static string StatusClass(PlanVersionStatus status) => status switch
    {
        PlanVersionStatus.Feasible or PlanVersionStatus.Approved or PlanVersionStatus.Released => "bg-success-soft text-success",
        PlanVersionStatus.Failed => "bg-danger-soft text-danger",
        PlanVersionStatus.Superseded => "bg-surface-inset text-muted",
        _ => "bg-surface-inset text-secondary"
    };
}
