@page "/plan/order-service"
@using APS.Application
@using APS.Domain
@inject IOrderServicePolicyService Policies

<PageTitle>Order Service - APS</PageTitle>

<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
    <div class="max-w-3xl">
        <h1 class="mb-1 text-lg font-semibold">Order Service</h1>
        <p class="text-sm text-secondary">Set customer-service flexibility independently from urgency. Rush changes priority; this workspace controls how far an order may move around its requested or confirmed delivery target.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        <NavLink href="/plan/demand" class="rounded-control border border-border-strong px-3 py-1.5 text-xs font-semibold hover:bg-surface-hover">Demand &amp; Supply</NavLink>
        <NavLink href="/plan/what-if" class="rounded-control border border-border-strong px-3 py-1.5 text-xs font-semibold hover:bg-surface-hover">What-if planning</NavLink>
        <NavLink href="/plan/versions" class="rounded-control bg-accent px-3 py-1.5 text-xs font-semibold text-accent-foreground">Plans</NavLink>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div role="status" class="mb-4 rounded border border-border px-3 py-2 text-sm @(messageIsError ? "bg-danger-soft text-danger" : "bg-success-soft text-success")">@message</div>
}

@if (loading)
{
    <p class="text-sm text-muted">Loading order service policies…</p>
}
else if (rows.Count == 0)
{
    <div class="rounded-surface border border-dashed border-border-strong bg-surface-raised p-8 text-center">
        <strong>No reconciled sales orders</strong>
        <p class="mt-1 text-sm text-secondary">Reconcile customer demand first, then return here to set service flexibility.</p>
        <NavLink href="/plan/demand" class="mt-3 inline-block text-sm font-semibold text-accent hover:underline">Open Demand &amp; Supply</NavLink>
    </div>
}
else
{
    <div class="mb-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <StatTile Label="Active orders" Value="@ActiveRows.Count.ToString()" />
        <StatTile Label="Rush" Value="@ActiveRows.Count(x => x.Priority >= 10).ToString()" Sub="Priority 10" />
        <StatTile Label="Hard commitment" Value="@ActiveRows.Count(x => x.ServiceCommitment == ServiceCommitmentClass.Hard).ToString()" />
        <StatTile Label="Flexible" Value="@ActiveRows.Count(x => x.ServiceCommitment == ServiceCommitmentClass.Flexible).ToString()" />
    </div>

    <div class="grid min-w-0 gap-4 xl:grid-cols-[minmax(0,1fr)_390px]">
        <section class="min-w-0 overflow-hidden rounded-surface border border-border bg-surface-raised shadow-soft">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3">
                <div>
                    <h2 class="text-sm font-semibold">Customer commitments</h2>
                    <p class="mt-0.5 text-xs text-secondary">Target remains the commercial requested/confirmed date. The window tells APS where schedule movement is acceptable.</p>
                </div>
                <label class="flex items-center gap-2 text-xs text-secondary">Filter
                    <input class="w-52 rounded-control border border-border-strong bg-surface px-2 py-1.5 text-sm" @bind="filter" @bind:event="oninput" placeholder="SO, customer, status" />
                </label>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full min-w-[940px] text-sm">
                    <thead>
                        <tr class="border-b border-border text-left text-xs text-muted">
                            <th class="px-3 py-2 font-medium">SO / Item</th>
                            <th class="px-3 py-2 font-medium">Customer</th>
                            <th class="px-3 py-2 font-medium">Target</th>
                            <th class="px-3 py-2 font-medium">Urgency</th>
                            <th class="px-3 py-2 font-medium">Commitment</th>
                            <th class="px-3 py-2 font-medium">Acceptable delivery window</th>
                            <th class="px-3 py-2 font-medium">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredRows)
                        {
                            <tr class="cursor-pointer border-b border-border last:border-0 hover:bg-surface-hover @(selected?.SalesOrderId == row.SalesOrderId ? "bg-accent-soft" : "") @(IsClosed(row) ? "opacity-60" : "")"
                                @onclick="() => Select(row)">
                                <td class="px-3 py-2"><strong>@row.SalesOrderNumber</strong> / @row.ItemNumber</td>
                                <td class="px-3 py-2 text-secondary">@(row.CustomerCode ?? "—")</td>
                                <td class="whitespace-nowrap px-3 py-2"><strong>@row.TargetDeliveryDate.ToString("dd MMM yyyy")</strong><div class="text-xs text-muted">@(row.ConfirmedDeliveryDate.HasValue ? "Confirmed" : "Requested")</div></td>
                                <td class="px-3 py-2">@if (row.Priority >= 10) { <span class="rounded bg-warning-soft px-1.5 py-0.5 text-xs font-semibold text-warning">RUSH</span> } else { <span class="text-xs text-secondary">Priority @row.Priority</span> }</td>
                                <td class="px-3 py-2"><span class="rounded px-1.5 py-0.5 text-xs font-semibold @CommitmentClass(row.ServiceCommitment)">@row.ServiceCommitment</span></td>
                                <td class="whitespace-nowrap px-3 py-2 text-xs">@WindowLabel(row)</td>
                                <td class="px-3 py-2 text-xs text-secondary">@(row.ExternalStatus ?? "OPEN")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <aside class="self-start rounded-surface border border-border bg-surface-raised shadow-soft xl:sticky xl:top-3">
            <div class="border-b border-border px-4 py-3">
                <h2 class="text-sm font-semibold">Service window</h2>
                <p class="mt-0.5 text-xs text-secondary">Change only the customer's acceptable movement. Rush/priority remains separate.</p>
            </div>

            @if (selected is null)
            {
                <div class="p-5 text-sm text-secondary">Select a Sales Order item.</div>
            }
            else
            {
                <div class="space-y-4 p-4">
                    <div class="rounded bg-surface-inset p-3">
                        <div class="text-xs text-muted">@selected.SalesOrderNumber / @selected.ItemNumber · @(selected.CustomerCode ?? "—")</div>
                        <div class="mt-1 text-sm"><strong>Target @selected.TargetDeliveryDate.ToString("dd MMM yyyy")</strong></div>
                        <div class="mt-1 text-xs text-secondary">Requested @selected.CustomerRequiredDate.ToString("dd MMM yyyy") · Confirmed @(selected.ConfirmedDeliveryDate?.ToString("dd MMM yyyy") ?? "—") · Priority @selected.Priority</div>
                    </div>

                    @if (IsClosed(selected))
                    {
                        <div class="rounded bg-warning-soft px-3 py-2 text-xs text-warning">This order is closed/cancelled. Its service policy is retained for audit but is not editable.</div>
                    }

                    <label class="block text-xs text-secondary">Commitment class
                        <select class="mt-1 w-full rounded-control border border-border-strong bg-surface px-2 py-1.5 text-sm" disabled="@IsClosed(selected)" @bind="editCommitment">
                            <option value="@ServiceCommitmentClass.Hard">Hard · no late movement</option>
                            <option value="@ServiceCommitmentClass.Standard">Standard · explicit tolerance when agreed</option>
                            <option value="@ServiceCommitmentClass.Flexible">Flexible · planner may use agreed window</option>
                        </select>
                    </label>

                    <div class="grid grid-cols-2 gap-3">
                        <label class="text-xs text-secondary">Earliest acceptable
                            <input type="date" class="mt-1 w-full rounded-control border border-border-strong bg-surface px-2 py-1.5 text-sm" disabled="@IsClosed(selected)" @bind="editEarliest" />
                        </label>
                        <label class="text-xs text-secondary">Latest acceptable
                            <input type="date" class="mt-1 w-full rounded-control border border-border-strong bg-surface px-2 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-50" disabled="@(IsClosed(selected) || editCommitment == ServiceCommitmentClass.Hard)" @bind="editLatest" />
                        </label>
                    </div>

                    <div class="grid grid-cols-4 gap-2">
                        <button type="button" class="rounded-control border border-border-strong px-2 py-1.5 text-xs hover:bg-surface-hover" disabled="@IsClosed(selected)" @onclick="SetHard">Hard</button>
                        <button type="button" class="rounded-control border border-border-strong px-2 py-1.5 text-xs hover:bg-surface-hover" disabled="@IsClosed(selected)" @onclick="() => AllowDays(1)">+1d</button>
                        <button type="button" class="rounded-control border border-border-strong px-2 py-1.5 text-xs hover:bg-surface-hover" disabled="@IsClosed(selected)" @onclick="() => AllowDays(3)">+3d</button>
                        <button type="button" class="rounded-control border border-border-strong px-2 py-1.5 text-xs hover:bg-surface-hover" disabled="@IsClosed(selected)" @onclick="() => AllowDays(7)">+7d</button>
                    </div>
                    <p class="text-xs text-muted">Preset buttons are explicit planner choices, not hidden defaults. You can type any acceptable boundary instead.</p>

                    @if (!string.IsNullOrWhiteSpace(EditError))
                    {
                        <div role="alert" class="rounded bg-danger-soft px-3 py-2 text-xs text-danger">@EditError</div>
                    }

                    <div class="rounded border border-border bg-surface-inset p-3 text-xs text-secondary">
                        <strong class="text-primary">Planning effect</strong>
                        <div class="mt-1">APS keeps the requested/confirmed date as service evidence, but campaign composition and finite scheduling may use the latest acceptable production date. Release still blocks a plan that finishes after that boundary.</div>
                    </div>

                    <div class="flex justify-end gap-2">
                        <NavLink href="/plan/demand" class="rounded-control border border-border-strong px-3 py-1.5 text-xs">Edit rush / demand</NavLink>
                        <button type="button" class="rounded-control bg-accent px-3 py-1.5 text-xs font-semibold text-accent-foreground disabled:opacity-50" disabled="@(saving || IsClosed(selected) || !string.IsNullOrWhiteSpace(EditError))" @onclick="SaveAsync">@(saving ? "Saving…" : "Save service window")</button>
                    </div>
                </div>
            }
        </aside>
    </div>
}

@code {
    private static readonly HashSet<string> ClosedStatuses = new(StringComparer.OrdinalIgnoreCase)
    {
        "CANCELLED", "CANCELED", "CLOSED", "COMPLETE", "COMPLETED", "DELETED", "REJECTED"
    };

    private readonly List<OrderServicePolicy> rows = [];
    private OrderServicePolicy? selected;
    private ServiceCommitmentClass editCommitment = ServiceCommitmentClass.Standard;
    private DateTime? editEarliest;
    private DateTime? editLatest;
    private string filter = "";
    private bool loading = true;
    private bool saving;
    private string? message;
    private bool messageIsError;

    private IReadOnlyList<OrderServicePolicy> ActiveRows => rows.Where(x => !IsClosed(x)).ToArray();
    private IEnumerable<OrderServicePolicy> FilteredRows => string.IsNullOrWhiteSpace(filter)
        ? rows
        : rows.Where(x => SearchText(x).Contains(filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private string? EditError => ValidateEdit();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync(Guid? keepSelection = null)
    {
        loading = true;
        try
        {
            rows.Clear();
            rows.AddRange(await Policies.GetAsync());
            var wanted = keepSelection ?? selected?.SalesOrderId;
            selected = wanted.HasValue
                ? rows.FirstOrDefault(x => x.SalesOrderId == wanted.Value)
                : rows.FirstOrDefault(x => !IsClosed(x)) ?? rows.FirstOrDefault();
            if (selected is not null) CopyToEditor(selected);
        }
        catch (Exception ex) { SetMessage(ex.Message, true); }
        finally { loading = false; }
    }

    private void Select(OrderServicePolicy row)
    {
        selected = row;
        CopyToEditor(row);
        message = null;
    }

    private void CopyToEditor(OrderServicePolicy row)
    {
        editCommitment = row.ServiceCommitment;
        editEarliest = row.EarliestAcceptableDeliveryDate?.Date;
        editLatest = row.LatestAcceptableDeliveryDate?.Date;
    }

    private void SetHard()
    {
        if (selected is null) return;
        editCommitment = ServiceCommitmentClass.Hard;
        editLatest = null;
    }

    private void AllowDays(int days)
    {
        if (selected is null) return;
        editCommitment = ServiceCommitmentClass.Standard;
        editLatest = selected.TargetDeliveryDate.Date.AddDays(days);
    }

    private async Task SaveAsync()
    {
        if (selected is null || !string.IsNullOrWhiteSpace(EditError)) return;
        saving = true;
        try
        {
            await Policies.UpdateAsync(new UpdateOrderServicePolicyRequest(
                selected.SalesOrderId,
                editCommitment,
                editEarliest,
                editCommitment == ServiceCommitmentClass.Hard ? null : editLatest));
            var id = selected.SalesOrderId;
            await LoadAsync(id);
            SetMessage("Service window saved. Recalculate or run a what-if plan to see its schedule impact.", false);
        }
        catch (Exception ex) { SetMessage(ex.Message, true); }
        finally { saving = false; }
    }

    private string? ValidateEdit()
    {
        if (selected is null) return null;
        var target = selected.TargetDeliveryDate.Date;
        if (editEarliest.HasValue && editEarliest.Value.Date > target) return "Earliest acceptable delivery must be on or before the target date.";
        if (editLatest.HasValue && editLatest.Value.Date < target) return "Latest acceptable delivery must be on or after the target date.";
        if (editCommitment == ServiceCommitmentClass.Flexible && !editEarliest.HasValue && !editLatest.HasValue) return "Flexible orders need at least one acceptable delivery boundary.";
        return null;
    }

    private static string WindowLabel(OrderServicePolicy row)
    {
        var target = row.TargetDeliveryDate;
        var latest = OrderServiceWindow.EffectiveLatestDelivery(target, row.ServiceCommitment, row.LatestAcceptableDeliveryDate);
        var earliest = row.EarliestAcceptableDeliveryDate?.ToString("dd MMM") ?? "any earlier";
        return row.ServiceCommitment == ServiceCommitmentClass.Hard
            ? $"≤ {target:dd MMM}"
            : $"{earliest} → {latest:dd MMM}";
    }

    private static bool IsClosed(OrderServicePolicy row) =>
        !string.IsNullOrWhiteSpace(row.ExternalStatus) && ClosedStatuses.Contains(row.ExternalStatus.Trim());

    private static string SearchText(OrderServicePolicy row) =>
        $"{row.SalesOrderNumber} {row.ItemNumber} {row.CustomerCode} {row.ExternalStatus} {row.ServiceCommitment}";

    private static string CommitmentClass(ServiceCommitmentClass value) => value switch
    {
        ServiceCommitmentClass.Hard => "bg-danger-soft text-danger",
        ServiceCommitmentClass.Flexible => "bg-info-soft text-info",
        _ => "bg-surface-inset text-secondary"
    };

    private void SetMessage(string value, bool isError) { message = value; messageIsError = isError; }
}
