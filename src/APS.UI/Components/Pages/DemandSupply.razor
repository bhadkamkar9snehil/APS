@page "/plan/demand"
@implements IDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject IProductionDemandOrchestrationService Demand
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>Demand & Supply - APS</PageTitle>

<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="text-lg font-semibold">Demand &amp; Supply</h1>
        <p class="text-sm text-secondary">How each Production Order is covered before fresh steel is created.</p>
    </div>
    <NavLink href="/plan/versions" class="rounded border border-border-strong px-3 py-1.5 text-xs font-semibold hover:bg-surface-hover">Plan Versions</NavLink>
</div>

<details id="reconcile-sales-order" class="mb-6 rounded border border-border bg-surface-raised shadow-soft">
    <summary class="cursor-pointer select-none px-4 py-3 text-sm font-semibold text-primary hover:bg-surface-hover">
        Reconcile sales orders
        <span class="ml-2 font-normal text-secondary">Add, refresh, rush or cancel a sales-order line</span>
    </summary>
    <div class="border-t border-border p-4">
        <div class="grid gap-3 text-sm sm:grid-cols-2 xl:grid-cols-4">
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">SO number</span><input class="rounded border border-border-strong px-2 py-1" @bind="soNumber" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Item</span><input class="rounded border border-border-strong px-2 py-1" @bind="soItem" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Customer</span><input class="rounded border border-border-strong px-2 py-1" @bind="customerCode" placeholder="optional" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">ERP status</span><select class="rounded border border-border-strong px-2 py-1" @bind="externalStatus"><option value="OPEN">OPEN</option><option value="CANCELLED">CANCELLED</option><option value="CLOSED">CLOSED</option><option value="REJECTED">REJECTED</option></select></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Material code</span><input class="rounded border border-border-strong px-2 py-1" @bind="materialCode" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Grade</span><input class="rounded border border-border-strong px-2 py-1" @bind="gradeCode" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Final section</span><input class="rounded border border-border-strong px-2 py-1" @bind="crossSectionCode" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Order qty (MT)</span><input type="number" min="0" step="0.01" class="rounded border border-border-strong px-2 py-1" @bind="orderQuantityMt" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Open qty (MT)</span><input type="number" min="0" step="0.01" class="rounded border border-border-strong px-2 py-1 disabled:cursor-not-allowed disabled:opacity-50" disabled="@IsClosedInput" @bind="openQuantityMt" /><span class="text-[11px] text-muted">Closed statuses reconcile as 0 MT open demand.</span></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Customer required date</span><input type="date" class="rounded border border-border-strong px-2 py-1" @bind="requiredDate" /></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Confirmed delivery date</span><input type="date" class="rounded border border-border-strong px-2 py-1" @bind="confirmedDeliveryDate" /><span class="text-[11px] text-muted">Optional negotiated/confirmed date.</span></label>
            <label class="flex flex-col gap-1"><span class="text-xs text-secondary">Priority (0–10)</span><input type="number" min="0" max="10" class="rounded border border-border-strong px-2 py-1 disabled:cursor-not-allowed disabled:opacity-50" disabled="@rushOrder" @bind="priority" /><span class="text-[11px] text-muted">Higher priority increases tardiness cost.</span></label>
        </div>

        <div class="mt-3 grid gap-2 lg:grid-cols-3">
            <label class="flex items-center gap-2 rounded border border-border bg-surface-inset px-3 py-2 text-sm">
                <input type="checkbox" @bind="rushOrder" />
                <span><strong>Rush order</strong><span class="ml-1 text-xs text-secondary">uses priority 10 while retaining its own due date.</span></span>
            </label>
            <div class="rounded border border-border bg-surface-inset px-3 py-2 text-xs text-secondary">
                <strong class="text-primary">Due-date basis:</strong> confirmed delivery is used when supplied; otherwise the customer-required date is used. Production-required-by is then derived from the configured QA/packing/dispatch lead time.
            </div>
            <div class="rounded border border-border bg-surface-inset px-3 py-2 text-xs text-secondary">
                <strong class="text-primary">Cancellation:</strong> planned MTO demand can be cancelled automatically. Firmed/released production is protected and surfaced for planner attention rather than silently deleted.
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(reconcileError))
        {
            <div role="alert" class="mt-3 rounded border border-border bg-danger-soft px-3 py-2 text-sm text-danger">@reconcileError</div>
        }
        <div class="mt-3 flex flex-wrap items-center gap-3">
            <button type="button"
                    class="rounded bg-accent px-3 py-1.5 text-sm font-medium text-accent-foreground hover:bg-accent-hover disabled:cursor-not-allowed disabled:opacity-50"
                    disabled="@(reconciling || ReconcileInputIncomplete)"
                    @onclick="SubmitReconcileAsync">
                @(reconciling ? "Reconciling…" : IsClosedInput ? "Submit cancellation" : "Submit and reconcile")
            </button>
            @if (ReconcileInputIncomplete)
            {
                <span class="text-xs text-muted">Complete SO, material, grade, section and quantity fields. Open quantity may be zero only for a closed status.</span>
            }
        </div>
    </div>
</details>

@if (loading)
{
    <p class="text-sm text-muted">Loading demand coverage…</p>
}
else if (view is null)
{
    <div class="rounded border border-dashed border-border-strong bg-surface-raised p-8 text-center">
        <strong class="text-primary">No persisted demand snapshot</strong>
        <p class="mt-1 text-sm text-secondary">Run and persist a Plan Version before using the production Demand &amp; Supply workspace.</p>
        <NavLink href="/plan/versions" class="mt-3 inline-block text-sm font-semibold text-accent hover:underline">Open Plan Versions</NavLink>
    </div>
}
else
{
    <div class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        <StatTile Label="Remaining demand" Value="@($"{view.TotalRemainingQuantityMt:0.##} MT")" Sub="@($"{view.MakeToOrderCount} MTO / {view.MakeToStockCount} MTS")" />
        <StatTile Label="FG covered" Value="@($"{view.FinishedGoodsAllocatedMt:0.##} MT")" />
        <StatTile Label="Existing billet" Value="@($"{view.ExistingIntermediateAllocatedMt:0.##} MT")" />
        <StatTile Label="External billet" Value="@($"{view.ExternalIntermediateAllocatedMt:0.##} MT")" />
        <StatTile Label="Fresh steel" Value="@($"{view.FreshSteelRequirementMt:0.##} MT")" />
        <StatTile Label="Uncovered" Value="@($"{view.UncoveredQuantityMt:0.##} MT")" />
    </div>

    <section class="overflow-x-auto rounded border border-border bg-surface-raised">
        <table class="w-full min-w-[900px] text-sm">
            <thead>
                <tr class="border-b border-border text-left text-xs text-muted">
                    <th class="px-3 py-2 font-medium">Production Order</th>
                    <th class="px-3 py-2 font-medium">Requirement</th>
                    <th class="px-3 py-2 font-medium">Coverage</th>
                    <th class="px-3 py-2 font-medium">Due</th>
                    <th class="px-3 py-2 font-medium">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in view.Rows)
                {
                    <tr class="border-b border-border last:border-0">
                        <td class="px-3 py-2">
                            <span class="mr-1 rounded px-1.5 py-0.5 text-xs font-medium @(row.DemandSource == DemandSourceType.MakeToOrder ? "bg-info-soft text-info" : "bg-surface-inset text-secondary")">@(row.DemandSource == DemandSourceType.MakeToOrder ? "MTO" : "MTS")</span>
                            @if (row.Priority >= RushPriority) { <span class="mr-1 rounded bg-warning-soft px-1.5 py-0.5 text-xs font-semibold text-warning">RUSH</span> }
                            <strong>@row.ProductionOrderNumber</strong>
                            <div class="text-xs text-muted">
                                @if (!string.IsNullOrWhiteSpace(row.SalesOrderNumber))
                                {
                                    @($"SO {row.SalesOrderNumber}/{row.SalesOrderItemNumber} · {Display(row.CustomerCode)}")
                                }
                                else
                                {
                                    @($"{Display(row.StockPolicyCode)} · target {FormatNullable(row.TargetStockMt)} MT")
                                }
                            </div>
                        </td>
                        <td class="px-3 py-2">
                            <strong>@row.GradeCode &middot; @row.FinalCrossSectionCode</strong>
                            <div class="text-xs text-muted">@row.MaterialCode &middot; route @row.RouteCode</div>
                            <div class="mt-0.5 flex flex-wrap gap-1 text-xs">
                                @if (row.VdRequirement != RequirementDisposition.Optional) { <span class="rounded bg-surface-inset px-1">VD @row.VdRequirement</span> }
                                @if (row.ReheatRequirement != RequirementDisposition.Optional) { <span class="rounded bg-surface-inset px-1">RHF @row.ReheatRequirement</span> }
                                @if (row.TmtRequirement != RequirementDisposition.Optional) { <span class="rounded bg-surface-inset px-1">TMT @row.TmtRequirement</span> }
                                @if (row.SegregationPolicy != SegregationPolicy.None) { <span class="rounded bg-surface-inset px-1">@row.SegregationPolicy</span> }
                                @if (!row.HotChargeAllowed) { <span class="rounded bg-warning-soft px-1 text-warning">NO HOT CHARGE</span> }
                            </div>
                        </td>
                        <td class="w-56 px-3 py-2">
                            <div class="flex h-2 overflow-hidden rounded bg-surface-inset" aria-label="Demand coverage">
                                @CoverageSegment(row.FinishedGoodsAllocatedMt, row.RemainingQuantityMt, "bg-process-casting")
                                @CoverageSegment(row.ExistingIntermediateAllocatedMt, row.RemainingQuantityMt, "bg-process-hot-roll")
                                @CoverageSegment(row.ExternalIntermediateAllocatedMt, row.RemainingQuantityMt, "bg-process-lrf")
                                @CoverageSegment(row.FreshSteelRequirementMt, row.RemainingQuantityMt, "bg-process-eaf")
                                @CoverageSegment(row.UncoveredQuantityMt, row.RemainingQuantityMt, "bg-danger-soft")
                            </div>
                            <div class="mt-1 text-xs text-muted">@row.RemainingQuantityMt.ToString("0.##") MT total</div>
                        </td>
                        <td class="px-3 py-2">
                            <strong>@row.RequiredDate.ToString("dd MMM")</strong>
                            <div class="text-xs text-muted">Priority @row.Priority</div>
                        </td>
                        <td class="px-3 py-2">
                            <span class="rounded px-1.5 py-0.5 text-xs font-medium @(row.UncoveredQuantityMt > 0m ? "bg-danger-soft text-danger" : "bg-success-soft text-success")">@(row.UncoveredQuantityMt > 0m ? "UNCOVERED" : "COVERED")</span>
                            <div class="text-xs text-muted">@row.Status</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    @if (view.SalesOrders is { Count: > 0 } salesOrders)
    {
        <section class="mt-6 overflow-x-auto rounded border border-border bg-surface-raised">
            <div class="border-b border-border px-3 py-2 text-sm font-semibold">Sales Order coverage (@salesOrders.Count)</div>
            <table class="w-full min-w-[1040px] text-sm">
                <thead>
                    <tr class="border-b border-border text-left text-xs text-muted">
                        <th class="px-3 py-2 font-medium">SO / Item</th>
                        <th class="px-3 py-2 font-medium">Service dates</th>
                        <th class="px-3 py-2 font-medium">Open demand</th>
                        <th class="px-3 py-2 font-medium">FG covered</th>
                        <th class="px-3 py-2 font-medium">Mfg requirement</th>
                        <th class="px-3 py-2 font-medium">Disposition</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var so in salesOrders)
                    {
                        <tr class="border-b border-border last:border-0">
                            <td class="px-3 py-2"><strong>@so.SalesOrderNumber</strong> / @so.SalesOrderItemNumber @if (so.Priority >= RushPriority) { <span class="ml-1 rounded bg-warning-soft px-1.5 py-0.5 text-xs font-semibold text-warning">RUSH</span> }<div class="text-xs text-muted">@Display(so.CustomerCode) · priority @so.Priority</div></td>
                            <td class="px-3 py-2 text-xs"><div>Requested <strong>@so.CustomerRequiredDate.ToString("dd MMM yyyy")</strong></div><div class="text-muted">Confirmed @(so.ConfirmedDeliveryDate?.ToString("dd MMM yyyy") ?? "—")</div><div class="text-muted">Production by @so.ProductionRequiredByDate.ToString("dd MMM yyyy HH:mm")</div></td>
                            <td class="px-3 py-2">@so.OpenDemandQuantityMt.ToString("0.##") MT</td>
                            <td class="px-3 py-2">@so.FinishedGoodsCoveredQuantityMt.ToString("0.##") MT</td>
                            <td class="px-3 py-2">@so.ManufacturingRequirementQuantityMt.ToString("0.##") MT</td>
                            <td class="px-3 py-2">
                                <span class="rounded px-1.5 py-0.5 text-xs @(so.PlannerAttentionRequired ? "bg-warning-soft text-warning" : "bg-surface-inset text-secondary")">@so.Disposition</span>
                                @if (!string.IsNullOrWhiteSpace(so.ReasonCode)) { <div class="mt-1 max-w-72 text-xs text-muted">@so.ReasonCode</div> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

@code {
    private const int RushPriority = 10;

    private DemandSupplyView? view;
    private bool loading = true;
    private bool reconciling;
    private string? reconcileError;

    private string soNumber = "";
    private string soItem = "10";
    private string customerCode = "";
    private string materialCode = "";
    private string gradeCode = "";
    private string crossSectionCode = "";
    private string externalStatus = "OPEN";
    private decimal orderQuantityMt;
    private decimal openQuantityMt;
    private DateTime requiredDate = DateTime.UtcNow.Date.AddDays(14);
    private DateTime? confirmedDeliveryDate;
    private int priority;
    private bool rushOrder;

    private bool IsClosedInput => externalStatus is "CANCELLED" or "CLOSED" or "REJECTED";
    private decimal EffectiveOpenQuantity => IsClosedInput ? 0m : openQuantityMt;
    private int EffectivePriority => rushOrder ? RushPriority : Math.Clamp(priority, 0, RushPriority);

    private bool ReconcileInputIncomplete =>
        string.IsNullOrWhiteSpace(soNumber)
        || string.IsNullOrWhiteSpace(soItem)
        || string.IsNullOrWhiteSpace(materialCode)
        || string.IsNullOrWhiteSpace(gradeCode)
        || string.IsNullOrWhiteSpace(crossSectionCode)
        || orderQuantityMt <= 0m
        || (!IsClosedInput && openQuantityMt <= 0m)
        || openQuantityMt > orderQuantityMt;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.Changed += OnWorkspaceChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        view = await PlannerQuery.GetDemandSupplyAsync(WorkspaceState.CurrentPlanVersionId);
        loading = false;
        StateHasChanged();
    }

    private void OnWorkspaceChanged()
    {
        if (view is not null && WorkspaceState.CurrentPlanVersionId != view.Plan.PlanVersionId)
        {
            _ = InvokeAsync(LoadAsync);
        }
    }

    private async Task SubmitReconcileAsync()
    {
        if (ReconcileInputIncomplete)
            return;

        reconciling = true;
        reconcileError = null;
        StateHasChanged();
        try
        {
            var input = new SalesOrderDemandInput(
                SalesOrderNumber: soNumber.Trim(),
                ItemNumber: soItem.Trim(),
                MaterialCode: materialCode.Trim(),
                GradeCode: gradeCode.Trim(),
                FinalCrossSectionCode: crossSectionCode.Trim(),
                OrderQuantityMt: orderQuantityMt,
                OpenQuantityMt: EffectiveOpenQuantity,
                CustomerRequiredDate: requiredDate,
                ConfirmedDeliveryDate: confirmedDeliveryDate,
                CustomerCode: Normalize(customerCode),
                ExternalStatus: externalStatus,
                Priority: EffectivePriority);
            await Demand.ReconcileSalesOrdersAsync(new[] { input });
            ResetReconcileForm();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            reconcileError = ex.Message;
        }
        finally
        {
            reconciling = false;
            StateHasChanged();
        }
    }

    private void ResetReconcileForm()
    {
        soNumber = "";
        soItem = "10";
        customerCode = "";
        materialCode = "";
        gradeCode = "";
        crossSectionCode = "";
        externalStatus = "OPEN";
        orderQuantityMt = 0m;
        openQuantityMt = 0m;
        requiredDate = DateTime.UtcNow.Date.AddDays(14);
        confirmedDeliveryDate = null;
        priority = 0;
        rushOrder = false;
    }

    private RenderFragment CoverageSegment(decimal quantity, decimal total, string cssClass) => builder =>
    {
        if (quantity <= 0m || total <= 0m) return;
        var pct = Math.Clamp(quantity / total * 100m, 0m, 100m);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", cssClass);
        builder.AddAttribute(2, "style", $"width:{pct.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)}%");
        builder.CloseElement();
    };

    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string FormatNullable(decimal? value) => value.HasValue ? value.Value.ToString("0.##") : "—";

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}
