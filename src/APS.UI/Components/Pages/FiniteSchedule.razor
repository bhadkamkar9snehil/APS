@page "/plan/schedule"
@implements IDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>Finite Schedule - APS</PageTitle>

<div class="planner-page schedule-workspace">
    <header class="workspace-titlebar">
        <div>
            <span class="workspace-eyebrow">PLAN / FINITE SCHEDULE</span>
            <h1>Finite Schedule</h1>
            <p>Solver-owned assignments on independent physical resources. Every lane is a ResourceId.</p>
        </div>
        @if (view is not null)
        {
            <div class="workspace-basis"><span>Basis</span><strong>@view.Plan.VersionNumber solved snapshot</strong></div>
        }
    </header>

    @if (loading)
    {
        <div class="planner-empty-state"><strong>Loading finite schedule…</strong></div>
    }
    else if (view is null)
    {
        <div class="planner-empty-state planner-empty-state-major"><strong>No persisted finite schedule</strong></div>
    }
    else
    {
        <section class="schedule-toolbar">
            <div><span>Window</span><strong>@view.ScheduleStartUtc.ToString("dd MMM HH:mm") → @view.ScheduleEndUtc.ToString("dd MMM HH:mm")</strong></div>
            <div><span>Operations</span><strong>@view.OperationCount</strong></div>
            <div><span>Physical resources</span><strong>@view.ResourceCount</strong></div>
            <div class="schedule-legend">
                <span><i class="op-eaf"></i>EAF</span>
                <span><i class="op-lrf"></i>LRF</span>
                <span><i class="op-vd"></i>VD</span>
                <span><i class="op-ccm"></i>CCM</span>
                <span><i class="op-reheat"></i>RHF</span>
                <span><i class="op-hotroll"></i>RM</span>
            </div>
        </section>

        <section class="schedule-board">
            <div class="schedule-axis-row">
                <div class="schedule-resource-axis-label">RESOURCE</div>
                <div class="schedule-axis">
                    @foreach (var tick in AxisTicks())
                    {
                        <span style="left:@tick.LeftPercent.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)%">@tick.Time.ToString("dd MMM HH:mm")</span>
                    }
                </div>
            </div>

            @foreach (var lane in view.ResourceLanes)
            {
                <div class="schedule-lane-row">
                    <button type="button" class="schedule-resource-label" @onclick="() => SelectResource(lane)">
                        <strong>@lane.ResourceCode</strong>
                        <span>@lane.ProcessUnitType</span>
                        <small>@lane.ScheduledHours.ToString("0.##") h · @lane.Operations.Count ops</small>
                    </button>
                    <div class="schedule-lane-track">
                        @foreach (var operation in lane.Operations)
                        {
                            <button type="button"
                                    class="schedule-operation op-@ProcessClass(operation.ProcessOperationType)"
                                    style="left:@OperationLeft(operation)%;width:@OperationWidth(operation)%"
                                    title="@OperationTitle(operation)"
                                    @onclick="() => SelectOperation(operation)">
                                <strong>@operation.ProcessOperationType</strong>
                                <span>@operation.GradeCode</span>
                            </button>
                        }
                    </div>
                </div>
            }
        </section>

        <p class="schedule-disclaimer">This view renders the persisted solved operation assignments. Resource calendar blocks, time-fence policy and dependency edges will be added only after those exact run assumptions are snapshotted with the Plan Version.</p>
    }
</div>

@code {
    private FiniteScheduleWorkspaceView? view;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.Changed += OnWorkspaceChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        view = await PlannerQuery.GetFiniteScheduleAsync(WorkspaceState.CurrentPlanVersionId);
        loading = false;
        StateHasChanged();
    }

    private void OnWorkspaceChanged()
    {
        if (view is not null && WorkspaceState.CurrentPlanVersionId != view.Plan.PlanVersionId)
            _ = InvokeAsync(LoadAsync);
    }

    private decimal OperationLeft(ScheduledProcessOperationView operation)
    {
        if (view is null) return 0m;
        var totalMinutes = Math.Max(1d, (view.ScheduleEndUtc - view.ScheduleStartUtc).TotalMinutes);
        return (decimal)Math.Clamp((operation.StartUtc - view.ScheduleStartUtc).TotalMinutes / totalMinutes * 100d, 0d, 100d);
    }

    private decimal OperationWidth(ScheduledProcessOperationView operation)
    {
        if (view is null) return 0m;
        var totalMinutes = Math.Max(1d, (view.ScheduleEndUtc - view.ScheduleStartUtc).TotalMinutes);
        var width = Math.Max(0d, (operation.EndUtc - operation.StartUtc).TotalMinutes) / totalMinutes * 100d;
        return (decimal)Math.Clamp(width, .18d, 100d);
    }

    private IReadOnlyCollection<AxisTick> AxisTicks()
    {
        if (view is null) return Array.Empty<AxisTick>();
        const int count = 6;
        var span = view.ScheduleEndUtc - view.ScheduleStartUtc;
        return Enumerable.Range(0, count + 1)
            .Select(i => new AxisTick(view.ScheduleStartUtc + TimeSpan.FromTicks(span.Ticks * i / count), i * 100d / count))
            .ToArray();
    }

    private void SelectOperation(ScheduledProcessOperationView operation) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Operation, operation.OperationSnapshotId, operation.PlanningKey));

    private void SelectResource(ScheduleResourceLaneView lane) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Resource, lane.ResourceId, lane.ResourceCode));

    private static string ProcessClass(ProcessOperationType type) => type.ToString().ToLowerInvariant();
    private static string OperationTitle(ScheduledProcessOperationView op) =>
        $"{op.ProcessOperationType} · {op.ResourceCode} · {op.StartUtc:dd MMM HH:mm} → {op.EndUtc:dd MMM HH:mm} · {op.QuantityMt:0.##} MT · {op.GradeCode}/{op.CrossSectionCode}";

    private sealed record AxisTick(DateTime Time, double LeftPercent);

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}
