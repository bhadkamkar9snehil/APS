@page "/"
@page "/plan/schedule"
@implements IAsyncDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject IPlanningWorkbenchCommandService Commands
@inject IPlanningLifecycleService Lifecycle
@inject IPersistedPlanReleaseService ReleaseService
@inject PlannerWorkspaceState WorkspaceState
@inject PlannerCockpitState Cockpit
@inject IJSRuntime JS

<PageTitle>Planning Workbench - APS</PageTitle>

<div @ref="workbenchRoot" class="flex h-full min-h-0 flex-col overflow-hidden bg-canvas" data-aps-workbench tabindex="-1" @onkeydown="HandleWorkbenchKeyDown">
    @if (loading)
    {
        <div class="flex flex-1 flex-col gap-px overflow-hidden bg-border p-px">
            <div class="aps-shimmer h-12 bg-surface"></div>
            @for (var i = 0; i < 6; i++)
            {
                <div class="aps-shimmer h-16 bg-surface" style="animation-delay:@(i * 90)ms"></div>
            }
        </div>
    }
    else if (workbench is null)
    {
        <div class="grid flex-1 place-items-center p-8">
            <div class="max-w-md rounded-surface border border-dashed border-border-strong bg-surface p-8 text-center shadow-soft">
                <strong>No active plan to schedule</strong>
                <p class="mt-2 text-sm text-secondary">Create a Plan Version first. The workbench always edits a persisted plan and preserves its baseline.</p>
                <a href="/plan/versions" class="mt-4 inline-flex rounded-control bg-accent px-4 py-2 font-medium text-accent-foreground">Open Plan Versions</a>
            </div>
        </div>
    }
    else
    {
        <WorkbenchScenarioHeader ScenarioName="@ScenarioName"
                                 StateLabel="@ScenarioStateLabel"
                                 StateClass="@ScenarioStateClass"
                                 IsReleased="@workbench.Plan.IsReleased"
                                 CanEdit="@(state.CanEditSchedule && !acting)"
                                 IsBusy="@acting"
                                 CanUndo="@CanUndo"
                                 CanRedo="@CanRedo"
                                 CanRelease="@CanRelease"
                                 OperationCount="@workbench.Schedule.OperationCount"
                                 ResourceCount="@workbench.Schedule.ResourceCount"
                                 ScheduleStartUtc="@workbench.Schedule.ScheduleStartUtc"
                                 ScheduleEndUtc="@workbench.Schedule.ScheduleEndUtc"
                                 ActualsTimeUtc="@workbench.Plan.ReferenceTimeUtc"
                                 Undo="UndoAsync"
                                 Redo="RedoAsync"
                                 Optimize="ReplanAsync"
                                 Validate="ValidateScenario"
                                 Release="ReleaseAsync" />

        <div class="flex shrink-0 items-center border-b border-border bg-surface-raised px-3">
            <WorkbenchLifecycleRail Mode="@state.Mode" IsReleased="@workbench.Plan.IsReleased" ModeChanged="SetMode" StartPlanning="StartPlanningScenario" StartRecovery="StartRecovery" />
            <div class="ml-auto hidden text-right text-[10px] text-muted xl:block">
                <span class="block">Objective profile</span><strong class="text-primary">Delivery reliability</strong>
            </div>
        </div>

        <header class="shrink-0 border-b border-border bg-surface px-4 py-2 shadow-soft">
            <div class="flex flex-wrap items-center gap-2">
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="() => state.Pan(-0.75)">Earlier</button>
                @foreach (var zoom in Enum.GetValues<PlanningWorkbenchZoom>())
                {
                    <button class="rounded-control border px-2 py-1 text-xs @(state.Zoom == zoom ? "border-accent bg-accent-soft text-accent" : "border-border")" @onclick="() => SetZoomPreferenceAsync(zoom)">@ZoomLabel(zoom)</button>
                }
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="() => state.Pan(0.75)">Later</button>
                <span class="mx-1 h-5 w-px bg-border"></span>
                <div class="flex min-w-52 flex-1 gap-1 md:max-w-80">
                    <input value="@state.SearchText" @oninput="SearchChanged" class="min-w-0 flex-1 rounded-control border border-border bg-surface-raised px-3 py-1.5 text-xs" placeholder="Find order, campaign, grade or resource" />
                    @if (HasFocus)
                    {
                        <button type="button" class="rounded-control border border-border px-2 text-xs text-accent" @onclick="ClearFocus">Clear</button>
                    }
                </div>
                <select aria-label="Row density" value="@state.Viewport.Density" @onchange="DensityChangedAsync" class="rounded-control border border-border bg-surface-raised px-2 py-1 text-xs">
                    @foreach (var density in Enum.GetValues<GanttDensity>()) { <option value="@density">@density</option> }
                </select>
                <select aria-label="Move snap" value="@state.Viewport.SnapMode" @onchange="SnapChangedAsync" class="rounded-control border border-border bg-surface-raised px-2 py-1 text-xs">
                    @foreach (var snap in Enum.GetValues<GanttSnapMode>()) { <option value="@snap">@SnapLabel(snap)</option> }
                </select>
                <ToggleButton Active="state.ShowBaseline" Label="Baseline" OnClick="ToggleBaselineAsync" />
                <select aria-label="Baseline display" value="@state.BaselineMode" @onchange="BaselineModeChangedAsync" disabled="@(!state.ShowBaseline)" class="rounded-control border border-border bg-surface-raised px-2 py-1 text-xs disabled:opacity-50">
                    <option value="Ghost">All baseline</option>
                    <option value="ChangedOnly">Changed only</option>
                    <option value="CompareSubrow">Compare subrow</option>
                </select>
                <ToggleButton Active="state.ShowDependencies" Label="Selected chain" OnClick="ToggleDependenciesAsync" />
                @if (workbench.BindingEvidence is { Count: > 0 })
                {
                    <button type="button" class="rounded-control border border-border px-2 py-1 text-xs" @onclick="ToggleDependenciesAsync" title="Show the solver-derived binding evidence for the selected operation">Binding chain</button>
                }
                else
                {
                    <button type="button" disabled class="rounded-control border border-border px-2 py-1 text-xs text-muted opacity-60" title="Solver-derived slack and binding-cause evidence are not available in this plan read model">Binding chain unavailable</button>
                }
                <button type="button" class="rounded-control border px-2 py-1 text-xs @(state.CapacityPanelOpen ? "border-accent bg-accent-soft text-accent" : "border-border")" @onclick="ToggleCapacityPanelAsync">@(state.CapacityPanelOpen ? "Hide load" : "Resource load")</button>
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="Cockpit.ToggleQueue">@(Cockpit.QueueOpen ? "Hide queue" : "Demand queue")</button>
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="Cockpit.ToggleInspector">@(Cockpit.InspectorOpen ? "Hide inspector" : "Inspector")</button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="shrink-0 border-b px-4 py-2 text-xs @(messageIsError ? "border-danger bg-danger-soft text-danger" : "border-success bg-success-soft text-success")">@message</div>
        }

        <div class="relative min-h-0 flex-1 overflow-hidden">
            @if (Cockpit.QueueOpen)
            {
                <aside class="absolute inset-y-0 left-0 z-40 flex min-h-0 w-80 overflow-hidden border-r border-border bg-surface shadow-raised">
                    <div class="flex min-h-0 w-full flex-col">
                    <div class="flex items-start justify-between gap-2 border-b border-border px-3 py-2">
                        <div><strong class="block text-xs">@QueueTitle</strong><span class="mt-0.5 block text-[10px] text-muted">@QueueDescription</span></div>
                        @if (HasFocus)
                        {
                            <button type="button" class="shrink-0 text-[10px] font-medium text-accent hover:underline" @onclick="ClearFocus">Clear focus</button>
                        }
                    </div>
                    <div class="min-h-0 flex-1 overflow-y-auto p-2">
                        @if (state.QueueContent == PlanningWorkbenchQueueContent.Demand)
                        {
                            @foreach (var demand in FilteredDemand())
                            {
                                <button class="mb-1 w-full rounded-control border border-transparent bg-surface-raised p-2 text-left hover:border-accent-border" @onclick="() => FocusDemand(demand)">
                                    <div class="flex justify-between gap-2"><strong class="truncate text-xs">@demand.ProductionOrderNumber</strong><span class="text-xs font-semibold">@demand.RemainingQuantityMt.ToString("0.#") MT</span></div>
                                    <div class="mt-1 truncate text-[11px] text-secondary">@demand.GradeCode · @demand.FinalCrossSectionCode · @demand.RouteCode</div>
                                    <div class="mt-1 flex justify-between text-[10px] text-muted"><span>Due @demand.RequiredDate.ToString("dd MMM HH:mm")</span><span>P@demand.Priority · @demand.Status</span></div>
                                </button>
                            }
                        }
                        else if (state.QueueContent == PlanningWorkbenchQueueContent.Campaigns)
                        {
                            @foreach (var campaign in FilteredCampaigns())
                            {
                                <button class="mb-1 w-full rounded-control border border-transparent bg-surface-raised p-2 text-left hover:border-accent-border" @onclick="() => FocusCampaign(campaign)">
                                    <div class="flex justify-between"><strong class="text-xs">@campaign.CampaignNumber</strong><span class="text-xs font-semibold">@campaign.PlannedQuantityMt.ToString("0.#") MT</span></div>
                                    <div class="mt-1 text-[11px] text-secondary">@campaign.Heats.Count heats · @campaign.GradeSequenceClassCode · @campaign.CasterSectionCode</div>
                                    <div class="mt-1 text-[10px] text-muted">Due @campaign.RequiredDate.ToString("dd MMM HH:mm")</div>
                                </button>
                            }
                        }
                        else
                        {
                            @if (FilteredExceptions().Count == 0) { <div class="rounded-control border border-dashed border-border p-4 text-center text-xs text-muted">No exceptions in this view.</div> }
                            @foreach (var exception in FilteredExceptions())
                            {
                                <button class="mb-1 w-full rounded-control border p-2 text-left @(exception.Severity == PlanningWorkbenchExceptionSeverity.Critical ? "border-danger bg-danger-soft" : "border-warning bg-warning-soft")" @onclick="() => FocusException(exception)">
                                    <div class="text-xs font-semibold">@exception.Title</div><div class="mt-1 text-[11px] text-secondary">@exception.Impact</div>
                                </button>
                            }
                        }
                    </div>
                    </div>
                </aside>
            }

            <main class="h-full min-w-0 overflow-hidden bg-canvas">
                <WorkbenchGantt Workbench="workbench"
                                State="state"
                                FrozenFenceEndUtc="FrozenFenceEndUtc"
                                OperationSelected="SelectOperation"
                                ResourceSelected="SelectResource"
                                CapacitySegmentFocused="FocusCapacitySegment" />
            </main>

            @if (Cockpit.InspectorOpen)
            {
                <aside class="absolute inset-y-0 right-0 z-40 flex min-h-0 w-[22.5rem] flex-col bg-surface shadow-popover">
                    <div class="flex justify-between border-b border-border bg-surface-raised px-3 py-2 shadow-soft"><strong class="aps-text-label">Planner inspector</strong><button class="aps-text-caption hover:text-primary" @onclick="Cockpit.ToggleInspector">Close</button></div>
                    <div class="min-h-0 flex-1 overflow-y-auto p-3">
                        @if (SelectedOperation is null)
                        {
                            <div class="aps-page flex flex-col items-center gap-2 border border-dashed border-border-strong p-6 text-center">
                                <span class="text-2xl text-muted" aria-hidden="true">&#8963;</span>
                                <p class="aps-text-body text-secondary">Select or drag an operation to inspect, move, or reassign it.</p>
                            </div>
                            <PlanningControls NominalHeatMt="nominalHeatMt" NominalHeatMtChanged="v => nominalHeatMt = v" MaximumCampaignMt="maximumCampaignMt" MaximumCampaignMtChanged="v => maximumCampaignMt = v" FrozenMinutes="frozenMinutes" FrozenMinutesChanged="v => frozenMinutes = v" SolverSeconds="solverSeconds" SolverSecondsChanged="v => solverSeconds = v" OnRecalculate="ReplanAsync" Disabled="acting" />
                        }
                        else
                        {
                            var operation = SelectedOperation;
                            var detail = SelectedDetail;
                            <section class="aps-page p-3">
                                <div class="flex justify-between gap-3">
                                    <div><h2 class="aps-text-heading">@operation.ProcessOperationType · @operation.GradeCode</h2><p class="aps-text-caption">@operation.CrossSectionCode · @operation.QuantityMt.ToString("0.#") MT</p></div>
                                    <span class="h-fit rounded px-2 py-0.5 aps-text-caption @CommitmentStateClass(detail?.CommitmentState)">@(detail?.CommitmentState.ToString() ?? "Planned")</span>
                                </div>

                                @* Grouped instead of one flat 11-row list (#UI-depth): plan vs actuals vs lineage answer
                                   different questions, and running them together made "hasn't happened yet" read the
                                   same as "this is the plan." *@
                                <div class="mt-3 rounded-control bg-surface-inset p-2">
                                    <div class="aps-text-label mb-1.5">Plan</div>
                                    <dl class="grid grid-cols-[80px_1fr] gap-y-1">
                                        <dt class="aps-text-caption">Resource</dt><dd class="aps-text-figure text-xs">@operation.ResourceCode</dd>
                                        <dt class="aps-text-caption">Start</dt><dd class="aps-text-body">@operation.StartUtc.ToString("dd MMM yyyy HH:mm")</dd>
                                        <dt class="aps-text-caption">End</dt><dd class="aps-text-body">@operation.EndUtc.ToString("dd MMM yyyy HH:mm")</dd>
                                    </dl>
                                </div>

                                <div class="mt-2 rounded-control bg-surface-inset p-2">
                                    <div class="aps-text-label mb-1.5">Actuals</div>
                                    <dl class="grid grid-cols-[80px_1fr] gap-y-1">
                                        <dt class="aps-text-caption">Execution</dt><dd class="aps-text-body font-medium">@(detail?.ExecutionStatus.ToString() ?? "Planned")</dd>
                                        <dt class="aps-text-caption">Actual start</dt><dd class="@ActualValueClass(detail?.ActualStartUtc)">@FormatActual(detail?.ActualStartUtc)</dd>
                                        <dt class="aps-text-caption">Actual end</dt><dd class="@ActualValueClass(detail?.ActualEndUtc)">@FormatActual(detail?.ActualEndUtc)</dd>
                                        <dt class="aps-text-caption">Output</dt><dd class="aps-text-figure text-xs">@((detail?.ActualQuantityMt ?? 0m).ToString("0.#")) MT</dd>
                                    </dl>
                                </div>

                                <div class="mt-2 rounded-control bg-surface-inset p-2">
                                    <div class="aps-text-label mb-1.5">Lineage</div>
                                    <dl class="grid grid-cols-[80px_1fr] gap-y-1">
                                        <dt class="aps-text-caption">Campaign</dt><dd class="aps-text-body">@CampaignLabel(detail)</dd>
                                        <dt class="aps-text-caption">Orders</dt><dd class="aps-text-body">@OrderLabel(detail)</dd>
                                        <dt class="aps-text-caption">Predecessors</dt><dd class="aps-text-body">@(detail?.PredecessorPlanningKeys.Count ?? 0)</dd>
                                    </dl>
                                </div>
                            </section>

                            @* Its own elevated card, not a continuation of the read-only details above - this is
                               where the planner acts, and it should look like a distinct zone (#UI-depth). *@
                            <section class="aps-page mt-3 p-3">
                                <h3 class="aps-text-heading">Move or reassign</h3>
                                @if (!CanMoveSelectedOperation)
                                {
                                    <div class="mt-3 rounded-control bg-surface-inset p-3 aps-text-body text-secondary">@MoveRestrictionMessage</div>
                                }
                                <label class="mt-3 block aps-text-label">Eligible resource<select @bind="targetResourceText" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50">@foreach (var option in EligibleResources(operation, detail)) { <option value="@option.ResourceId">@option.ResourceCode · @option.ResourceName</option> }</select></label>
                                <label class="mt-2 block aps-text-label">Target start (UTC)<input type="datetime-local" value="@targetStartText" @onchange="TargetStartChanged" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50" /></label>
                                <label class="mt-2 block aps-text-label">Reason<select @bind="moveReason" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50"><option value="PLANNER_SEQUENCE">Sequence optimization</option><option value="RESOURCE_BALANCE">Resource balancing</option><option value="CUSTOMER_PRIORITY">Customer priority</option><option value="BREAKDOWN_RECOVERY">Breakdown recovery</option><option value="MATERIAL_AVAILABILITY">Material availability</option></select></label>
                                <label class="mt-2 block aps-text-label">Planner note<textarea @bind="moveComment" rows="2" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full resize-none rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50" placeholder="Why this change is needed"></textarea></label>
                                <label class="mt-2 flex gap-2 aps-text-body"><input type="checkbox" @bind="allowFrozenOverride" disabled="@(!CanMoveSelectedOperation)" /><span><strong>Authorized disruption override</strong><small class="block aps-text-caption">Required inside the frozen fence.</small></span></label>
                                <div class="mt-3 grid grid-cols-2 gap-2"><button class="rounded-control border border-border-strong px-3 py-2 aps-text-heading disabled:opacity-40" @onclick="PreviewMoveAsync" disabled="@(acting || !CanMoveSelectedOperation)">Preview impact</button><button class="rounded-control bg-accent px-3 py-2 aps-text-heading text-accent-foreground shadow-soft disabled:opacity-40 disabled:shadow-none" @onclick="ApplyMoveAsync" disabled="@(acting || !CanMoveSelectedOperation || state.Impact?.CanApply != true)">Apply move</button></div>
                            </section>
                        }
                    </div>
                </aside>
            }
        </div>

        @if (state.StagedMove is not null || state.Impact is not null)
        {
            <section class="shrink-0 border-t border-border bg-surface-raised px-4 py-3 shadow-raised">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="min-w-44"><span class="block text-[10px] uppercase tracking-wide text-muted">Proposed change</span><strong class="text-xs">@FriendlyOperationName(state.StagedMove?.PlanningKey)</strong></div>
                    @if (state.Impact is not null)
                    {
                        <div><span class="block text-[10px] text-muted">From</span><strong class="text-xs">@state.Impact.SourceResourceCode · @state.Impact.SourceStartUtc.ToString("dd MMM HH:mm")</strong></div><div><span class="block text-[10px] text-muted">To</span><strong class="text-xs text-accent">@state.Impact.TargetResourceCode · @state.Impact.TargetStartUtc.ToString("dd MMM HH:mm")</strong></div><div><span class="block text-[10px] text-muted">Movement</span><strong class="text-xs">@FormatMovement(state.Impact.MovementMinutes)</strong></div>
                        <div class="min-w-0 flex-1">@foreach (var finding in state.Impact.Findings) { <span class="mr-1 inline-flex rounded px-2 py-1 text-[10px] @(FindingClass(finding.Severity))">@finding.Message</span> }</div>
                        <button class="rounded-control bg-accent px-4 py-2 text-xs font-semibold text-accent-foreground disabled:opacity-40" @onclick="ApplyMoveAsync" disabled="@(acting || !state.Impact.CanApply)">Apply and repair plan</button>
                    }
                    else
                    {
                        <div class="flex flex-1 items-center gap-3">
                            <span class="text-xs text-muted">Previewing constraint and downstream schedule impact…</span>
                            <span class="aps-shimmer h-2 w-24 rounded-full"></span>
                        </div>
                    }
                    <button class="rounded-control border border-border px-3 py-2 text-xs" @onclick="state.ClearMove">Cancel</button>
                </div>
            </section>
        }

        <WorkbenchAnalysisDock Expanded="@Cockpit.AnalysisDockOpen"
                               View="@Cockpit.AnalysisView"
                               CriticalCount="@workbench.Queue.CriticalExceptions"
                               WarningCount="@workbench.Queue.WarningExceptions"
                               LateDemand="@workbench.Queue.LateDemand"
                               ViewChanged="Cockpit.OpenAnalysis"
                               Toggle="Cockpit.ToggleAnalysis" />
    }
</div>

@code {
    private readonly PlanningWorkbenchState state = new();
    private PlanningWorkbenchView? workbench;
    private ElementReference workbenchRoot;
    private DotNetObjectReference<FiniteSchedule>? selfReference;
    private bool loading = true, acting, dragInitialized, messageIsError;
    private string? message, moveComment;
    private string targetResourceText = "", targetStartText = "", moveReason = "PLANNER_SEQUENCE";
    private bool allowFrozenOverride;
    private decimal nominalHeatMt = 90m, maximumCampaignMt = 600m;
    private int frozenMinutes = 120, solverSeconds = 20;
    private GanttPreferences preferences = GanttPreferences.Default;

    private ScheduledProcessOperationView? SelectedOperation => FindOperation(state.SelectedPlanningKey);
    private PlanningOperationWorkbenchDetail? SelectedDetail => FindDetail(state.SelectedPlanningKey);
    private bool CanUndo => state.CanUndo;
    private bool CanRedo => state.CanRedo;
    private bool CanMoveSelectedOperation => state.CanEditSchedule && SelectedDetail?.ExecutionStatus is not OperationExecutionStatus.Completed and not OperationExecutionStatus.Running;
    private string MoveRestrictionMessage => !state.CanEditSchedule
        ? "This released baseline is read-only. Create a planning or recovery scenario to change future work."
        : SelectedDetail?.ExecutionStatus == OperationExecutionStatus.Completed
            ? "Completed work is fixed to its actual result and cannot be moved."
            : "Running work is protected. Repair the future schedule around it instead of moving it.";
    private bool CanRelease => !acting && !workbench!.Plan.IsReleased && workbench.Plan.Status == PlanVersionStatus.Feasible;
    private string ScenarioName => state.ScenarioIntent == PlanningScenarioIntent.Recovery
        ? $"Recovery · {workbench!.Plan.ReferenceTimeUtc:dd MMM HH:mm}"
        : state.ScenarioIntent == PlanningScenarioIntent.Clone
            ? $"Working scenario · {FriendlyPlanName(workbench!.Plan.VersionNumber)}"
        : FriendlyPlanName(workbench!.Plan.VersionNumber);
    private string ScenarioStateLabel => state.ScenarioIntent switch { PlanningScenarioIntent.Recovery => "Recovery draft", PlanningScenarioIntent.Clone => "Working draft", PlanningScenarioIntent.New => "New draft", _ => workbench!.Plan.Status.ToString() };
    private string ScenarioStateClass => workbench!.Plan.Status == PlanVersionStatus.Feasible ? "bg-success-soft text-success" : workbench.Plan.IsReleased ? "bg-info-soft text-info" : "bg-warning-soft text-warning";
    private DateTime FrozenFenceEndUtc => workbench?.Plan.ReferenceTimeUtc.AddMinutes(frozenMinutes) ?? DateTime.MinValue;

    protected override async Task OnInitializedAsync() { WorkspaceState.Changed += OnWorkspaceChanged; state.Changed += OnStateChanged; Cockpit.Changed += OnStateChanged; Cockpit.CommandRequested += OnCockpitCommandRequested; await LoadAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (workbench is null || dragInitialized) return; selfReference ??= DotNetObjectReference.Create(this); await JS.InvokeVoidAsync("apsPlanningWorkbench.initialize", workbenchRoot, selfReference); dragInitialized = true; }

    private async Task LoadAsync(Guid? planId = null, Guid? baselineId = null)
    {
        loading = true; dragInitialized = false; StateHasChanged();
        try { workbench = await PlannerQuery.GetPlanningWorkbenchAsync(planId ?? WorkspaceState.CurrentPlanVersionId, baselineId ?? WorkspaceState.BaselinePlanVersionId); if (workbench is not null) { state.SetReleasedPlan(workbench.Plan.IsReleased); state.SetPlanWindow(workbench.Plan.HorizonStartUtc, workbench.Plan.HorizonEndUtc, workbench.Schedule.ScheduleStartUtc, workbench.Schedule.ScheduleEndUtc); WorkspaceState.SetPlan(workbench.Plan.PlanVersionId, workbench.Baseline?.PlanVersionId ?? workbench.Plan.ParentPlanVersionId); WorkspaceState.SetWindow(workbench.Plan.HorizonStartUtc, workbench.Plan.HorizonEndUtc); } }
        catch (Exception ex) { SetMessage(ex.Message, true); }
        finally { loading = false; }
    }

    private void OnWorkspaceChanged() { if (workbench is not null && WorkspaceState.CurrentPlanVersionId != workbench.Plan.PlanVersionId) _ = InvokeAsync(() => LoadAsync(WorkspaceState.CurrentPlanVersionId, WorkspaceState.BaselinePlanVersionId)); }
    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnCockpitCommandRequested(PlannerCockpitCommand command) => _ = InvokeAsync(async () =>
    {
        switch (command)
        {
            case PlannerCockpitCommand.Optimize: await ReplanAsync(); break;
            case PlannerCockpitCommand.Validate: ValidateScenario(); break;
            case PlannerCockpitCommand.Release: await ReleaseAsync(); break;
            case PlannerCockpitCommand.CreateRecoveryScenario: StartRecovery(); break;
            case PlannerCockpitCommand.CreateScenario: StartPlanningScenario(); break;
        }
    });
    private void SetMode(PlanningWorkbenchMode mode)
    {
        if (mode == PlanningWorkbenchMode.Recovery && state.CanStartRecovery) { StartRecovery(); return; }
        state.SetMode(mode);
    }
    private void StartRecovery() { state.StartRecovery(); SetMessage("Recovery scenario started from the released baseline. Completed work remains fixed and future work can now be repaired.", false); }
    private void StartPlanningScenario() { state.StartPlanningScenario(); SetMessage("Working scenario created from the released baseline. The released plan remains unchanged until a new scenario is validated and released.", false); }
    private void ValidateScenario()
    {
        if (workbench is null) return;
        var critical = workbench.Exceptions.Count(x => x.Severity == PlanningWorkbenchExceptionSeverity.Critical);
        var feasible = workbench.Plan.Status is PlanVersionStatus.Feasible or PlanVersionStatus.Released;
        SetMessage(critical == 0 && feasible
            ? "Validation passed: the scenario is feasible and has no critical planning exceptions."
            : $"Validation found {critical} critical planning exception(s). Resolve them before approval or release.", critical > 0 || !feasible);
    }
    private void SearchChanged(ChangeEventArgs args) => state.SetSearch(args.Value?.ToString());
    private void ClearFocus() { state.ClearFocus(); WorkspaceState.ClearSelection(); }
    private void HandleWorkbenchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (Cockpit.OpenDrawer != PlannerCockpitDrawer.None) Cockpit.CloseTransientPanels();
        else ClearFocus();
    }
    private void TargetStartChanged(ChangeEventArgs args) => targetStartText = args.Value?.ToString() ?? string.Empty;

