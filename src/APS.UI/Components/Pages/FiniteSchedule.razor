@page "/plan/schedule"
@implements IDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject PlannerWorkspaceState WorkspaceState

<PageTitle>Finite Schedule - APS</PageTitle>

<h1 class="mb-1 text-lg font-semibold">Finite Schedule</h1>
<p class="mb-6 text-sm text-secondary">Solver-owned assignments on independent physical resources. Every lane is a ResourceId.</p>

@if (loading)
{
    <p class="text-sm text-muted">Loading finite schedule…</p>
}
else if (view is null)
{
    <div class="rounded border border-dashed border-border-strong bg-surface-raised p-8 text-center text-primary">No persisted finite schedule.</div>
}
else
{
    <div class="mb-4 flex items-center gap-6 rounded border border-border bg-surface-raised px-4 py-2 text-sm">
        <div><span class="text-xs text-muted">Window </span><strong>@view.ScheduleStartUtc.ToString("dd MMM HH:mm") &rarr; @view.ScheduleEndUtc.ToString("dd MMM HH:mm")</strong></div>
        <div><span class="text-xs text-muted">Operations </span><strong>@view.OperationCount</strong></div>
        <div><span class="text-xs text-muted">Resources </span><strong>@view.ResourceCount</strong></div>
    </div>

    <section class="rounded border border-border bg-surface-raised p-3">
        <div class="grid grid-cols-[160px_1fr] border-b border-border pb-1 text-xs text-muted">
            <div>RESOURCE</div>
            <div class="relative h-4">
                @foreach (var tick in AxisTicks())
                {
                    <span class="absolute -translate-x-1/2" style="left:@(tick.LeftPercent.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))%">@tick.Time.ToString("dd MMM HH:mm")</span>
                }
            </div>
        </div>

        <div class="divide-y divide-border">
            @foreach (var lane in view.ResourceLanes)
            {
                <div class="grid grid-cols-[160px_1fr] items-center py-1.5">
                    <button type="button" class="pr-2 text-left text-xs hover:text-accent" @onclick="() => SelectResource(lane)">
                        <strong class="block text-primary">@lane.ResourceCode</strong>
                        <span class="text-muted">
                            @lane.ProcessUnitType &middot; @lane.OccupiedHours.ToString("0.##") h
                            @if (lane.SchedulingMode == ResourceSchedulingMode.Cumulative)
                            {
                                <text> &middot; peak @lane.PeakConcurrentOperations/@(lane.NominalConcurrentCapacity?.ToString("0.##") ?? "?")</text>
                            }
                        </span>
                    </button>
                    <div class="relative h-6 rounded bg-surface">
                        @foreach (var operation in lane.Operations)
                        {
                            <button type="button"
                                    class="absolute top-0.5 h-5 overflow-hidden rounded px-1 text-left text-[10px] leading-5 text-white @ProcessColor(operation.ProcessOperationType)"
                                    style="left:@(OperationLeft(operation))%;width:@(OperationWidth(operation))%"
                                    title="@OperationTitle(operation)"
                                    @onclick="() => SelectOperation(operation)">
                                @operation.ProcessOperationType
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <p class="mt-3 text-xs text-muted">This view renders the persisted solved operation assignments. Resource calendar blocks, time-fence policy and dependency edges will be added only after those exact run assumptions are snapshotted with the Plan Version.</p>
}

@code {
    private FiniteScheduleWorkspaceView? view;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.Changed += OnWorkspaceChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        view = await PlannerQuery.GetFiniteScheduleAsync(WorkspaceState.CurrentPlanVersionId);
        loading = false;
        StateHasChanged();
    }

    private void OnWorkspaceChanged()
    {
        if (view is not null && WorkspaceState.CurrentPlanVersionId != view.Plan.PlanVersionId)
            _ = InvokeAsync(LoadAsync);
    }

    private decimal OperationLeft(ScheduledProcessOperationView operation)
    {
        if (view is null) return 0m;
        var totalMinutes = Math.Max(1d, (view.ScheduleEndUtc - view.ScheduleStartUtc).TotalMinutes);
        return (decimal)Math.Clamp((operation.StartUtc - view.ScheduleStartUtc).TotalMinutes / totalMinutes * 100d, 0d, 100d);
    }

    private decimal OperationWidth(ScheduledProcessOperationView operation)
    {
        if (view is null) return 0m;
        var totalMinutes = Math.Max(1d, (view.ScheduleEndUtc - view.ScheduleStartUtc).TotalMinutes);
        var width = Math.Max(0d, (operation.EndUtc - operation.StartUtc).TotalMinutes) / totalMinutes * 100d;
        return (decimal)Math.Clamp(width, .5d, 100d);
    }

    private IReadOnlyCollection<AxisTick> AxisTicks()
    {
        if (view is null) return Array.Empty<AxisTick>();
        const int count = 6;
        var span = view.ScheduleEndUtc - view.ScheduleStartUtc;
        return Enumerable.Range(0, count + 1)
            .Select(i => new AxisTick(view.ScheduleStartUtc + TimeSpan.FromTicks(span.Ticks * i / count), i * 100d / count))
            .ToArray();
    }

    private void SelectOperation(ScheduledProcessOperationView operation) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Operation, operation.OperationSnapshotId, operation.PlanningKey));

    private void SelectResource(ScheduleResourceLaneView lane) =>
        WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Resource, lane.ResourceId, lane.ResourceCode));

    private static string ProcessColor(ProcessOperationType type) => type switch
    {
        ProcessOperationType.Eaf => "bg-process-eaf",
        ProcessOperationType.Lrf => "bg-process-lrf",
        ProcessOperationType.Vd => "bg-process-vd",
        ProcessOperationType.Ccm => "bg-process-casting",
        ProcessOperationType.Reheat => "bg-warning-soft0",
        ProcessOperationType.HotRoll or ProcessOperationType.ColdRoll => "bg-process-hot-roll",
        ProcessOperationType.Finish => "bg-process-finishing",
        _ => "bg-surface0"
    };

    private static string OperationTitle(ScheduledProcessOperationView op) =>
        $"{op.ProcessOperationType} · {op.ResourceCode} · {op.StartUtc:dd MMM HH:mm} → {op.EndUtc:dd MMM HH:mm} · {op.QuantityMt:0.##} MT · {op.GradeCode}/{op.CrossSectionCode}";

    private sealed record AxisTick(DateTime Time, double LeftPercent);

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}
