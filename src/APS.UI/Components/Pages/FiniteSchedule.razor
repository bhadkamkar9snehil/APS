@page "/"
@page "/plan/schedule"
@implements IAsyncDisposable
@inject IPlannerWorkspaceQueryService PlannerQuery
@inject IPlanningWorkbenchCommandService Commands
@inject IPlanningLifecycleService Lifecycle
@inject IPersistedPlanReleaseService ReleaseService
@inject PlannerWorkspaceState WorkspaceState
@inject PlannerCockpitState Cockpit
@inject IJSRuntime JS

<PageTitle>Planning Workbench - APS</PageTitle>

<div @ref="workbenchRoot" class="flex h-full min-h-0 flex-col overflow-hidden bg-canvas" data-aps-workbench tabindex="-1" @onkeydown="HandleWorkbenchKeyDown">
    @if (loading)
    {
        <div class="flex flex-1 flex-col gap-px overflow-hidden bg-border p-px">
            <div class="aps-shimmer h-12 bg-surface"></div>
            @for (var i = 0; i < 6; i++)
            {
                <div class="aps-shimmer h-16 bg-surface" style="animation-delay:@(i * 90)ms"></div>
            }
        </div>
    }
    else if (workbench is null)
    {
        <div class="grid flex-1 place-items-center p-8">
            <div class="max-w-md rounded-surface border border-dashed border-border-strong bg-surface p-8 text-center shadow-soft">
                <strong>No active plan to schedule</strong>
                <p class="mt-2 text-sm text-secondary">Create a Plan Version first. The workbench always edits a persisted plan and preserves its baseline.</p>
                <a href="/plan/versions" class="mt-4 inline-flex rounded-control bg-accent px-4 py-2 font-medium text-accent-foreground">Open Plan Versions</a>
            </div>
        </div>
    }
    else
    {
        <WorkbenchScenarioHeader ScenarioName="@ScenarioName"
                                 StateLabel="@ScenarioStateLabel"
                                 StateClass="@ScenarioStateClass"
                                 IsReleased="@workbench.Plan.IsReleased"
                                 CanEdit="@(state.CanEditSchedule && !acting)"
                                 IsBusy="@acting"
                                 CanUndo="@CanUndo"
                                 CanRedo="@CanRedo"
                                 CanRelease="@CanRelease"
                                 OperationCount="@workbench.Schedule.OperationCount"
                                 ResourceCount="@workbench.Schedule.ResourceCount"
                                 ScheduleStartUtc="@workbench.Schedule.ScheduleStartUtc"
                                 ScheduleEndUtc="@workbench.Schedule.ScheduleEndUtc"
                                 ActualsTimeUtc="@workbench.Plan.ReferenceTimeUtc"
                                 Undo="UndoAsync"
                                 Redo="RedoAsync"
                                 Optimize="ReplanAsync"
                                 Validate="ValidateScenario"
                                 Release="ReleaseAsync" />

        <div class="flex shrink-0 items-center border-b border-border bg-surface-raised px-3">
            <WorkbenchLifecycleRail Mode="@state.Mode" IsReleased="@workbench.Plan.IsReleased" ModeChanged="SetMode" StartPlanning="StartPlanningScenario" StartRecovery="StartRecovery" />
            <div class="ml-auto hidden text-right text-[10px] text-muted xl:block">
                <span class="block">Objective profile</span><strong class="text-primary">Delivery reliability</strong>
            </div>
        </div>

        <header class="shrink-0 border-b border-border bg-surface px-4 py-2 shadow-soft">
            <div class="flex flex-wrap items-center gap-2">
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="() => state.Pan(-0.75)">Earlier</button>
                @foreach (var zoom in Enum.GetValues<PlanningWorkbenchZoom>())
                {
                    <button class="rounded-control border px-2 py-1 text-xs @(state.Zoom == zoom ? "border-accent bg-accent-soft text-accent" : "border-border")" @onclick="() => state.SetZoom(zoom)">@ZoomLabel(zoom)</button>
                }
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="() => state.Pan(0.75)">Later</button>
                <span class="mx-1 h-5 w-px bg-border"></span>
                <div class="flex min-w-52 flex-1 gap-1 md:max-w-80">
                    <input value="@state.SearchText" @oninput="SearchChanged" class="min-w-0 flex-1 rounded-control border border-border bg-surface-raised px-3 py-1.5 text-xs" placeholder="Find order, campaign, grade or resource" />
                    @if (HasFocus)
                    {
                        <button type="button" class="rounded-control border border-border px-2 text-xs text-accent" @onclick="ClearFocus">Clear</button>
                    }
                </div>
                <ToggleButton Active="state.ShowBaseline" Label="Baseline" OnClick="state.ToggleBaseline" />
                <ToggleButton Active="state.ShowDependencies" Label="Selected chain" OnClick="state.ToggleDependencies" />
                <ToggleButton Active="state.ShowCriticalPath" Label="Tight chain" OnClick="state.ToggleCriticalPath" />
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="Cockpit.ToggleQueue">@(Cockpit.QueueOpen ? "Hide queue" : "Demand queue")</button>
                <button class="rounded-control border border-border px-2 py-1 text-xs" @onclick="Cockpit.ToggleInspector">@(Cockpit.InspectorOpen ? "Hide inspector" : "Inspector")</button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="shrink-0 border-b px-4 py-2 text-xs @(messageIsError ? "border-danger bg-danger-soft text-danger" : "border-success bg-success-soft text-success")">@message</div>
        }

        <div class="relative min-h-0 flex-1 overflow-hidden">
            @if (Cockpit.QueueOpen)
            {
                <aside class="absolute inset-y-0 left-0 z-40 flex min-h-0 w-80 overflow-hidden border-r border-border bg-surface shadow-raised">
                    <div class="flex min-h-0 w-full flex-col">
                    <div class="flex items-start justify-between gap-2 border-b border-border px-3 py-2">
                        <div><strong class="block text-xs">@QueueTitle</strong><span class="mt-0.5 block text-[10px] text-muted">@QueueDescription</span></div>
                        @if (HasFocus)
                        {
                            <button type="button" class="shrink-0 text-[10px] font-medium text-accent hover:underline" @onclick="ClearFocus">Clear focus</button>
                        }
                    </div>
                    <div class="min-h-0 flex-1 overflow-y-auto p-2">
                        @if (state.QueueContent == PlanningWorkbenchQueueContent.Demand)
                        {
                            @foreach (var demand in FilteredDemand())
                            {
                                <button class="mb-1 w-full rounded-control border border-transparent bg-surface-raised p-2 text-left hover:border-accent-border" @onclick="() => FocusDemand(demand)">
                                    <div class="flex justify-between gap-2"><strong class="truncate text-xs">@demand.ProductionOrderNumber</strong><span class="text-xs font-semibold">@demand.RemainingQuantityMt.ToString("0.#") MT</span></div>
                                    <div class="mt-1 truncate text-[11px] text-secondary">@demand.GradeCode · @demand.FinalCrossSectionCode · @demand.RouteCode</div>
                                    <div class="mt-1 flex justify-between text-[10px] text-muted"><span>Due @demand.RequiredDate.ToString("dd MMM HH:mm")</span><span>P@demand.Priority · @demand.Status</span></div>
                                </button>
                            }
                        }
                        else if (state.QueueContent == PlanningWorkbenchQueueContent.Campaigns)
                        {
                            @foreach (var campaign in FilteredCampaigns())
                            {
                                <button class="mb-1 w-full rounded-control border border-transparent bg-surface-raised p-2 text-left hover:border-accent-border" @onclick="() => FocusCampaign(campaign)">
                                    <div class="flex justify-between"><strong class="text-xs">@campaign.CampaignNumber</strong><span class="text-xs font-semibold">@campaign.PlannedQuantityMt.ToString("0.#") MT</span></div>
                                    <div class="mt-1 text-[11px] text-secondary">@campaign.Heats.Count heats · @campaign.GradeSequenceClassCode · @campaign.CasterSectionCode</div>
                                    <div class="mt-1 text-[10px] text-muted">Due @campaign.RequiredDate.ToString("dd MMM HH:mm")</div>
                                </button>
                            }
                        }
                        else
                        {
                            @if (FilteredExceptions().Count == 0) { <div class="rounded-control border border-dashed border-border p-4 text-center text-xs text-muted">No exceptions in this view.</div> }
                            @foreach (var exception in FilteredExceptions())
                            {
                                <button class="mb-1 w-full rounded-control border p-2 text-left @(exception.Severity == PlanningWorkbenchExceptionSeverity.Critical ? "border-danger bg-danger-soft" : "border-warning bg-warning-soft")" @onclick="() => FocusException(exception)">
                                    <div class="text-xs font-semibold">@exception.Title</div><div class="mt-1 text-[11px] text-secondary">@exception.Impact</div>
                                </button>
                            }
                        }
                    </div>
                    </div>
                </aside>
            }

            <main class="h-full min-w-0 overflow-hidden bg-canvas">
                <div class="flex h-full min-h-0 flex-col">
                    <div class="flex shrink-0 items-center justify-between border-b border-border bg-surface-raised px-3 py-2 text-xs">
                        <div class="flex gap-4"><span><span class="text-muted">Visible </span><strong>@state.VisibleStartUtc.ToString("dd MMM HH:mm") → @state.VisibleEndUtc.ToString("dd MMM HH:mm")</strong></span><span><span class="text-muted">Mode </span><strong>@ModeLabel(state.Mode)</strong></span><span><strong>@VisibleOperationCount</strong> shown</span></div>
                        @* A legend has to show the colour it's naming, not just repeat the abbreviation next to it (#UI-depth). *@
                        <div class="flex flex-wrap items-center gap-3 text-[10px] text-muted">
                            @foreach (var entry in ProcessLegend)
                            {
                                <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full @entry.ColorClass"></span>@entry.Label</span>
                            }
                        </div>
                    </div>
                    <div class="min-h-0 flex-1 overflow-auto" data-gantt-scroll>
                        <div class="h-full min-w-[900px]">
                            <div class="sticky top-0 z-30 grid grid-cols-[176px_1fr] border-b border-border bg-surface-raised shadow-soft">
                                <div class="border-r border-border px-3 py-2 text-[10px] font-semibold uppercase tracking-wide text-muted">Resource / load</div>
                                <div class="relative h-10 overflow-hidden">
                                    @foreach (var tick in AxisTicks())
                                    {
                                        <div class="absolute top-0 h-full w-px bg-border" style="left:@Percent(tick.Time)%"><span class="ml-1 whitespace-nowrap text-[10px] text-muted">@tick.Time.ToString(tick.Format)</span></div>
                                    }
                                    @foreach (var due in DueMarkers()) { <div class="absolute bottom-0 top-5 w-px bg-warning" style="left:@Percent(due.Time)%" title="@due.Label"></div> }
                                    @if (FrozenFenceEndUtc > state.VisibleStartUtc && workbench.Plan.ReferenceTimeUtc < state.VisibleEndUtc)
                                    {
                                        <div class="absolute bottom-0 top-5 w-px bg-danger" style="left:@Percent(FrozenFenceEndUtc)%" title="Frozen fence ends @FrozenFenceEndUtc.ToString("dd MMM HH:mm")"></div>
                                        @* The tinted band below reads as an unexplained smear without this - "frozen" is a real
                                           planning concept (work inside it needs an authorized override to move), not decoration. *@
                                        <span class="absolute bottom-0.5 whitespace-nowrap rounded bg-danger px-1 text-[9px] font-semibold text-inverted" style="left:@Percent(workbench.Plan.ReferenceTimeUtc)%">Frozen</span>
                                    }
                                </div>
                            </div>
                            <div class="aps-gantt-lanes relative" style="@($"--aps-visible-lanes: {Math.Max(1, VisibleLanes.Count)}")">
                                @if (state.ShowDependencies && state.SelectedPlanningKey is not null)
                                {
                                    <svg class="pointer-events-none absolute inset-0 z-20 h-full w-full overflow-visible" aria-hidden="true">
                                        @foreach (var edge in FocusedDependencyLines()) { <line x1="calc(176px + (100% - 176px) * @(edge.X1 / 100d))" y1="@($"{edge.Y1}%")" x2="calc(176px + (100% - 176px) * @(edge.X2 / 100d))" y2="@($"{edge.Y2}%")" stroke="var(--aps-border-strong)" stroke-width="1" stroke-dasharray="3 3" /> }
                                    </svg>
                                }
                                @for (var laneIndex = 0; laneIndex < VisibleLanes.Count; laneIndex++)
                                {
                                    var lane = VisibleLanes[laneIndex];
                                    <div class="aps-gantt-lane grid grid-cols-[176px_1fr] border-b border-border @(laneIndex % 2 == 0 ? "bg-surface" : "bg-surface-raised")" data-resource-id="@lane.ResourceId">
                                        <button class="sticky left-0 z-10 border-r border-border bg-inherit px-3 py-2 text-left hover:bg-surface-hover" @onclick="() => SelectResource(lane)">
                                            <span class="flex justify-between gap-2"><strong class="text-xs">@lane.ResourceCode</strong><em class="not-italic text-[10px] @OperatingStateClass(lane.OperatingState)">@lane.OperatingState</em></span>
                                            <span class="block truncate text-[10px] text-muted">@lane.ProcessUnitType · @lane.OccupiedHours.ToString("0.#") h · @lane.Operations.Count ops</span>
                                        </button>
                                        <div class="aps-time-grid relative h-full overflow-hidden" data-window-start="@state.VisibleStartUtc.ToString("O")" data-window-end="@state.VisibleEndUtc.ToString("O")">
                                            @foreach (var tick in AxisTicks()) { <div class="pointer-events-none absolute inset-y-0 w-px bg-border/50" style="left:@Percent(tick.Time)%"></div> }
                                            @if (FrozenFenceEndUtc > state.VisibleStartUtc && workbench.Plan.ReferenceTimeUtc < state.VisibleEndUtc) { <div class="pointer-events-none absolute inset-y-0 bg-danger-soft/45" style="left:@Percent(workbench.Plan.ReferenceTimeUtc)%;width:@WidthPercent(workbench.Plan.ReferenceTimeUtc, FrozenFenceEndUtc)%" title="Frozen planning fence"></div> }
                                            @if (state.ShowBaseline && workbench.Comparison is not null)
                                            {
                                                @foreach (var baseline in BaselineBlocks(lane.ResourceCode)) { <div class="pointer-events-none absolute inset-y-2 rounded border border-dashed border-border-strong bg-surface-inset/40" style="left:@Percent(baseline.Start)%;width:@WidthPercent(baseline.Start, baseline.End)%" title="Baseline position"></div> }
                                            }
                                            @foreach (var operation in VisibleOperations(lane))
                                            {
                                                var selected = state.SelectedPlanningKey == operation.PlanningKey;
                                                var opDetail = FindDetail(operation.PlanningKey);
                                                var execution = opDetail?.ExecutionStatus ?? OperationExecutionStatus.Planned;
                                                var frozenHere = FrozenFenceEndUtc > operation.StartUtc && workbench.Plan.ReferenceTimeUtc < operation.EndUtc;
                                                var tight = state.ShowCriticalPath && IsTightChain(operation);
                                                var singleSourced = opDetail is { ResourceOptions.Count: 1 };
                                                <button class="aps-operation aps-op-card absolute inset-y-2 z-10 min-w-2 overflow-hidden rounded-control border px-1.5 py-1 text-left text-[10px] leading-tight @(ProcessClass(operation.ProcessOperationType)) @(ExecutionClass(execution)) @(selected ? "border-accent ring-2 ring-accent" : "border-transparent hover:border-primary") @(state.StagedMove?.PlanningKey == operation.PlanningKey ? "opacity-55" : "") @(tight ? "ring-2 ring-warning" : "")"
                                                        style="left:calc(@Percent(operation.StartUtc)% + 1px);width:calc(@WidthPercent(operation.StartUtc, operation.EndUtc)% - 2px)" data-planning-key="@operation.PlanningKey" title="@OperationTitle(operation)" @onclick="() => SelectOperation(operation)">
                                                    <span class="flex items-start justify-between gap-1">
                                                        <strong class="aps-truncate-start min-w-0 text-inverted">@OperationBlockLabel(operation)</strong>
                                                        <span class="flex shrink-0 items-center gap-0.5">
                                                            @if (execution == OperationExecutionStatus.Running) { <span class="aps-pulse-dot h-1.5 w-1.5 rounded-full bg-inverted" title="Running now"></span> }
                                                            else if (execution == OperationExecutionStatus.Completed) { <span class="aps-op-card__badge text-inverted" title="Completed">&#10003;</span> }
                                                            @if (frozenHere) { <span class="aps-op-card__badge text-inverted" title="Inside the frozen fence - needs an authorized override to move">&#128274;</span> }
                                                            @if (tight) { <span class="aps-op-card__badge text-inverted" title="Tight chain - no slack to its predecessor">&#9889;</span> }
                                                            @if (singleSourced) { <span class="aps-op-card__badge text-inverted" title="Only one eligible resource - no fallback if this slips">!</span> }
                                                        </span>
                                                    </span>
                                                    <span class="flex items-baseline justify-between gap-1 text-inverted/85">
                                                        <span class="min-w-0 truncate">@operation.StartUtc.ToString("HH:mm")&ndash;@operation.EndUtc.ToString("HH:mm")</span>
                                                        <span class="shrink-0 font-semibold">@operation.QuantityMt.ToString("0.#") MT</span>
                                                    </span>
                                                    <span class="flex items-baseline justify-between gap-1 text-inverted/70">
                                                        <span class="min-w-0 truncate">@operation.GradeCode</span>
                                                        @if (state.Mode == PlanningWorkbenchMode.Execution) { <span class="shrink-0 truncate">@execution</span> }
                                                        else if (opDetail?.CampaignNumber is not null) { <span class="shrink-0 truncate">Heat @(opDetail.HeatSequenceNumber?.ToString("00"))</span> }
                                                    </span>
                                                    @if (execution == OperationExecutionStatus.Running)
                                                    {
                                                        <span class="aps-op-card__progress" style="--aps-op-progress:@(RunningProgressPercent(operation))%"></span>
                                                    }
                                                </button>
                                            }
                                            @if (state.StagedMove is not null && state.StagedMove.TargetResourceId == lane.ResourceId)
                                            {
                                                var source = FindOperation(state.StagedMove.PlanningKey);
                                                @if (source is not null) { <div class="pointer-events-none absolute inset-y-2 z-20 rounded-control border-2 border-accent bg-accent-soft/70" style="left:@Percent(state.StagedMove.TargetStartUtc)%;width:@WidthPercent(state.StagedMove.TargetStartUtc, state.StagedMove.TargetStartUtc + (source.EndUtc - source.StartUtc))%"><span class="px-1 text-[10px] font-semibold text-accent">Proposed · @state.StagedMove.TargetStartUtc.ToString("HH:mm")</span></div> }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </main>

            @if (Cockpit.InspectorOpen)
            {
                <aside class="absolute inset-y-0 right-0 z-40 flex min-h-0 w-[22.5rem] flex-col bg-surface shadow-popover">
                    <div class="flex justify-between border-b border-border bg-surface-raised px-3 py-2 shadow-soft"><strong class="aps-text-label">Planner inspector</strong><button class="aps-text-caption hover:text-primary" @onclick="Cockpit.ToggleInspector">Close</button></div>
                    <div class="min-h-0 flex-1 overflow-y-auto p-3">
                        @if (SelectedOperation is null)
                        {
                            <div class="aps-page flex flex-col items-center gap-2 border border-dashed border-border-strong p-6 text-center">
                                <span class="text-2xl text-muted" aria-hidden="true">&#8963;</span>
                                <p class="aps-text-body text-secondary">Select or drag an operation to inspect, move, or reassign it.</p>
                            </div>
                            <PlanningControls NominalHeatMt="nominalHeatMt" NominalHeatMtChanged="v => nominalHeatMt = v" MaximumCampaignMt="maximumCampaignMt" MaximumCampaignMtChanged="v => maximumCampaignMt = v" FrozenMinutes="frozenMinutes" FrozenMinutesChanged="v => frozenMinutes = v" SolverSeconds="solverSeconds" SolverSecondsChanged="v => solverSeconds = v" OnRecalculate="ReplanAsync" Disabled="acting" />
                        }
                        else
                        {
                            var operation = SelectedOperation;
                            var detail = SelectedDetail;
                            <section class="aps-page p-3">
                                <div class="flex justify-between gap-3">
                                    <div><h2 class="aps-text-heading">@operation.ProcessOperationType · @operation.GradeCode</h2><p class="aps-text-caption">@operation.CrossSectionCode · @operation.QuantityMt.ToString("0.#") MT</p></div>
                                    <span class="h-fit rounded px-2 py-0.5 aps-text-caption @CommitmentStateClass(detail?.CommitmentState)">@(detail?.CommitmentState.ToString() ?? "Planned")</span>
                                </div>

                                @* Grouped instead of one flat 11-row list (#UI-depth): plan vs actuals vs lineage answer
                                   different questions, and running them together made "hasn't happened yet" read the
                                   same as "this is the plan." *@
                                <div class="mt-3 rounded-control bg-surface-inset p-2">
                                    <div class="aps-text-label mb-1.5">Plan</div>
                                    <dl class="grid grid-cols-[80px_1fr] gap-y-1">
                                        <dt class="aps-text-caption">Resource</dt><dd class="aps-text-figure text-xs">@operation.ResourceCode</dd>
                                        <dt class="aps-text-caption">Start</dt><dd class="aps-text-body">@operation.StartUtc.ToString("dd MMM yyyy HH:mm")</dd>
                                        <dt class="aps-text-caption">End</dt><dd class="aps-text-body">@operation.EndUtc.ToString("dd MMM yyyy HH:mm")</dd>
                                    </dl>
                                </div>

                                <div class="mt-2 rounded-control bg-surface-inset p-2">
                                    <div class="aps-text-label mb-1.5">Actuals</div>
                                    <dl class="grid grid-cols-[80px_1fr] gap-y-1">
                                        <dt class="aps-text-caption">Execution</dt><dd class="aps-text-body font-medium">@(detail?.ExecutionStatus.ToString() ?? "Planned")</dd>
                                        <dt class="aps-text-caption">Actual start</dt><dd class="@ActualValueClass(detail?.ActualStartUtc)">@FormatActual(detail?.ActualStartUtc)</dd>
                                        <dt class="aps-text-caption">Actual end</dt><dd class="@ActualValueClass(detail?.ActualEndUtc)">@FormatActual(detail?.ActualEndUtc)</dd>
                                        <dt class="aps-text-caption">Output</dt><dd class="aps-text-figure text-xs">@((detail?.ActualQuantityMt ?? 0m).ToString("0.#")) MT</dd>
                                    </dl>
                                </div>

                                <div class="mt-2 rounded-control bg-surface-inset p-2">
                                    <div class="aps-text-label mb-1.5">Lineage</div>
                                    <dl class="grid grid-cols-[80px_1fr] gap-y-1">
                                        <dt class="aps-text-caption">Campaign</dt><dd class="aps-text-body">@CampaignLabel(detail)</dd>
                                        <dt class="aps-text-caption">Orders</dt><dd class="aps-text-body">@OrderLabel(detail)</dd>
                                        <dt class="aps-text-caption">Predecessors</dt><dd class="aps-text-body">@(detail?.PredecessorPlanningKeys.Count ?? 0)</dd>
                                    </dl>
                                </div>
                            </section>

                            @* Its own elevated card, not a continuation of the read-only details above - this is
                               where the planner acts, and it should look like a distinct zone (#UI-depth). *@
                            <section class="aps-page mt-3 p-3">
                                <h3 class="aps-text-heading">Move or reassign</h3>
                                @if (!CanMoveSelectedOperation)
                                {
                                    <div class="mt-3 rounded-control bg-surface-inset p-3 aps-text-body text-secondary">@MoveRestrictionMessage</div>
                                }
                                <label class="mt-3 block aps-text-label">Eligible resource<select @bind="targetResourceText" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50">@foreach (var option in EligibleResources(operation, detail)) { <option value="@option.ResourceId">@option.ResourceCode · @option.ResourceName</option> }</select></label>
                                <label class="mt-2 block aps-text-label">Target start (UTC)<input type="datetime-local" value="@targetStartText" @onchange="TargetStartChanged" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50" /></label>
                                <label class="mt-2 block aps-text-label">Reason<select @bind="moveReason" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50"><option value="PLANNER_SEQUENCE">Sequence optimization</option><option value="RESOURCE_BALANCE">Resource balancing</option><option value="CUSTOMER_PRIORITY">Customer priority</option><option value="BREAKDOWN_RECOVERY">Breakdown recovery</option><option value="MATERIAL_AVAILABILITY">Material availability</option></select></label>
                                <label class="mt-2 block aps-text-label">Planner note<textarea @bind="moveComment" rows="2" disabled="@(!CanMoveSelectedOperation)" class="mt-1 w-full resize-none rounded-control border border-border bg-surface-raised px-2 py-2 aps-text-body disabled:opacity-50" placeholder="Why this change is needed"></textarea></label>
                                <label class="mt-2 flex gap-2 aps-text-body"><input type="checkbox" @bind="allowFrozenOverride" disabled="@(!CanMoveSelectedOperation)" /><span><strong>Authorized disruption override</strong><small class="block aps-text-caption">Required inside the frozen fence.</small></span></label>
                                <div class="mt-3 grid grid-cols-2 gap-2"><button class="rounded-control border border-border-strong px-3 py-2 aps-text-heading disabled:opacity-40" @onclick="PreviewMoveAsync" disabled="@(acting || !CanMoveSelectedOperation)">Preview impact</button><button class="rounded-control bg-accent px-3 py-2 aps-text-heading text-accent-foreground shadow-soft disabled:opacity-40 disabled:shadow-none" @onclick="ApplyMoveAsync" disabled="@(acting || !CanMoveSelectedOperation || state.Impact?.CanApply != true)">Apply move</button></div>
                            </section>
                        }
                    </div>
                </aside>
            }
        </div>

        @if (state.StagedMove is not null || state.Impact is not null)
        {
            <section class="shrink-0 border-t border-border bg-surface-raised px-4 py-3 shadow-raised">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="min-w-44"><span class="block text-[10px] uppercase tracking-wide text-muted">Proposed change</span><strong class="text-xs">@FriendlyOperationName(state.StagedMove?.PlanningKey)</strong></div>
                    @if (state.Impact is not null)
                    {
                        <div><span class="block text-[10px] text-muted">From</span><strong class="text-xs">@state.Impact.SourceResourceCode · @state.Impact.SourceStartUtc.ToString("dd MMM HH:mm")</strong></div><div><span class="block text-[10px] text-muted">To</span><strong class="text-xs text-accent">@state.Impact.TargetResourceCode · @state.Impact.TargetStartUtc.ToString("dd MMM HH:mm")</strong></div><div><span class="block text-[10px] text-muted">Movement</span><strong class="text-xs">@FormatMovement(state.Impact.MovementMinutes)</strong></div>
                        <div class="min-w-0 flex-1">@foreach (var finding in state.Impact.Findings) { <span class="mr-1 inline-flex rounded px-2 py-1 text-[10px] @(FindingClass(finding.Severity))">@finding.Message</span> }</div>
                        <button class="rounded-control bg-accent px-4 py-2 text-xs font-semibold text-accent-foreground disabled:opacity-40" @onclick="ApplyMoveAsync" disabled="@(acting || !state.Impact.CanApply)">Apply and repair plan</button>
                    }
                    else
                    {
                        <div class="flex flex-1 items-center gap-3">
                            <span class="text-xs text-muted">Previewing constraint and downstream schedule impact…</span>
                            <span class="aps-shimmer h-2 w-24 rounded-full"></span>
                        </div>
                    }
                    <button class="rounded-control border border-border px-3 py-2 text-xs" @onclick="state.ClearMove">Cancel</button>
                </div>
            </section>
        }

        <WorkbenchAnalysisDock Expanded="@Cockpit.AnalysisDockOpen"
                               View="@Cockpit.AnalysisView"
                               CriticalCount="@workbench.Queue.CriticalExceptions"
                               WarningCount="@workbench.Queue.WarningExceptions"
                               LateDemand="@workbench.Queue.LateDemand"
                               ViewChanged="Cockpit.OpenAnalysis"
                               Toggle="Cockpit.ToggleAnalysis" />
    }
</div>

@code {
    private readonly PlanningWorkbenchState state = new();
    private PlanningWorkbenchView? workbench;
    private ElementReference workbenchRoot;
    private DotNetObjectReference<FiniteSchedule>? selfReference;
    private bool loading = true, acting, dragInitialized, messageIsError;
    private string? message, moveComment;
    private string targetResourceText = "", targetStartText = "", moveReason = "PLANNER_SEQUENCE";
    private bool allowFrozenOverride;
    private decimal nominalHeatMt = 90m, maximumCampaignMt = 600m;
    private int frozenMinutes = 120, solverSeconds = 20;
    private readonly Stack<(Guid Previous, Guid Current)> undoHistory = new();
    private readonly Stack<(Guid Previous, Guid Current)> redoHistory = new();

    private IReadOnlyList<ScheduleResourceLaneView> VisibleLanes => BuildVisibleLanes();
    private ScheduledProcessOperationView? SelectedOperation => FindOperation(state.SelectedPlanningKey);
    private PlanningOperationWorkbenchDetail? SelectedDetail => FindDetail(state.SelectedPlanningKey);
    private int VisibleOperationCount => VisibleLanes.Sum(x => VisibleOperations(x).Count);
    private bool CanUndo => undoHistory.Count > 0;
    private bool CanRedo => redoHistory.Count > 0;
    private bool CanMoveSelectedOperation => state.CanEditSchedule && SelectedDetail?.ExecutionStatus is not OperationExecutionStatus.Completed and not OperationExecutionStatus.Running;
    private string MoveRestrictionMessage => !state.CanEditSchedule
        ? "This released baseline is read-only. Create a planning or recovery scenario to change future work."
        : SelectedDetail?.ExecutionStatus == OperationExecutionStatus.Completed
            ? "Completed work is fixed to its actual result and cannot be moved."
            : "Running work is protected. Repair the future schedule around it instead of moving it.";
    private bool CanRelease => !acting && !workbench!.Plan.IsReleased && workbench.Plan.Status == PlanVersionStatus.Feasible;
    private string ScenarioName => state.ScenarioIntent == PlanningScenarioIntent.Recovery
        ? $"Recovery · {workbench!.Plan.ReferenceTimeUtc:dd MMM HH:mm}"
        : state.ScenarioIntent == PlanningScenarioIntent.Clone
            ? $"Working scenario · {FriendlyPlanName(workbench!.Plan.VersionNumber)}"
        : FriendlyPlanName(workbench!.Plan.VersionNumber);
    private string ScenarioStateLabel => state.ScenarioIntent switch { PlanningScenarioIntent.Recovery => "Recovery draft", PlanningScenarioIntent.Clone => "Working draft", PlanningScenarioIntent.New => "New draft", _ => workbench!.Plan.Status.ToString() };
    private string ScenarioStateClass => workbench!.Plan.Status == PlanVersionStatus.Feasible ? "bg-success-soft text-success" : workbench.Plan.IsReleased ? "bg-info-soft text-info" : "bg-warning-soft text-warning";
    private DateTime FrozenFenceEndUtc => workbench?.Plan.ReferenceTimeUtc.AddMinutes(frozenMinutes) ?? DateTime.MinValue;

    protected override async Task OnInitializedAsync() { WorkspaceState.Changed += OnWorkspaceChanged; state.Changed += OnStateChanged; Cockpit.Changed += OnStateChanged; Cockpit.CommandRequested += OnCockpitCommandRequested; await LoadAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (workbench is null || dragInitialized) return; selfReference ??= DotNetObjectReference.Create(this); await JS.InvokeVoidAsync("apsPlanningWorkbench.initialize", workbenchRoot, selfReference); dragInitialized = true; }

    private async Task LoadAsync(Guid? planId = null, Guid? baselineId = null)
    {
        loading = true; dragInitialized = false; StateHasChanged();
        try { workbench = await PlannerQuery.GetPlanningWorkbenchAsync(planId ?? WorkspaceState.CurrentPlanVersionId, baselineId ?? WorkspaceState.BaselinePlanVersionId); if (workbench is not null) { state.SetReleasedPlan(workbench.Plan.IsReleased); state.SetPlanWindow(workbench.Plan.HorizonStartUtc, workbench.Plan.HorizonEndUtc, workbench.Schedule.ScheduleStartUtc, workbench.Schedule.ScheduleEndUtc); WorkspaceState.SetPlan(workbench.Plan.PlanVersionId, workbench.Baseline?.PlanVersionId ?? workbench.Plan.ParentPlanVersionId); WorkspaceState.SetWindow(workbench.Plan.HorizonStartUtc, workbench.Plan.HorizonEndUtc); } }
        catch (Exception ex) { SetMessage(ex.Message, true); }
        finally { loading = false; }
    }

    private void OnWorkspaceChanged() { if (workbench is not null && WorkspaceState.CurrentPlanVersionId != workbench.Plan.PlanVersionId) _ = InvokeAsync(() => LoadAsync(WorkspaceState.CurrentPlanVersionId, WorkspaceState.BaselinePlanVersionId)); }
    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);
    private void OnCockpitCommandRequested(PlannerCockpitCommand command) => _ = InvokeAsync(async () =>
    {
        switch (command)
        {
            case PlannerCockpitCommand.Optimize: await ReplanAsync(); break;
            case PlannerCockpitCommand.Validate: ValidateScenario(); break;
            case PlannerCockpitCommand.Release: await ReleaseAsync(); break;
            case PlannerCockpitCommand.CreateRecoveryScenario: StartRecovery(); break;
            case PlannerCockpitCommand.CreateScenario: StartPlanningScenario(); break;
        }
    });
    private void SetMode(PlanningWorkbenchMode mode)
    {
        if (mode == PlanningWorkbenchMode.Recovery && state.CanStartRecovery) { StartRecovery(); return; }
        state.SetMode(mode);
    }
    private void StartRecovery() { state.StartRecovery(); SetMessage("Recovery scenario started from the released baseline. Completed work remains fixed and future work can now be repaired.", false); }
    private void StartPlanningScenario() { state.StartPlanningScenario(); SetMessage("Working scenario created from the released baseline. The released plan remains unchanged until a new scenario is validated and released.", false); }
    private void ValidateScenario()
    {
        if (workbench is null) return;
        var critical = workbench.Exceptions.Count(x => x.Severity == PlanningWorkbenchExceptionSeverity.Critical);
        var feasible = workbench.Plan.Status is PlanVersionStatus.Feasible or PlanVersionStatus.Released;
        SetMessage(critical == 0 && feasible
            ? "Validation passed: the scenario is feasible and has no critical planning exceptions."
            : $"Validation found {critical} critical planning exception(s). Resolve them before approval or release.", critical > 0 || !feasible);
    }
    private void SearchChanged(ChangeEventArgs args) => state.SetSearch(args.Value?.ToString());
    private void ClearFocus() { state.ClearFocus(); WorkspaceState.ClearSelection(); }
    private void HandleWorkbenchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (Cockpit.OpenDrawer != PlannerCockpitDrawer.None) Cockpit.CloseTransientPanels();
        else ClearFocus();
    }
    private void TargetStartChanged(ChangeEventArgs args) => targetStartText = args.Value?.ToString() ?? string.Empty;

    private void SelectOperation(ScheduledProcessOperationView operation) { state.SelectOperation(operation.PlanningKey); WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Operation, operation.OperationSnapshotId, FriendlyOperationName(operation.PlanningKey))); targetResourceText = operation.ResourceId.ToString(); targetStartText = operation.StartUtc.ToString("yyyy-MM-ddTHH:mm"); moveComment = null; allowFrozenOverride = false; }
    private void SelectResource(ScheduleResourceLaneView lane) => WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Resource, lane.ResourceId, lane.ResourceCode));
    private void FocusDemand(DemandSupplyRowView demand) { state.SetSearch(demand.ProductionOrderNumber); var detail = workbench?.OperationDetails.FirstOrDefault(x => x.ProductionOrderNumbers.Contains(demand.ProductionOrderNumber, StringComparer.OrdinalIgnoreCase)); var operation = FindOperation(detail?.PlanningKey); if (operation is not null) SelectOperation(operation); }
    private void FocusCampaign(CampaignView campaign) { state.SetSearch(campaign.CampaignNumber); var detail = workbench?.OperationDetails.FirstOrDefault(x => x.CampaignNumber == campaign.CampaignNumber); var operation = FindOperation(detail?.PlanningKey); if (operation is not null) SelectOperation(operation); }
    private void FocusException(PlanningWorkbenchException exception) { state.SetSearch(exception.Entity?.DisplayCode ?? exception.Title); }

    [JSInvokable]
    public async Task StageDraggedMove(string planningKey, string resourceId, double ratio)
    {
        if (!state.CanEditSchedule) return;
        var draggedDetail = FindDetail(planningKey);
        if (draggedDetail?.ExecutionStatus is OperationExecutionStatus.Completed or OperationExecutionStatus.Running) return;
        if (!Guid.TryParse(resourceId, out var targetResourceId)) return; var operation = FindOperation(planningKey); if (operation is null) return; SelectOperation(operation);
        var minutes = (state.VisibleEndUtc - state.VisibleStartUtc).TotalMinutes * Math.Clamp(ratio, 0d, 1d); var targetStart = state.VisibleStartUtc.AddMinutes(Math.Round(minutes / 15d) * 15d);
        targetResourceText = targetResourceId.ToString(); targetStartText = targetStart.ToString("yyyy-MM-ddTHH:mm"); await PreviewMoveAsync();
    }

    private async Task PreviewMoveAsync() { var proposal = BuildProposal(); if (proposal is null) return; acting = true; message = null; try { state.StageMove(proposal); state.SetImpact(await Commands.ValidateMoveAsync(proposal)); } catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; } }
    private async Task ApplyMoveAsync()
    {
        if (workbench is null) return; var proposal = state.StagedMove ?? BuildProposal(); if (proposal is null) return; acting = true; message = null;
        try { var result = await Commands.ApplyMoveAsync(new PlanningMoveApplyRequest(proposal, BuildPlanningRequest(), new PlanningTimeFencePolicy(frozenMinutes))); if (!result.Replan.Plan.IsFeasible) throw new InvalidOperationException("The move could not produce a feasible repaired plan. The current plan remains unchanged."); var previous = workbench.Plan.PlanVersionId; var current = result.Replan.Version.PlanVersionId; undoHistory.Push((previous, current)); redoHistory.Clear(); state.ClearMove(); SetMessage("Move applied. A repaired child Plan Version is now active.", false); await LoadAsync(current, previous); }
        catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; }
    }

    private async Task ReplanAsync()
    {
        if (workbench is null) return; acting = true; message = null;
        try { var previous = workbench.Plan.PlanVersionId; var result = await Lifecycle.ReplanAsync(previous, new PlanningRecalculationRequest(BuildPlanningRequest(), new PlanningTimeFencePolicy(frozenMinutes), workbench.Plan.ReferenceTimeUtc, PlanTriggerType.Manual, "Planner workbench recalculation")); if (!result.Plan.IsFeasible) throw new InvalidOperationException("Recalculation produced an infeasible candidate. The current plan remains active."); undoHistory.Push((previous, result.Version.PlanVersionId)); redoHistory.Clear(); SetMessage("Plan recalculated. Review changes against the baseline before release.", false); await LoadAsync(result.Version.PlanVersionId, previous); }
        catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; }
    }

    private async Task ReleaseAsync() { if (workbench is null) return; acting = true; try { var release = await ReleaseService.ReleaseAsync(workbench.Plan.PlanVersionId); SetMessage($"Plan released as {release.WorkOrders.Count} work orders.", false); await LoadAsync(workbench.Plan.PlanVersionId, workbench.Baseline?.PlanVersionId); } catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; } }
    private async Task UndoAsync() { if (!undoHistory.TryPop(out var entry)) return; redoHistory.Push(entry); await LoadAsync(entry.Previous, null); SetMessage("Showing the previous Plan Version. No planning data was deleted.", false); }
    private async Task RedoAsync() { if (!redoHistory.TryPop(out var entry)) return; undoHistory.Push(entry); await LoadAsync(entry.Current, entry.Previous); SetMessage("Showing the reapplied child Plan Version.", false); }

    private PlanningMoveProposal? BuildProposal()
    {
        if (workbench is null || SelectedOperation is null) return null;
        if (!Guid.TryParse(targetResourceText, out var resourceId)) { SetMessage("Select an eligible target resource.", true); return null; }
        if (!DateTime.TryParse(targetStartText, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, out var start)) { SetMessage("Enter a valid target start.", true); return null; }
        return new PlanningMoveProposal(workbench.Plan.PlanVersionId, SelectedOperation.PlanningKey, resourceId, DateTime.SpecifyKind(start, DateTimeKind.Utc), moveReason, moveComment, allowFrozenOverride);
    }

    private PlanningCalculationRequest BuildPlanningRequest() => new(new PlanningDemandSelection(), new CampaignPlanningPolicy(nominalHeatMt, nominalHeatMt * .7m, nominalHeatMt * 1.15m, maximumCampaignMt, maximumCampaignMt), new ProductionStructurePlanningPolicy(), workbench?.Plan.HorizonStartUtc ?? DateTime.UtcNow, workbench?.Plan.HorizonEndUtc ?? DateTime.UtcNow.AddDays(7), solverSeconds);
    private IReadOnlyList<ScheduleResourceLaneView> BuildVisibleLanes() { if (workbench is null) return Array.Empty<ScheduleResourceLaneView>(); var lanes = workbench.Schedule.ResourceLanes.Where(l => l.Operations.Any(op => OperationMatches(op, state.SearchText))).ToArray(); if (state.Mode == PlanningWorkbenchMode.Recovery) { var resourceIds = workbench.Exceptions.Where(x => x.Entity?.EntityType == PlannerEntityType.Resource).Select(x => x.Entity!.EntityId).ToHashSet(); var constrained = lanes.Where(x => resourceIds.Contains(x.ResourceId) || x.OperatingState != ResourceOperatingState.Available).ToArray(); if (constrained.Length > 0) lanes = constrained; } return lanes.OrderBy(x => x.ProcessUnitType).ThenBy(x => x.ResourceCode).ToArray(); }
    private IReadOnlyList<ScheduledProcessOperationView> VisibleOperations(ScheduleResourceLaneView lane) => lane.Operations.Where(x => x.EndUtc > state.VisibleStartUtc && x.StartUtc < state.VisibleEndUtc && OperationMatches(x, state.SearchText)).OrderBy(x => x.StartUtc).ToArray();
    private bool OperationMatches(ScheduledProcessOperationView op, string query) { if (string.IsNullOrWhiteSpace(query)) return true; var d = FindDetail(op.PlanningKey); return Contains(op.ResourceCode, query) || Contains(op.ResourceName, query) || Contains(op.GradeCode, query) || Contains(op.CrossSectionCode, query) || Contains(op.ProcessOperationType.ToString(), query) || Contains(d?.CampaignNumber, query) || d?.ProductionOrderNumbers.Any(x => Contains(x, query)) == true; }
    private IReadOnlyList<DemandSupplyRowView> FilteredDemand() => workbench?.Demand.Rows.Where(x => string.IsNullOrWhiteSpace(state.SearchText) || Contains(x.ProductionOrderNumber, state.SearchText) || Contains(x.GradeCode, state.SearchText)).OrderByDescending(x => x.Priority).ThenBy(x => x.RequiredDate).ToArray() ?? Array.Empty<DemandSupplyRowView>();
    private IReadOnlyList<CampaignView> FilteredCampaigns() => workbench?.Campaigns.Campaigns.Where(x => string.IsNullOrWhiteSpace(state.SearchText) || Contains(x.CampaignNumber, state.SearchText) || Contains(x.GradeSequenceClassCode, state.SearchText) || x.Allocations.Any(a => Contains(a.ProductionOrderNumber, state.SearchText))).OrderBy(x => x.RequiredDate).ToArray() ?? Array.Empty<CampaignView>();
    private IReadOnlyList<PlanningWorkbenchException> FilteredExceptions() => workbench?.Exceptions.Where(x => string.IsNullOrWhiteSpace(state.SearchText) || Contains(x.Title, state.SearchText) || Contains(x.Impact, state.SearchText) || Contains(x.Entity?.DisplayCode, state.SearchText)).OrderByDescending(x => x.Severity).ToArray() ?? Array.Empty<PlanningWorkbenchException>();
    private IReadOnlyCollection<PlanningOperationResourceOptionView> EligibleResources(ScheduledProcessOperationView op, PlanningOperationWorkbenchDetail? d) => d?.ResourceOptions.Count > 0 ? d.ResourceOptions : new[] { new PlanningOperationResourceOptionView(op.ResourceId, op.ResourceCode, op.ResourceName, (int)(op.EndUtc - op.StartUtc).TotalMinutes, 0, true, null) };
    private ScheduledProcessOperationView? FindOperation(string? key) => string.IsNullOrWhiteSpace(key) || workbench is null ? null : workbench.Schedule.ResourceLanes.SelectMany(x => x.Operations).FirstOrDefault(x => x.PlanningKey.Equals(key, StringComparison.OrdinalIgnoreCase));
    private PlanningOperationWorkbenchDetail? FindDetail(string? key) => string.IsNullOrWhiteSpace(key) || workbench is null ? null : workbench.OperationDetails.FirstOrDefault(x => x.PlanningKey.Equals(key, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<BaselineBlock> BaselineBlocks(string resourceCode) => workbench?.Comparison?.Changes.Where(x => x.BaselineResourceCode == resourceCode && x.BaselineStartUtc.HasValue && x.BaselineEndUtc.HasValue).Select(x => new BaselineBlock(x.BaselineStartUtc!.Value, x.BaselineEndUtc!.Value)).ToArray() ?? Array.Empty<BaselineBlock>();
    private IReadOnlyList<DependencyLine> FocusedDependencyLines()
    {
        if (state.SelectedPlanningKey is null) return Array.Empty<DependencyLine>();
        var placements = VisibleLanes.SelectMany((lane, index) => VisibleOperations(lane).Select(operation => new Placement(operation, index))).ToDictionary(x => x.Operation.PlanningKey, StringComparer.OrdinalIgnoreCase);
        if (!placements.ContainsKey(state.SelectedPlanningKey)) return Array.Empty<DependencyLine>();
        var links = placements.Values.SelectMany(item => (FindDetail(item.Operation.PlanningKey)?.PredecessorPlanningKeys ?? Array.Empty<string>()).Where(placements.ContainsKey).Select(predecessor => (From: predecessor, To: item.Operation.PlanningKey))).ToArray();
        var focused = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { state.SelectedPlanningKey };
        var pending = new Queue<string>(); pending.Enqueue(state.SelectedPlanningKey);
        while (pending.TryDequeue(out var key)) foreach (var link in links.Where(x => x.From.Equals(key, StringComparison.OrdinalIgnoreCase) || x.To.Equals(key, StringComparison.OrdinalIgnoreCase))) { var next = link.From.Equals(key, StringComparison.OrdinalIgnoreCase) ? link.To : link.From; if (focused.Add(next)) pending.Enqueue(next); }
        var laneCount = Math.Max(1, VisibleLanes.Count);
        return links.Where(x => focused.Contains(x.From) && focused.Contains(x.To)).Select(link => { var from = placements[link.From]; var to = placements[link.To]; return new DependencyLine((double)Percent(from.Operation.EndUtc), (from.Lane + .5d) / laneCount * 100d, (double)Percent(to.Operation.StartUtc), (to.Lane + .5d) / laneCount * 100d); }).ToArray();
    }
    private bool IsTightChain(ScheduledProcessOperationView op) => FindDetail(op.PlanningKey)?.PredecessorPlanningKeys.Select(FindOperation).Any(x => x is not null && Math.Abs((op.StartUtc - x.EndUtc).TotalMinutes) <= 1d) == true;
    private IReadOnlyList<AxisTick> AxisTicks() { var hours = (state.VisibleEndUtc - state.VisibleStartUtc).TotalHours; var step = hours <= 12 ? TimeSpan.FromHours(1) : hours <= 36 ? TimeSpan.FromHours(4) : hours <= 96 ? TimeSpan.FromHours(12) : TimeSpan.FromDays(1); var result = new List<AxisTick>(); for (var t = state.VisibleStartUtc; t <= state.VisibleEndUtc; t += step) result.Add(new AxisTick(t, hours <= 36 ? "HH:mm" : "dd MMM")); return result; }
    private IReadOnlyList<DueMarker> DueMarkers() => workbench?.Demand.Rows.Where(x => x.RequiredDate >= state.VisibleStartUtc && x.RequiredDate <= state.VisibleEndUtc).GroupBy(x => x.RequiredDate).Select(x => new DueMarker(x.Key, $"{x.Count()} order(s) due")).ToArray() ?? Array.Empty<DueMarker>();
    private decimal Percent(DateTime value) { var total = Math.Max(1d, (state.VisibleEndUtc - state.VisibleStartUtc).TotalMinutes); return (decimal)Math.Clamp((value - state.VisibleStartUtc).TotalMinutes / total * 100d, 0d, 100d); }
    private decimal WidthPercent(DateTime start, DateTime end) { var total = Math.Max(1d, (state.VisibleEndUtc - state.VisibleStartUtc).TotalMinutes); var s = start < state.VisibleStartUtc ? state.VisibleStartUtc : start; var e = end > state.VisibleEndUtc ? state.VisibleEndUtc : end; return (decimal)Math.Clamp((e - s).TotalMinutes / total * 100d, .25d, 100d); }

    private bool HasFocus => !string.IsNullOrWhiteSpace(state.SearchText) || state.SelectedPlanningKey is not null;
    private string QueueTitle => state.Mode switch { PlanningWorkbenchMode.Campaigns => "Campaigns", PlanningWorkbenchMode.Execution => "Execution exceptions", PlanningWorkbenchMode.Recovery => "Recovery queue", _ => "Demand queue" };
    private string QueueDescription => state.Mode switch { PlanningWorkbenchMode.Campaigns => "Compose heats and casts", PlanningWorkbenchMode.Execution => "Released work needing attention", PlanningWorkbenchMode.Recovery => "Disruptions and affected work", _ => "Orders waiting to be scheduled" };
    private void SetMessage(string value, bool error) { message = value; messageIsError = error; }
    private static bool Contains(string? value, string query) => value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
    private static string FriendlyPlanName(string value) => value.StartsWith("PLAN-", StringComparison.OrdinalIgnoreCase) ? value[5..] : value;
    private static string FriendlyOperationName(string? key) { if (string.IsNullOrWhiteSpace(key)) return "Operation"; var p = key.Split(':'); return p.Length >= 4 ? $"{p[1]} · {p[2]} · {p[^1]}" : "Scheduled operation"; }
    private string OperationBlockLabel(ScheduledProcessOperationView op) => state.Mode switch { PlanningWorkbenchMode.Campaigns => $"{FindDetail(op.PlanningKey)?.CampaignNumber ?? "Campaign"} · H{FindDetail(op.PlanningKey)?.HeatSequenceNumber:00}", PlanningWorkbenchMode.Plan => FindDetail(op.PlanningKey)?.ProductionOrderNumbers.FirstOrDefault() ?? $"{op.ProcessOperationType} · {op.GradeCode}", _ => $"{op.ProcessOperationType} · {op.GradeCode}" };
    private static string OperationTitle(ScheduledProcessOperationView op) => $"{op.ProcessOperationType} · {op.ResourceCode} · {op.StartUtc:dd MMM HH:mm} → {op.EndUtc:dd MMM HH:mm} · {op.QuantityMt:0.##} MT · {op.GradeCode}/{op.CrossSectionCode}";
    private static string ProcessClass(ProcessOperationType type) => type switch { ProcessOperationType.Eaf => "bg-process-eaf", ProcessOperationType.Lrf => "bg-process-lrf", ProcessOperationType.Vd => "bg-process-vd", ProcessOperationType.Ccm => "bg-process-casting", ProcessOperationType.Reheat => "bg-process-reheat", ProcessOperationType.HotRoll => "bg-process-hot-roll", ProcessOperationType.ColdRoll => "bg-process-cold-roll", _ => "bg-process-finishing" };

    private static readonly (string Label, string ColorClass)[] ProcessLegend =
    [
        ("EAF", "bg-process-eaf"), ("LRF", "bg-process-lrf"), ("VD", "bg-process-vd"),
        ("Cast", "bg-process-casting"), ("Reheat", "bg-process-reheat"), ("Hot roll", "bg-process-hot-roll"),
        ("Cold roll", "bg-process-cold-roll"), ("Finish", "bg-process-finishing")
    ];
    private static string OperatingStateClass(ResourceOperatingState value) => value == ResourceOperatingState.Available ? "text-success" : "text-danger";
    // The commitment badge previously rendered bg-info-soft/text-info unconditionally, so a Flexible
    // operation and a Running one carried the identical pill - colour said nothing a planner could act
    // on. Escalating tone tracks how costly it is to disturb: flexible is still open, running is not.
    private static string CommitmentStateClass(OperationAssignmentCommitmentState? value) => value switch
    {
        OperationAssignmentCommitmentState.Running => "bg-danger-soft text-danger",
        OperationAssignmentCommitmentState.Committed or OperationAssignmentCommitmentState.Firm => "bg-warning-soft text-warning",
        OperationAssignmentCommitmentState.Completed => "bg-success-soft text-success",
        _ => "bg-info-soft text-info"
    };
    // "Not recorded" is an absence, not a fact - it should read differently from an actual timestamp
    // rather than blending into the same grey figures as everything that already happened.
    private static string ActualValueClass(DateTime? value) => value.HasValue ? "aps-text-body" : "aps-text-caption italic";
    private static string ExecutionClass(OperationExecutionStatus value) => value switch { OperationExecutionStatus.Running => "outline outline-2 outline-warning", OperationExecutionStatus.Held => "outline outline-2 outline-danger", OperationExecutionStatus.Completed => "opacity-65", OperationExecutionStatus.Ready => "outline outline-1 outline-success", _ => "" };
    private static string FindingClass(PlanningConstraintSeverity value) => value switch { PlanningConstraintSeverity.Blocker => "bg-danger-soft text-danger", PlanningConstraintSeverity.Warning => "bg-warning-soft text-warning", _ => "bg-info-soft text-info" };
    private static string FormatMovement(int minutes) => minutes == 0 ? "No time change" : $"{(minutes > 0 ? "+" : "")}{minutes / 60d:0.##} h";
    private static string ModeLabel(PlanningWorkbenchMode value) => value switch { PlanningWorkbenchMode.Campaigns => "Campaigns", PlanningWorkbenchMode.Execution => "Execution", PlanningWorkbenchMode.Recovery => "Recovery", _ => "Plan" };
    private static string ZoomLabel(PlanningWorkbenchZoom value) => value switch { PlanningWorkbenchZoom.Shift => "8 h", PlanningWorkbenchZoom.Day => "1 d", PlanningWorkbenchZoom.ThreeDays => "3 d", PlanningWorkbenchZoom.Week => "7 d", _ => "Fit" };
    private static string CampaignLabel(PlanningOperationWorkbenchDetail? d) => d is null ? "—" : $"{d.CampaignNumber ?? "—"}{(d.HeatSequenceNumber.HasValue ? $" · Heat {d.HeatSequenceNumber}" : "")}";
    private static string OrderLabel(PlanningOperationWorkbenchDetail? d) => d is null || d.ProductionOrderNumbers.Count == 0 ? "—" : string.Join(", ", d.ProductionOrderNumbers);
    private static string FormatActual(DateTime? value) => value?.ToString("dd MMM yyyy HH:mm") ?? "Not recorded";
    // The card's progress fill reads off the plan's reference clock, not wall-clock time, so it stays
    // correct against whatever moment the loaded scenario represents rather than the browser's "now".
    private double RunningProgressPercent(ScheduledProcessOperationView op)
    {
        var total = (op.EndUtc - op.StartUtc).TotalMinutes;
        if (total <= 0d) return 0d;
        var elapsed = (workbench!.Plan.ReferenceTimeUtc - op.StartUtc).TotalMinutes;
        return Math.Clamp(elapsed / total * 100d, 0d, 100d);
    }

    private sealed record AxisTick(DateTime Time, string Format);
    private sealed record DueMarker(DateTime Time, string Label);
    private sealed record BaselineBlock(DateTime Start, DateTime End);
    private sealed record Placement(ScheduledProcessOperationView Operation, int Lane);
    private sealed record DependencyLine(double X1, double Y1, double X2, double Y2);

    public async ValueTask DisposeAsync()
    {
        WorkspaceState.Changed -= OnWorkspaceChanged;
        state.Changed -= OnStateChanged;
        Cockpit.Changed -= OnStateChanged;
        Cockpit.CommandRequested -= OnCockpitCommandRequested;
        try { await JS.InvokeVoidAsync("apsPlanningWorkbench.dispose", workbenchRoot); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        selfReference?.Dispose();
    }
}
