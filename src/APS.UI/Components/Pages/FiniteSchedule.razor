    [JSInvokable]
    public void ApplyGanttPreferences(string? json, double availableWidthPx)
    {
        preferences = GanttPreferencesStore.Parse(json, availableWidthPx);
        state.Viewport.SetGridWidth(preferences.GridWidthPx, availableWidthPx);
        state.Viewport.SetDensity(preferences.Density);
        state.Viewport.SetSnapMode(preferences.SnapMode);
        state.SetLayerVisibility(preferences.ShowBaseline, preferences.ShowDependencies);
        state.SetBaselineMode(preferences.BaselineMode);
        state.SetCapacityPanel(preferences.CapacityPanelOpen, preferences.CapacityPanelHeightPx);
        if (preferences.Zoom != state.Zoom) state.SetZoom(preferences.Zoom);
        StateHasChanged();
    }

    private void SelectOperation(ScheduledProcessOperationView operation) { state.SelectOperation(operation.PlanningKey); Cockpit.OpenInspector(); WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Operation, operation.OperationSnapshotId, FriendlyOperationName(operation.PlanningKey))); targetResourceText = operation.ResourceId.ToString(); targetStartText = operation.StartUtc.ToString("yyyy-MM-ddTHH:mm"); moveComment = null; allowFrozenOverride = false; }
    private void SelectResource(ScheduleResourceLaneView lane) => WorkspaceState.Select(new PlannerEntityRef(PlannerEntityType.Resource, lane.ResourceId, lane.ResourceCode));
    private void FocusCapacitySegment(GanttCapacitySegmentModel segment)
    {
        var lane = workbench?.Schedule.ResourceLanes.FirstOrDefault(x => x.ResourceId == segment.ResourceId);
        if (lane is not null) SelectResource(lane);
        state.FocusCapacity(segment.ResourceId, segment.StartUtc, segment.EndUtc);
    }
    private void FocusDemand(DemandSupplyRowView demand) { state.SetSearch(demand.ProductionOrderNumber); var detail = workbench?.OperationDetails.FirstOrDefault(x => x.ProductionOrderNumbers.Contains(demand.ProductionOrderNumber, StringComparer.OrdinalIgnoreCase)); var operation = FindOperation(detail?.PlanningKey); if (operation is not null) SelectOperation(operation); }
    private void FocusCampaign(CampaignView campaign) { state.SetSearch(campaign.CampaignNumber); var detail = workbench?.OperationDetails.FirstOrDefault(x => x.CampaignNumber == campaign.CampaignNumber); var operation = FindOperation(detail?.PlanningKey); if (operation is not null) SelectOperation(operation); }
    private void FocusException(PlanningWorkbenchException exception) { state.SetSearch(exception.Entity?.DisplayCode ?? exception.Title); }

    [JSInvokable]
    public async Task StageDraggedMove(string planningKey, string resourceId, string targetStartUtc)
    {
        if (!state.CanEditSchedule) return;
        var draggedDetail = FindDetail(planningKey);
        if (draggedDetail?.ExecutionStatus is OperationExecutionStatus.Completed or OperationExecutionStatus.Running) return;
        if (!Guid.TryParse(resourceId, out var targetResourceId) ||
            !DateTimeOffset.TryParse(targetStartUtc, out var parsedStart)) return;
        var operation = FindOperation(planningKey);
        if (operation is null) return;
        var decision = GanttDragGeometry.EvaluateDrop(
            operation,
            draggedDetail,
            targetResourceId,
            state.CanEditSchedule,
            FrozenFenceEndUtc);
        if (!decision.IsEligible) { SetMessage(decision.Message, true); return; }

        SelectOperation(operation);
        var targetStart = GanttDragGeometry.CandidateStart(
            parsedStart.UtcDateTime,
            operation.EndUtc - operation.StartUtc,
            0d,
            state.Viewport.SnapMode,
            TargetShiftBoundaries(targetResourceId));
        targetResourceText = targetResourceId.ToString();
        targetStartText = targetStart.ToString("yyyy-MM-ddTHH:mm");
        if (decision.RequiresFrozenOverride && !allowFrozenOverride)
            SetMessage(decision.Message, true);
        await PreviewMoveAsync();
    }

    private async Task PreviewMoveAsync() { var proposal = BuildProposal(); if (proposal is null) return; acting = true; message = null; try { state.StageMove(proposal); state.SetImpact(await Commands.ValidateMoveAsync(proposal)); } catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; } }
    private async Task ApplyMoveAsync()
    {
        if (workbench is null) return; var proposal = state.StagedMove ?? BuildProposal(); if (proposal is null) return; acting = true; message = null;
        try { var result = await Commands.ApplyMoveAsync(new PlanningMoveApplyRequest(proposal, BuildPlanningRequest(), new PlanningTimeFencePolicy(frozenMinutes))); if (!result.Replan.Plan.IsFeasible) throw new InvalidOperationException("The move could not produce a feasible repaired plan. The current plan remains unchanged."); var previous = workbench.Plan.PlanVersionId; var current = result.Replan.Version.PlanVersionId; state.RecordAppliedPlan(previous, current, $"Move {FriendlyOperationName(proposal.PlanningKey)} · {FormatMovement(result.Impact.MovementMinutes)}"); SetMessage("Move applied. A repaired child Plan Version is now active.", false); await LoadAsync(current, previous); }
        catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; }
    }

    private async Task ReplanAsync()
    {
        if (workbench is null) return; acting = true; message = null;
        try { var previous = workbench.Plan.PlanVersionId; var result = await Lifecycle.ReplanAsync(previous, new PlanningRecalculationRequest(BuildPlanningRequest(), new PlanningTimeFencePolicy(frozenMinutes), workbench.Plan.ReferenceTimeUtc, PlanTriggerType.Manual, "Planner workbench recalculation")); if (!result.Plan.IsFeasible) throw new InvalidOperationException("Recalculation produced an infeasible candidate. The current plan remains active."); state.RecordAppliedPlan(previous, result.Version.PlanVersionId, "Optimize flexible horizon"); SetMessage("Plan recalculated. Review changes against the baseline before release.", false); await LoadAsync(result.Version.PlanVersionId, previous); }
        catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; }
    }

    private async Task ReleaseAsync() { if (workbench is null) return; acting = true; try { var release = await ReleaseService.ReleaseAsync(workbench.Plan.PlanVersionId); SetMessage($"Plan released as {release.WorkOrders.Count} work orders.", false); await LoadAsync(workbench.Plan.PlanVersionId, workbench.Baseline?.PlanVersionId); } catch (Exception ex) { SetMessage(ex.Message, true); } finally { acting = false; } }
    private async Task UndoAsync() { var planId = state.UndoPlan(); if (!planId.HasValue) return; await LoadAsync(planId.Value, null); SetMessage("Showing the previous Plan Version. No planning data was deleted.", false); }
    private async Task RedoAsync() { var planId = state.RedoPlan(); if (!planId.HasValue) return; await LoadAsync(planId.Value, WorkspaceState.CurrentPlanVersionId); SetMessage("Showing the reapplied child Plan Version.", false); }

    private PlanningMoveProposal? BuildProposal()
    {
        if (workbench is null || SelectedOperation is null) return null;
        if (!Guid.TryParse(targetResourceText, out var resourceId)) { SetMessage("Select an eligible target resource.", true); return null; }
        if (!DateTime.TryParse(targetStartText, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, out var start)) { SetMessage("Enter a valid target start.", true); return null; }
        return new PlanningMoveProposal(workbench.Plan.PlanVersionId, SelectedOperation.PlanningKey, resourceId, DateTime.SpecifyKind(start, DateTimeKind.Utc), moveReason, moveComment, allowFrozenOverride);
    }

    private PlanningCalculationRequest BuildPlanningRequest() => new(new PlanningDemandSelection(), new CampaignPlanningPolicy(nominalHeatMt, nominalHeatMt * .7m, nominalHeatMt * 1.15m, maximumCampaignMt, maximumCampaignMt), new ProductionStructurePlanningPolicy(), workbench?.Plan.HorizonStartUtc ?? DateTime.UtcNow, workbench?.Plan.HorizonEndUtc ?? DateTime.UtcNow.AddDays(7), solverSeconds);
    private IReadOnlyList<DemandSupplyRowView> FilteredDemand() => workbench?.Demand.Rows.Where(x => string.IsNullOrWhiteSpace(state.SearchText) || Contains(x.ProductionOrderNumber, state.SearchText) || Contains(x.GradeCode, state.SearchText)).OrderByDescending(x => x.Priority).ThenBy(x => x.RequiredDate).ToArray() ?? Array.Empty<DemandSupplyRowView>();
    private IReadOnlyList<CampaignView> FilteredCampaigns() => workbench?.Campaigns.Campaigns.Where(x => string.IsNullOrWhiteSpace(state.SearchText) || Contains(x.CampaignNumber, state.SearchText) || Contains(x.GradeSequenceClassCode, state.SearchText) || x.Allocations.Any(a => Contains(a.ProductionOrderNumber, state.SearchText))).OrderBy(x => x.RequiredDate).ToArray() ?? Array.Empty<CampaignView>();
    private IReadOnlyList<PlanningWorkbenchException> FilteredExceptions() => workbench?.Exceptions.Where(x => string.IsNullOrWhiteSpace(state.SearchText) || Contains(x.Title, state.SearchText) || Contains(x.Impact, state.SearchText) || Contains(x.Entity?.DisplayCode, state.SearchText)).OrderByDescending(x => x.Severity).ToArray() ?? Array.Empty<PlanningWorkbenchException>();
    private IReadOnlyCollection<PlanningOperationResourceOptionView> EligibleResources(ScheduledProcessOperationView op, PlanningOperationWorkbenchDetail? d) => d?.ResourceOptions.Count > 0 ? d.ResourceOptions : new[] { new PlanningOperationResourceOptionView(op.ResourceId, op.ResourceCode, op.ResourceName, (int)(op.EndUtc - op.StartUtc).TotalMinutes, 0, true, null) };
    private ScheduledProcessOperationView? FindOperation(string? key) => string.IsNullOrWhiteSpace(key) || workbench is null ? null : workbench.Schedule.ResourceLanes.SelectMany(x => x.Operations).FirstOrDefault(x => x.PlanningKey.Equals(key, StringComparison.OrdinalIgnoreCase));
    private PlanningOperationWorkbenchDetail? FindDetail(string? key) => string.IsNullOrWhiteSpace(key) || workbench is null ? null : workbench.OperationDetails.FirstOrDefault(x => x.PlanningKey.Equals(key, StringComparison.OrdinalIgnoreCase));
    private IReadOnlyList<DateTime> TargetShiftBoundaries(Guid resourceId) => workbench?.ResourceCalendarIntervals
        .Where(x => x.ResourceId == resourceId)
        .SelectMany(x => new[] { x.StartUtc, x.EndUtc })
        .Where(x => x >= state.PlanStartUtc && x <= state.PlanEndUtc)
        .Distinct()
        .OrderBy(x => x)
        .ToArray() ?? Array.Empty<DateTime>();

    private bool HasFocus => !string.IsNullOrWhiteSpace(state.SearchText) || state.SelectedPlanningKey is not null;
    private string QueueTitle => state.Mode switch { PlanningWorkbenchMode.Campaigns => "Campaigns", PlanningWorkbenchMode.Execution => "Execution exceptions", PlanningWorkbenchMode.Recovery => "Recovery queue", _ => "Demand queue" };
    private string QueueDescription => state.Mode switch { PlanningWorkbenchMode.Campaigns => "Compose heats and casts", PlanningWorkbenchMode.Execution => "Released work needing attention", PlanningWorkbenchMode.Recovery => "Disruptions and affected work", _ => "Orders waiting to be scheduled" };
    private void SetMessage(string value, bool error) { message = value; messageIsError = error; }
    private static bool Contains(string? value, string query) => value?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
    private static string FriendlyPlanName(string value) => value.StartsWith("PLAN-", StringComparison.OrdinalIgnoreCase) ? value[5..] : value;
    private static string FriendlyOperationName(string? key) { if (string.IsNullOrWhiteSpace(key)) return "Operation"; var p = key.Split(':'); return p.Length >= 4 ? $"{p[1]} · {p[2]} · {p[^1]}" : "Scheduled operation"; }
    // The commitment badge previously rendered bg-info-soft/text-info unconditionally, so a Flexible
    // operation and a Running one carried the identical pill - colour said nothing a planner could act
    // on. Escalating tone tracks how costly it is to disturb: flexible is still open, running is not.
    private static string CommitmentStateClass(OperationAssignmentCommitmentState? value) => value switch
    {
        OperationAssignmentCommitmentState.Running => "bg-danger-soft text-danger",
        OperationAssignmentCommitmentState.Committed or OperationAssignmentCommitmentState.Firm => "bg-warning-soft text-warning",
        OperationAssignmentCommitmentState.Completed => "bg-success-soft text-success",
        _ => "bg-info-soft text-info"
    };
    // "Not recorded" is an absence, not a fact - it should read differently from an actual timestamp
    // rather than blending into the same grey figures as everything that already happened.
    private static string ActualValueClass(DateTime? value) => value.HasValue ? "aps-text-body" : "aps-text-caption italic";
    private static string FindingClass(PlanningConstraintSeverity value) => value switch { PlanningConstraintSeverity.Blocker => "bg-danger-soft text-danger", PlanningConstraintSeverity.Warning => "bg-warning-soft text-warning", _ => "bg-info-soft text-info" };
    private static string FormatMovement(int minutes) => minutes == 0 ? "No time change" : $"{(minutes > 0 ? "+" : "")}{minutes / 60d:0.##} h";
    private static string ModeLabel(PlanningWorkbenchMode value) => value switch { PlanningWorkbenchMode.Campaigns => "Campaigns", PlanningWorkbenchMode.Execution => "Execution", PlanningWorkbenchMode.Recovery => "Recovery", _ => "Plan" };
    private static string ZoomLabel(PlanningWorkbenchZoom value) => value switch { PlanningWorkbenchZoom.Detail => "30 m", PlanningWorkbenchZoom.Shift => "8 h", PlanningWorkbenchZoom.Day => "1 d", PlanningWorkbenchZoom.ThreeDays => "3 d", PlanningWorkbenchZoom.Week => "7 d", PlanningWorkbenchZoom.TwoWeeks => "2 w", PlanningWorkbenchZoom.Month => "1 mo", _ => "Fit" };
    private static string SnapLabel(GanttSnapMode value) => value switch { GanttSnapMode.ShiftBoundary => "Shift", GanttSnapMode.Hour => "1 h", GanttSnapMode.ThirtyMinutes => "30 m", GanttSnapMode.FifteenMinutes => "15 m", GanttSnapMode.FiveMinutes => "5 m", _ => "Free" };
    private static string CampaignLabel(PlanningOperationWorkbenchDetail? d) => d is null ? "—" : $"{d.CampaignNumber ?? "—"}{(d.HeatSequenceNumber.HasValue ? $" · Heat {d.HeatSequenceNumber}" : "")}";
    private static string OrderLabel(PlanningOperationWorkbenchDetail? d) => d is null || d.ProductionOrderNumbers.Count == 0 ? "—" : string.Join(", ", d.ProductionOrderNumbers);
    private static string FormatActual(DateTime? value) => value?.ToString("dd MMM yyyy HH:mm") ?? "Not recorded";
    public async ValueTask DisposeAsync()
    {
        WorkspaceState.Changed -= OnWorkspaceChanged;
        state.Changed -= OnStateChanged;
        Cockpit.Changed -= OnStateChanged;
        Cockpit.CommandRequested -= OnCockpitCommandRequested;
        try { await JS.InvokeVoidAsync("apsPlanningWorkbench.dispose", workbenchRoot); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        selfReference?.Dispose();
    }
}
